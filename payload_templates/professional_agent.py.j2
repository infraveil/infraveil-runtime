def _start_service_process(name, runtime, start, cwd, env):
    start = _normalize_service_command(runtime, start)
    report_log(f"[INFO] Starting process service [{name}] runtime={runtime} command={start}")
    generation = _service_generation
    if name in _service_health_specs:
        _service_health_specs[name]["started_at"] = time.time()
    if name in _service_specs:
        _service_specs[name]["started_at"] = time.time()

    try:
        start_parts = shlex.split(start, posix=(os.name != "nt"))
    except Exception as ex:
        report_log(f"[WARN] shlex.split failed: {ex}, using fallback")
        start_parts = [start]

    start_parts = [
        (p[1:-1] if len(p) >= 2 and p[0] == p[-1] and p[0] in ('"', "'") else p)
        for p in start_parts
    ]

    if not start_parts:
        report_log(f"[ERROR] Empty command after parsing")
        return None
    exe = start_parts[0]
    exe_available = bool(shutil.which(exe)) or (os.path.isabs(exe) and os.path.exists(exe))
    if not exe_available:
        rt = str(runtime or "").lower()
        base = os.path.basename(exe).lower()
        if rt == "node" or "node" in base:
            detail = "Node.js is not installed on this machine, so Node services are skipped here. Install the LTS build from https://nodejs.org/en/download to run them. This is a host requirement, not an Infraveil issue."
        elif rt == "python" or "python" in base:
            detail = "Python was not found on PATH for this service, so it is skipped here. Install it from https://www.python.org/downloads/ to run it. This is a host requirement, not an Infraveil issue."
        else:
            detail = f"Required program '{exe}' is not installed on this machine, so the service is skipped here. This is a host requirement, not an Infraveil issue."
        if name not in _runtime_unavailable_notified:
            _runtime_unavailable_notified.add(name)
            report_log(f"[INFO] Skipping service [{name}]: {detail}")
        return None
    _runtime_unavailable_notified.discard(name)
    port = None
    try:
        port = int((_service_health_specs.get(name) or {}).get("port") or 0)
    except Exception:
        port = None
    listener = _agent_runtime_ports.listener("service:" + name)
    if port and listener is None:
        # A process table is not a port authority: other users' listeners may
        # have no visible PID. Never kill by a path substring to reclaim a port.
        probe = _reserve_runtime_port("127.0.0.1", port)
        probe.close()
    env = dict(env)
    env.pop("INFRAVEIL_LISTEN_FD", None)
    if listener is not None:
        env["INFRAVEIL_LISTEN_FD"] = str(listener.fileno())

    popen_kwargs = {
        "args": start_parts,
        "cwd": cwd,
        "env": env,
        "stdout": subprocess.PIPE,
        "stderr": subprocess.PIPE,
    }
    if os.name == "nt":
        popen_kwargs["creationflags"] = (
            getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
            | getattr(subprocess, "CREATE_NO_WINDOW", 0)
        )
    else:
        popen_kwargs["start_new_session"] = True
        if listener is not None:
            popen_kwargs["pass_fds"] = (listener.fileno(),)

    try:
        proc = subprocess.Popen(**popen_kwargs)
        _service_processes[name] = proc
        _service_health_failures[name] = 0
        _service_health_observed_at[name] = 0.0
        _append_local_audit("service_started", service=name, runtime=runtime, pid=proc.pid, cwd=cwd)
        threading.Thread(target=_stream_process_output, args=(name, proc.stdout, "[INFO]"), daemon=True).start()
        threading.Thread(target=_stream_process_output, args=(name, proc.stderr, "[ERROR]"), daemon=True).start()
        threading.Thread(target=_watch_service_process, args=(name, runtime, proc, generation), daemon=True).start()
        return proc
    except FileNotFoundError:
        exe = os.path.basename(str(start_parts[0])).lower() if start_parts else ""
        rt = str(runtime or "").lower()
        if rt == "node" or "node" in exe:
            report_log(f"[ERROR] Service [{name}] needs Node.js, which is not installed or not on PATH. Install the LTS build from https://nodejs.org/en/download, then restart the launcher.")
        elif rt == "python" or "python" in exe:
            report_log(f"[ERROR] Service [{name}] needs Python, which is not installed or not on PATH. Install it from https://www.python.org/downloads/, then restart the launcher.")
        else:
            report_log(f"[ERROR] Service [{name}] could not start: '{start_parts[0] if start_parts else runtime}' was not found on PATH. Install it or correct the command, then restart the launcher.")
        return None
    except Exception as e:
        report_log(f"[ERROR] Failed to start service [{name}]: {e}")
        return None

def _route_matches(pattern, path):
    pattern = str(pattern or "/*")
    if pattern in ("/*", "*", path):
        return True
    if pattern.endswith("/*"):
        return path.startswith(pattern[:-1])
    return path == pattern

def _proxy_status_line(code):
    reasons = {200: "OK", 201: "Created", 202: "Accepted", 204: "No Content", 400: "Bad Request", 403: "Forbidden", 404: "Not Found", 405: "Method Not Allowed", 413: "Payload Too Large", 429: "Too Many Requests", 500: "Internal Server Error", 502: "Bad Gateway"}
    return f"{code} {reasons.get(code, 'OK')}"

HOP_BY_HOP_HEADERS = {
    "connection", "keep-alive", "proxy-authenticate", "proxy-authorization",
    "te", "trailer", "transfer-encoding", "upgrade",
}

def _redact_sensitive_headers(headers):
    if not isinstance(headers, dict):
        return headers
    clean = {}
    for key, value in headers.items():
        normalized = re.sub(r"[^a-z0-9]+", "-", str(key).strip().lower()).strip("-")
        if (
            normalized in _SENSITIVE_HEADER_KEYS or normalized == "x-infraveil-edge"
            or normalized.endswith(("-api-key", "-auth-token", "-session-token", "-authorization"))
        ):
            clean[key] = "[REDACTED]"
        else:
            clean[key] = _redact_sensitive_text(value)
    return clean

def _gateway_routes_and_services(manifest):
    services = {str(s.get("name")): s for s in manifest.get("services", []) if isinstance(s, dict) and s.get("name")}
    routes = manifest.get("routes") if isinstance(manifest.get("routes"), list) else []
    if not routes and services:
        routes = [{"path": "/*", "service": next(iter(services.keys()))}]
    return routes, services

def _gateway_route_target(manifest, path):
    routes, services = _gateway_routes_and_services(manifest)
    route = next((r for r in routes if isinstance(r, dict) and _route_matches(r.get("path"), path)), None)
    svc = services.get(str(route.get("service"))) if route else None
    port = _safe_int(svc.get("port") if svc else None, 0, 1, 65535)
    return route, svc, port

def _header_items_without_hop_by_hop(headers):
    connection_tokens = set()
    try:
        connection_values = headers.getall("Connection", [])
    except Exception:
        connection_values = [headers.get("Connection", "")] if headers else []
    for raw_value in connection_values:
        connection_tokens.update(token.strip().lower() for token in str(raw_value).split(",") if token.strip())
    clean = {}
    for key, value in (headers or {}).items():
        lk = str(key).lower()
        if lk in HOP_BY_HOP_HEADERS or lk in connection_tokens or lk in ("host", "content-length", "x-infraveil-edge"):
            continue
        clean[str(key)] = str(value)
    return clean


def _canonical_gateway_request_path(raw_path):
    raw_path = str(raw_path or "/").split("?", 1)[0] or "/"
    if re.search(r"%(?:2f|5c)", raw_path, re.IGNORECASE):
        raise ValueError("encoded path separator")
    try:
        decoded = urllib.parse.unquote(raw_path, errors="strict")
    except Exception as exc:
        raise ValueError("invalid path encoding") from exc
    if "\x00" in decoded or "\\" in decoded:
        raise ValueError("unsafe path character")
    if any(segment in {".", ".."} for segment in decoded.split("/")):
        raise ValueError("ambiguous dot segment")
    if not decoded.startswith("/"):
        raise ValueError("path must be absolute")
    if decoded.startswith("//"):
        raise ValueError("network-relative path")
    return decoded

_GATEWAY_EDGE_SECRET = None

def _request_from_trusted_edge(request):
    try:
        peer = request.remote or ""
        if peer not in ("127.0.0.1", "::1", "localhost"):
            return False
        edge = _GATEWAY_EDGE_SECRET
        if not edge:
            return False
        return hmac.compare_digest(request.headers.get("X-Infraveil-Edge", "") or "", edge)
    except Exception:
        return False

def _aiohttp_request_ip(request):
    remote = request.remote or ""
    if _request_from_trusted_edge(request):
        fwd = [c.strip() for c in (request.headers.get("X-Forwarded-For") or "").split(",") if c.strip()]
        for cand in reversed(fwd):
            if cand and cand not in ("127.0.0.1", "::1"):
                remote = cand
                break
    try:
        if _is_cloudflare_ip(remote):
            cf_ip = (request.headers.get("CF-Connecting-IP") or "").strip()
            if cf_ip and _is_valid_public_ip(cf_ip):
                return cf_ip
    except Exception:
        pass
    return remote

def _aiohttp_request_country(request):
    remote = request.remote or ""
    if _request_from_trusted_edge(request):
        # Managed Caddy overwrites this with its socket peer. The edge secret
        # authenticates that hop, not client-supplied geolocation headers.
        remote = (request.headers.get("X-Forwarded-For") or "").strip()
    if not _is_cloudflare_ip(remote):
        return ""
    country = request.headers.get("CF-IPCountry")
    country = str(country or "").strip().upper()
    if len(country) == 2 and country.isalpha() and country not in ("XX", "T1"):
        return country
    return ""

def _gateway_security_snapshot():
    _sync_security_policy()
    with _sec_lock:
