def _enable_linux_child_subreaper():
    """Keep daemonized workload descendants parented to this agent on Linux."""
    global _linux_child_subreaper_enabled
    if not sys.platform.startswith("linux"):
        return False
    if _linux_child_subreaper_enabled:
        return True
    import ctypes
    libc = ctypes.CDLL(None, use_errno=True)
    prctl = libc.prctl
    prctl.argtypes = [ctypes.c_int, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong]
    prctl.restype = ctypes.c_int
    if prctl(36, 1, 0, 0, 0) != 0:  # PR_SET_CHILD_SUBREAPER
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))
    _linux_child_subreaper_enabled = True
    return True

def _stop_service_processes():
    """Stop every process carrying this agent's exact runtime ownership markers."""
    global _service_processes

    _stop_external_log_processes()
    _stop_gateway_process()

    try:
        import psutil
    except Exception as exc:
        raise RuntimeError("psutil is required to verify runtime process containment") from exc

    expected_identity = {
        "INFRAVEIL_CLIENT_ID": CLIENT_ID,
        "INFRAVEIL_AGENT_ID": AGENT_ID,
    }
    allowed_owners = {"agent", "agent-gateway"}
    try:
        current_username = psutil.Process(os.getpid()).username()
    except Exception:
        current_username = ""
    if sys.platform.startswith("linux"):
        if not _linux_child_subreaper_enabled:
            raise RuntimeError("Linux runtime containment was not initialized before workload startup")

    def owned_processes():
        if sys.platform.startswith("linux"):
            try:
                return psutil.Process(os.getpid()).children(recursive=True), True
            except Exception:
                return [], False
        owned = []
        scan_complete = True
        for candidate in psutil.process_iter(["pid", "username"]):
            try:
                if candidate.pid == os.getpid():
                    continue
                username = str(candidate.info.get("username") or "")
                if current_username and username and username != current_username:
                    continue
                env = candidate.environ()
                if (
                    all(env.get(key) == value for key, value in expected_identity.items())
                    and env.get("INFRAVEIL_RUNTIME_OWNER") in allowed_owners
                ):
                    owned.append(candidate)
            except (psutil.NoSuchProcess, psutil.ZombieProcess):
                continue
            except psutil.AccessDenied:
                if not current_username or str(candidate.info.get("username") or "") == current_username:
                    scan_complete = False
            except Exception:
                scan_complete = False
        return owned, scan_complete

    def stop_tree(proc):
        if not proc:
            return
        try:
            parent = psutil.Process(proc.pid)
            processes = parent.children(recursive=True) + [parent]
        except Exception:
            processes = []

        if os.name != "nt":
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            except Exception as exc:
                _write_boot_log(f"[RUNTIME_STOP] process-group kill failed for pid {proc.pid}: {exc}")

        for child in processes:
            try:
                child.kill()
            except Exception:
                pass

    for name, proc in list(_service_processes.items()):
        stop_tree(proc)

    owned, scan_complete = owned_processes()
    for proc in owned:
        try:
            proc.terminate()
        except (psutil.NoSuchProcess, psutil.ZombieProcess):
            pass
        except Exception:
            scan_complete = False
    _, alive = psutil.wait_procs(owned, timeout=2)
    for proc in alive:
        try:
            proc.kill()
        except (psutil.NoSuchProcess, psutil.ZombieProcess):
            pass
        except Exception:
            scan_complete = False
    if alive:
        psutil.wait_procs(alive, timeout=2)
    survivors, final_scan_complete = owned_processes()
    scan_complete = scan_complete and final_scan_complete
    if survivors or not scan_complete:
        _append_local_audit(
            "runtime_stop_failed",
            surviving_pids=[proc.pid for proc in survivors],
            scan_complete=scan_complete,
        )
        raise RuntimeError("Could not verify that every owned runtime process stopped")

    _sync_persistent_mounts()
    _service_processes = {}
    _release_runtime_ports()
    return True

