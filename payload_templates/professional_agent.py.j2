        command = str(command or '').strip()

        def quote_executable(path):
            if self.os.name == 'nt':
                return self.windows_command_line([path])
            return self.arguments.quote(path)

        def resolve_windows_executable(executable, extra_candidates=()):
            if self.os.name != 'nt':
                return executable
            candidates = []
            found = self.which(executable)
            if found:
                candidates.append(found)
            candidates.extend(extra_candidates)
            for candidate in candidates:
                expanded = self.os.path.expandvars(self.os.path.expanduser(str(candidate or '')))
                if expanded and self.os.path.isfile(expanded):
                    return expanded
