def _waf_transform(value, transformations, decode_rounds=2):
    value = str(value or "")
    transforms = list(transformations or [])
    rounds = max(1, min(5, int(decode_rounds if decode_rounds is not None else 1)))

    def normalize_sql_comments(text):
        result = []
        index = 0
        length = len(text)
        while index < length:
            if text.startswith("/*", index):
                end = text.find("*/", index + 2)
                if end < 0:
                    result.append(" ")
                    break
                content = text[index + 2:end]
                executable = ""
                if content.startswith("!"):
                    executable = content[1:]
                elif content.startswith("M!") or content.startswith("m!"):
                    executable = content[2:]
                if executable:
                    executable = executable.lstrip()
                    version_length = 0
                    while version_length < min(6, len(executable)) and executable[version_length].isdigit():
                        version_length += 1
                    result.extend((" ", executable[version_length:], " "))
                else:
                    result.append(" ")
                index = end + 2
                continue
            if text.startswith("--", index):
                cr = text.find("\r", index + 2)
                lf = text.find("\n", index + 2)
                endings = [position for position in (cr, lf) if position >= 0]
                result.append(" ")
                if not endings:
                    break
                index = min(endings)
                continue
            result.append(text[index])
            index += 1
        return "".join(result)

    def decode_json_escapes(text):
        pattern = re.compile(r"\\(?:u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|[\"\\/bfnrt])")
        def replace(match):
            token = match.group(0)
            if token.startswith("\\x"):
                try:
                    return chr(int(token[2:], 16))
                except ValueError:
                    return token
            try:
                return json.loads('"' + token.replace('"', '\\"') + '"')
            except Exception:
                if token == '\\"':
                    return '"'
                return token
        return pattern.sub(replace, text)

    for _ in range(rounds):
        before = value
        for transform in transforms:
            if transform == "url_decode":
                value = urllib.parse.unquote_plus(value)
            elif transform == "html_entity_decode":
                value = html.unescape(value)
            elif transform == "json_escape_decode":
                value = decode_json_escapes(value)
            elif transform == "normalize_unicode":
                value = unicodedata.normalize("NFKC", value)
            elif transform == "remove_invisible":
                value = "".join(char for char in value if unicodedata.category(char) != "Cf")
            elif transform == "remove_nulls":
                value = value.replace("\x00", "")
            elif transform == "sql_comment_to_space":
                value = normalize_sql_comments(value)
            elif transform == "compress_whitespace":
                value = re.sub(r"\s+", " ", value).strip()
            elif transform == "lowercase":
                value = value.lower()
        if value == before:
            break
    return value


def _waf_target_value(rule, ctx):
    target = str(rule.get("target") or "")
    if target == "path":
        return ctx.get("path", "")
    if target == "path_query":
        return ctx.get("path_query", ctx.get("path", ""))
    if target == "query":
        return ctx.get("query", "")
    if target == "method":
        return ctx.get("method", "")
    if target == "user_agent":
        return ctx.get("ua", "")
    if target == "headers":
        return "\n".join(f"{key}: {value}" for key, value in sorted((ctx.get("headers") or {}).items()))
    if target == "body":
        return ctx.get("body_text", "")
    if target == "content_type":
        return ctx.get("content_type", "")
    if target == "country":
        return ctx.get("country", "")
    if target == "ip":
        return ctx.get("ip", "")
    return ""


def _waf_rule_match(rule, ctx, decode_rounds, transform_cache=None):
    methods = {str(item).upper() for item in (rule.get("methods") or [])}
    if methods and ctx.get("method") not in methods:
        return False
    target = str(rule.get("target") or "")
    transformations = tuple(str(item) for item in (rule.get("transformations") or []))
    cache = transform_cache if isinstance(transform_cache, dict) else {}
    raw_value = _waf_target_value(rule, ctx)
    input_cache_key = ("input", target, transformations, decode_rounds)
    if input_cache_key not in cache:
        cache[input_cache_key] = _waf_transform(raw_value, transformations, decode_rounds)
    value = cache[input_cache_key]
    expected_raw = str(rule.get("value", "") or "")
    expected_cache_key = ("expected", expected_raw, transformations, decode_rounds)
    if expected_cache_key not in cache:
        cache[expected_cache_key] = _waf_transform(expected_raw, transformations, decode_rounds)
    expected = cache[expected_cache_key]
    operator = str(rule.get("operator") or "")
    try:
        if operator == "exists":
            return bool(value)
        if operator == "contains":
            return expected in value
        if operator == "equals":
            return value == expected
        if operator == "prefix":
            return value.startswith(expected)
        if operator == "suffix":
            return value.endswith(expected)
        if operator == "glob":
            return fnmatch.fnmatchcase(value, expected)
        if operator == "regex":
            # Transformations canonicalize untrusted input, never regex source.
            # URL decoding the pattern itself turns '+' quantifiers into spaces.
            return re.search(expected_raw, value, re.IGNORECASE) is not None
        if operator == "cidr":
            return ipaddress.ip_address(str(value).split("%", 1)[0]) in ipaddress.ip_network(expected_raw, strict=False)
    except Exception:
        return False
    return False


def _waf_exclusion_applies(exclusion, rule_id, path, method):
    rule_ids = set(exclusion.get("rule_ids") or [])
    if not rule_ids or ("*" not in rule_ids and rule_id not in rule_ids):
        return False
    methods = {str(item).upper() for item in (exclusion.get("methods") or [])}
    if methods and method not in methods:
        return False
    prefix = str(exclusion.get("path_prefix") or "")
    if prefix and not (path == prefix or path.startswith(prefix.rstrip("/") + "/")):
        return False
    expires_at = str(exclusion.get("expires_at") or "").strip()
    if expires_at:
        try:
            parsed = datetime.fromisoformat(expires_at.replace("Z", "+00:00"))
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=timezone.utc)
            if parsed <= datetime.now(timezone.utc):
                return False
        except Exception:
            return False
    return True


def _waf_rate_rule_decision(rule, ctx, compiled, policy):
    enforcement = str(policy.get("rate_limit_enforcement_mode") or "enforce").strip().lower()
    if not policy.get("rate_limit_enabled") or enforcement == "disabled":
        return {"allowed": True, "enforced": False, "retry_after": 0, "reason": "disabled"}
    ip = str(ctx.get("ip") or "unknown")
    path = str(ctx.get("path") or "/")
    exempt_paths = list(policy.get("rate_limit_exempt_paths") or []) + list(policy.get("rate_limit_whitelisted_paths") or [])
    if _ip_matches_policy(ip, policy.get("rate_limit_bypass_ips") or []) or _path_matches_policy(path, exempt_paths):
        return {"allowed": True, "enforced": False, "retry_after": 0, "reason": "exempt"}
    config = rule.get("rate_limit") if isinstance(rule.get("rate_limit"), dict) else {}
    limit = max(1, min(100000, int(config.get("requests", 60) or 60)))
    window = max(1, min(3600, int(config.get("window_seconds", 60) or 60)))
    scope = str(config.get("scope") or "ip_path").lower()
    identity = "global" if scope == "global" else ip
    if scope == "ip_path":
        identity += ":" + path
    key = ("waf", str(compiled.get("revision") or ""), str(rule.get("id") or ""), identity)
    now = time.time()
    with _sec_lock:
        started, count, _last_seen = _sec_rate_windows.get(key, (now, 0, now))
        if now - started >= window:
            started, count = now, 0
        count += 1
        _bounded_security_state_put(_sec_rate_windows, key, (started, count, now), SECURITY_STATE_MAX_PIPELINE_KEYS)
    allowed = count <= limit
    retry_after = max(1, int(math.ceil(window - max(0.0, now - started)))) if not allowed else 0
    return {
        "allowed": allowed or enforcement != "enforce",
        "enforced": not allowed and enforcement == "enforce",
        "retry_after": retry_after,
        "reason": "waf_rule_rate_limit" if not allowed else "allow",
    }


def _evaluate_compiled_waf(ctx, compiled, policy=None):
    policy = policy if isinstance(policy, dict) else {}
    result = {"score": 0, "matched_rule_ids": [], "matched_rules": [], "action": "allow", "status": 200}
    if not isinstance(compiled, dict) or not compiled.get("enabled") or compiled.get("mode") == "off":
        return result
    path = ctx.get("path") or "/"
    method = ctx.get("method") or "GET"
    control_paths = compiled.get("control_plane_exempt_paths") or []
    if _path_matches_policy(path, control_paths):
        result["bypassed"] = "control_plane"
        return result
    inspection = compiled.get("inspection") if isinstance(compiled.get("inspection"), dict) else {}
    decode_rounds = int(inspection.get("decode_rounds", 2) or 2)
    exclusions = compiled.get("exclusions") or []
    transform_cache = {}
    for rule in compiled.get("rules") or []:
        if not isinstance(rule, dict) or rule.get("enabled", True) is False:
            continue
        # Source-management tool arguments contain legitimate SQL/JavaScript.
        # Only the async gateway's successful, current API authentication may
        # suppress body signatures; this is never inferred from request headers.
        if rule.get("target") == "body" and path == "/mcp" and ctx.get("_mcp_authenticated_body") is True:
            continue
        rule_id = str(rule.get("id") or "")
        if any(_waf_exclusion_applies(exclusion, rule_id, path, method) for exclusion in exclusions if isinstance(exclusion, dict)):
            continue
        if not _waf_rule_match(rule, ctx, decode_rounds, transform_cache):
            continue
        result["matched_rule_ids"].append(rule_id)
        result["matched_rules"].append({
            "id": rule_id,
            "category": str(rule.get("category") or "custom"),
            "severity": str(rule.get("severity") or "medium"),
            "action": str(rule.get("action") or "score"),
            "score": int(rule.get("score", 0) or 0),
        })
        action = str(rule.get("action") or "score")
        score = max(0, int(rule.get("score", 0) or 0))
        if action in {"score", "block"}:
            result["score"] = min(1000, result["score"] + score)
        if action == "allow":
            result["action"] = "allow"
            result["explicit_allow"] = True
            break
        if action == "block":
            result["action"] = "block"
            result["status"] = 403
        elif action == "rate_limit" and result["action"] == "allow":
            rate_result = _waf_rate_rule_decision(rule, ctx, compiled, policy)
            result["rate_limit"] = rate_result
            if rate_result.get("enforced"):
                result["action"] = "rate_limit"
                result["status"] = 429
                result["retry_after"] = int(rate_result.get("retry_after", 1) or 1)
            elif rate_result.get("reason") == "waf_rule_rate_limit":
                result["simulated_action"] = "rate_limit"
    if result["action"] == "allow" and result["score"] >= int(compiled.get("block_threshold", 60) or 60):
        result["action"] = "block"
        result["status"] = 403
    if compiled.get("mode") == "simulate" and result["action"] != "allow":
        result["simulated_action"] = result["action"]
        result["action"] = "allow"
        result["status"] = 200
    return result


def _blocked_ip_entry_is_active(entry, ip, now=None):
    source = entry if isinstance(entry, dict) else {"ip": entry}
    if str(source.get("ip") or "") != str(ip or ""):
        return False
    expires_at = source.get("expires_at")
    if expires_at not in (None, ""):
        try:
            expiry = float(expires_at)
        except (TypeError, ValueError):
            try:
                parsed = datetime.fromisoformat(str(expires_at).replace("Z", "+00:00"))
                if parsed.tzinfo is None:
                    parsed = parsed.replace(tzinfo=timezone.utc)
                expiry = parsed.timestamp()
            except (TypeError, ValueError, OverflowError):
                return False
        if expiry <= (time.time() if now is None else float(now)):
            return False
    elif source.get("auto"):
        return False
    return True


def _gateway_security_decision(method, path_query, ip, country, ua, headers, content_length,
                               body_text="", body_hash="", body_inspection="not_inspected", policy=None,
                               mcp_authenticated_body=False):
    p = policy if isinstance(policy, dict) else _gateway_security_snapshot()
    path_query = str(path_query or "/")
    parsed_path = urllib.parse.urlsplit(path_query)
    path = parsed_path.path or "/"
    compiled_waf = p.get("compiled_waf") if isinstance(p.get("compiled_waf"), dict) else {}
    ctx = {
        "ip": ip,
        "country": country,
        "path": path,
        "path_query": path_query,
        "query": parsed_path.query,
        "method": method.upper(),
        "ua": ua[:200],
        "body_preview": body_text,
        "body_text": body_text,
        "body_hash": body_hash,
        "body_inspection": body_inspection,
        "headers": headers,
        "content_type": headers.get("Content-Type", ""),
        "content_length": content_length,
        "risk_score": 0,
        "decision": None,
        "decision_reason": "allow",
        "response_status": 200,
        "response_body": b"",
        "response_content_type": "text/plain",
        "tarpit_delay": 0,
        "telemetry": {},
        "pipeline_logs": [],
        "stack_runs": [],
        "telemetry_dimensions": p.get("telemetry_dimensions", []) or ["path", "method", "status", "country", "ip", "user_agent"],
        "waf_revision": str(compiled_waf.get("revision") or ""),
        "matched_rule_ids": [],
        "_policy_snapshot": p,
    }

    stacks = _get_pipeline_stacks(p)
    for stack in stacks:
        _run_stack(ctx, stack, "telemetry")
    # Internal call argument only: no HTTP header, app environment or policy
    # telemetry module can assert this request's current MCP authentication.
    ctx["_mcp_authenticated_body"] = mcp_authenticated_body is True and path == "/mcp"

    if ip in (p.get("whitelisted_ips", []) or []):
        ctx["decision_reason"] = "whitelist"
        return "allow", 200, b"", "text/plain", ctx

    now = time.time()
    if any(_blocked_ip_entry_is_active(entry, ip, now) for entry in (p.get("blocked_ips", []) or [])):
        _sec_report_event("policy", ip, f"Blocked IP attempted access: {path}", path=path)
        ctx["decision"] = "block"
        ctx["decision_reason"] = "blocked_ip"
        return "block", 403, b"Forbidden", "text/plain", ctx

    with _sec_lock:
        blocked_until = 0
        for store in (_sec_auto_blocked, _sec_honeypot_blocked):
            until = float(store.get(ip) or 0) if ip else 0
            if until and now >= until:
                store.pop(ip, None)
            else:
                blocked_until = max(blocked_until, until)
    if blocked_until and now < blocked_until:
        ctx["decision"] = "block"
        ctx["decision_reason"] = "auto_blocked"
        return "block", 403, b"Forbidden", "text/plain", ctx

    if p.get("geo_block_enabled"):
        geo_mode = str(p.get("geo_block_mode", "blocklist") or "blocklist").lower()
        geo_countries = {str(c).strip().upper() for c in (p.get("geo_block_countries", []) or []) if str(c).strip()}
        should_block = _geo_country_blocked(country, geo_mode, geo_countries)
        if should_block:
            _sec_report_event("geo", ip, f"Geo-blocked request from {country}: {method} {path}", path=path, pattern="geo", extra={"user_agent": ua[:200], "method": method, "country": country})
            ctx["decision"] = "block"
            ctx["decision_reason"] = "geo_block"
            return "block", 403, b"Forbidden", "text/plain", ctx

    max_body = _safe_int(p.get("max_body_bytes", 262144), 262144, 0, 100 * 1024 * 1024)
    if content_length > max_body:
        _sec_report_event("policy", ip, f"Request body exceeded limit: {content_length} bytes", path=path, pattern="oversized-body", extra={"user_agent": ua[:200], "method": method, "content_length": content_length, "country": country})
        ctx["decision"] = "block"
        ctx["decision_reason"] = "oversized_body"
        return "block", 413, b"Payload Too Large", "text/plain", ctx

    blocked_methods = [m.upper() for m in (p.get("blocked_methods", []) or [])]
    if method.upper() in blocked_methods:
        _sec_report_event("policy", ip, f"Disallowed method attempted: {method} {path}", path=path, pattern="method", extra={"user_agent": ua[:200], "method": method, "country": country})
        ctx["decision"] = "block"
        ctx["decision_reason"] = "blocked_method"
        return "block", 405, b"Method Not Allowed", "text/plain", ctx

    if p.get("honeypot_enabled"):
        for trap in p.get("honeypot_routes", []) or []:
            trap_method = "ANY"
            trap_path = ""
            if isinstance(trap, dict):
                trap_method = str(trap.get("method", "ANY")).upper()
                trap_path = str(trap.get("path", ""))
            elif isinstance(trap, str):
                trap_path = trap
            if trap_path and (path == trap_path or path.startswith(trap_path + "/")) and (trap_method == "ANY" or trap_method == method.upper()):
                score = 35 if content_length else 15
                ctx["risk_score"] = score
                ctx["decision"] = "honeypot"
                ctx["decision_reason"] = "honeypot"
                _sec_report_event("honeypot", ip, f"Honeypot trap triggered: {method} {path}", path=path, pattern="honeypot", extra={"user_agent": ua[:200], "method": method, "headers": _redact_sensitive_headers(headers), "body_hash": body_hash, "body_inspection": body_inspection, "content_length": content_length, "threat_score": score, "country": country})
                actions = p.get("honeypot_actions", []) or [p.get("honeypot_action", "log")]
                if (p.get("honeypot_fake_response_enabled") or p.get("honeypot_fake_response_body")) and "deceive" not in actions:
                    actions = list(actions) + ["deceive"]
                if "block" in actions:
                    with _sec_lock:
                        duration = _safe_int(p.get("auto_block_duration_minutes", 30), 30, 1, 525600)
                        _bounded_security_state_put(_sec_honeypot_blocked, ip, now + duration * 60, SECURITY_STATE_MAX_IDENTITIES)
                if "tarpit" in actions:
                    ctx["tarpit_delay"] = max(ctx.get("tarpit_delay", 0), p.get("honeypot_tarpit_delay", 15))
                if "deceive" in actions:
                    fake_body = str(p.get("honeypot_fake_response_body") or "").strip() or '{"status":"ok","version":"1.0.0","debug":false}'
                    try:
                        json.dumps(json.loads(fake_body), allow_nan=False)
                        content_type = "application/json"
                    except (ValueError, TypeError, RecursionError, OverflowError):
                        content_type = "text/plain"
                    ctx["decision"] = "deceive"
                    ctx["decision_reason"] = "honeypot_deceive"
                    return "deceive", 200, fake_body.encode("utf-8", errors="replace"), content_type, ctx
                if "block" in actions:
                    ctx["decision"] = "block"
                    ctx["decision_reason"] = "honeypot_block"
                    return "block", 403, b"Forbidden", "text/plain", ctx
                return "block", 404, b"Not Found", "text/plain", ctx

    inspection = compiled_waf.get("inspection") if isinstance(compiled_waf.get("inspection"), dict) else {}
    body_rules_enabled = any(
        isinstance(rule, dict) and rule.get("enabled", True) is not False and rule.get("target") == "body"
        for rule in (compiled_waf.get("rules") or [])
    )
    if body_rules_enabled and content_length > 0 and body_inspection != "fully_inspected" and not ctx["_mcp_authenticated_body"]:
        action = str(inspection.get("uninspected_body_action") or "block").lower()
        ctx["telemetry"]["body_inspection_action"] = action
        if action == "block" and compiled_waf.get("mode") == "enforce":
            ctx["decision"] = "block"
            ctx["decision_reason"] = "waf_uninspected_body"
            ctx["response_status"] = 403
            _sec_report_event("waf", ip, "Request body could not be fully inspected", path=path, pattern="waf_uninspected_body", extra={"method": method, "body_hash": body_hash, "body_inspection": body_inspection, "content_length": content_length, "waf_revision": ctx["waf_revision"]})
            return "block", 403, b"Forbidden", "text/plain", ctx

    waf_result = _evaluate_compiled_waf(ctx, compiled_waf, p)
    ctx["risk_score"] = max(int(ctx.get("risk_score", 0) or 0), int(waf_result.get("score", 0) or 0))
    ctx["matched_rule_ids"] = list(waf_result.get("matched_rule_ids") or [])
    ctx["telemetry"]["waf"] = {
        "revision": ctx["waf_revision"],
        "score": int(waf_result.get("score", 0) or 0),
        "matched_rule_ids": list(ctx["matched_rule_ids"]),
        "action": waf_result.get("action") or "allow",
        "simulated_action": waf_result.get("simulated_action") or "",
        "body_inspection": body_inspection,
        "mcp_authenticated_body": ctx["_mcp_authenticated_body"],
    }
    if ctx["matched_rule_ids"]:
        reported_action = waf_result.get("simulated_action") or waf_result.get("action") or "log"
        event_type = "waf" if reported_action == "block" and compiled_waf.get("mode") == "enforce" else "policy"
        _sec_report_event(event_type, ip, f"WAF matched {len(ctx['matched_rule_ids'])} rule(s)", path=path, pattern="waf", extra={"user_agent": ua[:200], "method": method, "headers": _redact_sensitive_headers(headers), "body_hash": body_hash, "body_inspection": body_inspection, "content_length": content_length, "threat_score": min(100, int(waf_result.get("score", 0) or 0)), "country": country, "matched_rule_ids": ctx["matched_rule_ids"], "waf_revision": ctx["waf_revision"]})
    waf_action = waf_result.get("action") or "allow"
    if waf_action in {"block", "rate_limit"}:
        status = int(waf_result.get("status") or (429 if waf_action == "rate_limit" else 403))
        ctx["decision"] = "ratelimit" if waf_action == "rate_limit" else "block"
        ctx["decision_reason"] = f"waf:{waf_action}"
        ctx["response_status"] = status
        if waf_action == "rate_limit":
            ctx["retry_after"] = int(waf_result.get("retry_after", 1) or 1)
        return "block", status, b"Rate limit exceeded" if status == 429 else b"Forbidden", "text/plain", ctx

    rate = _rate_limit_decision(ip, path, policy=p)
    ctx["telemetry"]["rate_limit"] = {"allowed": rate.get("allowed"), "enforced": rate.get("enforced"), "reason": rate.get("reason")}
    if not rate.get("allowed"):
        _sec_report_event("ratelimit", ip, f"Rate limit exceeded: {path}", path=path, pattern="rate_limit", extra={"method": method, "retry_after": rate.get("retry_after", 1)})
        ctx["decision"] = "ratelimit"
        ctx["decision_reason"] = "rate_limit"
        ctx["retry_after"] = int(rate.get("retry_after", 1) or 1)
        return "block", 429, b"Rate limit exceeded", "text/plain", ctx

    for stack in stacks:
        _run_stack(ctx, stack, "response")
        if ctx.get("decision"):
            break
    _dec = ctx.get("decision")
    if _dec in ("block", "deceive"):
        return _dec, int(ctx.get("response_status") or (200 if _dec == "deceive" else 403)), ctx.get("response_body") or b"Forbidden", ctx.get("response_content_type") or "text/plain", ctx

    return "allow", 200, b"", "text/plain", ctx

def _gateway_mcp_auth_check_url(gateway):
    """Signed manifest opt-in only; never resolve a hostname or follow a URL."""
    value = gateway.get("mcp_auth_check_url") if isinstance(gateway, dict) else None
    if not isinstance(value, str):
        return ""
    match = re.fullmatch(r"http://(?:127\.0\.0\.1|\[::1\])(?::([0-9]{1,5}))?/mcp/auth-check", value)
    if not match or (match.group(1) is not None and not 1 <= int(match.group(1)) <= 65535):
        return ""
    return value


async def _gateway_mcp_authenticate_body(client, semaphore, auth_check_url, path, raw_path, authorization_values):
    """No cache: expiry, activation, revocation and billing are checked anew."""
    if not auth_check_url or path != "/mcp" or raw_path != "/mcp" or len(authorization_values) != 1:
        return False
    authorization = authorization_values[0]
    if not isinstance(authorization, str) or len(authorization) > 512 or not re.fullmatch(r"Bearer ivmcp\.[A-Za-z0-9._-]+", authorization):
        return False
    if not client or not semaphore or _gateway_mcp_auth_check_url({"mcp_auth_check_url": auth_check_url}) != auth_check_url:
        return False

    async def check():
        async with semaphore:
            async with client.post(
                auth_check_url,
                headers={"Authorization": authorization, "Accept": "application/json"},
                data=b"",
                allow_redirects=False,
            ) as response:
                if response.status != 200 or (response.content_length is not None and response.content_length > 128):
                    return False
                if str(response.headers.get("Content-Encoding") or "identity").lower() not in ("", "identity"):
                    return False
                body = bytearray()
                while len(body) <= 128:
                    part = await response.content.read(129 - len(body))
                    if not part:
                        break
                    body.extend(part)
                if len(body) > 128:
                    return False
                result = json.loads(bytes(body).decode("utf-8"))
                return isinstance(result, dict) and result.get("valid") is True

    try:
        # Includes the semaphore queue and the complete bounded response, not
        # merely connecting. Unavailable/slow/invalid checkers retain normal WAF.
        return await asyncio.wait_for(check(), timeout=1.0)
    except Exception:
        return False


def _run_aiohttp_gateway(
    manifest,
    listen,
    generation,
    bind_host="0.0.0.0",
    edge_secret=None,
    ready_event=None,
    require_runtime_policy=False,
    policy_timeout=SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS,
    listen_socket=None,
):
    if require_runtime_policy:
        policy_source = _wait_for_runtime_security_policy(timeout=policy_timeout)
        report_log(f"[INFO] External gateway startup policy gate satisfied by {policy_source}.")
    from aiohttp import web, ClientSession, ClientTimeout, WSMsgType, TCPConnector, DummyCookieJar
    global _GATEWAY_EDGE_SECRET
    _GATEWAY_EDGE_SECRET = edge_secret

    gateway = manifest.get("gateway") if isinstance(manifest.get("gateway"), dict) else {}
    mcp_auth_check_url = _gateway_mcp_auth_check_url(gateway)
    client_timeout = ClientTimeout(
        total=None,
        sock_connect=max(1, int(gateway.get("connect_timeout_seconds") or 10)),
        sock_read=max(5, int(gateway.get("read_timeout_seconds") or 300)),
    )
    chunk_size = max(8192, min(1024 * 1024, int(gateway.get("chunk_size_bytes") or 65536)))
    manifest_max_body_bytes = _safe_int(
        gateway.get("max_body_bytes", 100 * 1024 * 1024),
        100 * 1024 * 1024,
        0,
        100 * 1024 * 1024,
    )
    websocket_max_message = max(1024, min(16 * 1024 * 1024, int(gateway.get("websocket_max_message_bytes") or 1024 * 1024)))
    websocket_messages_per_minute = max(1, min(100000, int(gateway.get("websocket_messages_per_minute") or 600)))
    body_read_timeout = max(1, min(120, int(gateway.get("body_read_timeout_seconds") or 30)))

    async def proxy_handler(request):
        raw_path = str(request.raw_path or "/").split("?", 1)[0] or "/"
        try:
            path = _canonical_gateway_request_path(raw_path)
        except ValueError:
            response = web.Response(status=400, text="Invalid request path.")
            response.force_close()
            return response
        path_query = path + (("?" + request.query_string) if request.query_string else "")
        ip = _aiohttp_request_ip(request)
        country = _aiohttp_request_country(request)
        ua = request.headers.get("User-Agent", "")
        headers = _header_items_without_hop_by_hop(request.headers)
        trusted_edge = _request_from_trusted_edge(request)
        headers["X-Forwarded-For"] = ip
        headers["X-Forwarded-Proto"] = request.headers.get("X-Forwarded-Proto", request.scheme) if trusted_edge else request.scheme
        headers["X-Forwarded-Host"] = request.headers.get("Host", "")
        is_websocket = request.headers.get("Upgrade", "").lower() == "websocket"

        policy = _gateway_security_snapshot()
        policy_max_body_bytes = _safe_int(policy.get("max_body_bytes", 262144), 262144, 0, 100 * 1024 * 1024)
        max_body_bytes = min(policy_max_body_bytes, manifest_max_body_bytes)
        declared_length = _safe_int(request.headers.get("Content-Length", 0), 0, 0, 10 * 1024 * 1024 * 1024)
        compiled = policy.get("compiled_waf") if isinstance(policy.get("compiled_waf"), dict) else {}
        inspection = compiled.get("inspection") if isinstance(compiled.get("inspection"), dict) else {}
        inspect_limit = _safe_int(inspection.get("inspect_body_bytes", max_body_bytes), max_body_bytes, 0, max_body_bytes)
        body_spool = None
        body_preview = bytearray()
        body_hasher = hashlib.sha256()
        body_bytes_read = 0
        body_read_error = ""
        body_decode_error = ""
        body_too_large = declared_length > max_body_bytes
        encoding_values = [str(value).strip().lower() for value in request.headers.getall("Content-Encoding", []) if str(value).strip()]
        content_encoding = encoding_values[0] if len(encoding_values) == 1 else ""
        decoder = None
        if len(encoding_values) > 1 or any("," in value for value in encoding_values):
            body_decode_error = "ambiguous content encoding"
        elif content_encoding in ("gzip", "x-gzip"):
            decoder = zlib.decompressobj(16 + zlib.MAX_WBITS)
        elif content_encoding == "deflate":
            decoder = zlib.decompressobj(zlib.MAX_WBITS)
        elif content_encoding not in ("", "identity"):
            body_decode_error = f"unsupported:{content_encoding[:80]}"
        if not is_websocket and not body_too_large and request.can_read_body:
            body_spool = tempfile.SpooledTemporaryFile(
                max_size=min(1024 * 1024, max(64 * 1024, max_body_bytes)),
                mode="w+b",
            )
            try:
                body_deadline = time.monotonic() + body_read_timeout
                while True:
                    remaining = body_deadline - time.monotonic()
                    if remaining <= 0:
                        raise asyncio.TimeoutError("request body read timed out")
                    chunk = await asyncio.wait_for(request.content.read(chunk_size), timeout=remaining)
                    if not chunk:
                        break
                    body_bytes_read += len(chunk)
                    if body_bytes_read > max_body_bytes:
                        body_too_large = True
                        break
                    body_spool.write(chunk)
                    body_hasher.update(chunk)
                    if not body_decode_error and len(body_preview) <= inspect_limit:
                        try:
                            if decoder is None:
                                body_preview.extend(chunk[:max(0, inspect_limit + 1 - len(body_preview))])
                            else:
                                body_preview.extend(decoder.decompress(chunk, max(0, inspect_limit + 1 - len(body_preview))))
                        except Exception as exc:
                            body_decode_error = str(exc)[:300]
                            body_preview.clear()
                if decoder is not None and not body_too_large and not body_read_error and not body_decode_error and len(body_preview) <= inspect_limit:
                    try:
                        body_preview.extend(decoder.flush(max(0, inspect_limit + 1 - len(body_preview))))
                        if not decoder.eof or decoder.unused_data or decoder.unconsumed_tail:
                            body_decode_error = "incomplete compressed body"
                            body_preview.clear()
                    except Exception as exc:
                        body_decode_error = str(exc)[:300]
                        body_preview.clear()
                if not body_too_large:
                    body_spool.seek(0)
            except asyncio.TimeoutError:
                body_read_error = "request body read timed out"
            except Exception as exc:
                body_read_error = str(exc)[:300]
        content_length = max(declared_length, body_bytes_read)
        if declared_length and body_bytes_read != declared_length and not body_too_large and not body_read_error:
            body_read_error = "content length mismatch"
        body_hash = body_hasher.hexdigest() if body_bytes_read and not body_too_large and not body_read_error else ""
        if content_length <= 0:
            inspection_state = "not_applicable"
        elif body_decode_error:
            inspection_state = "not_inspected"
        elif not body_too_large and not body_read_error and len(body_preview) <= inspect_limit:
            inspection_state = "fully_inspected"
        elif body_preview:
            inspection_state = "partially_inspected"
        else:
            inspection_state = "not_inspected"
        body_text = bytes(body_preview).decode("utf-8", errors="replace")

        def close_body_spool():
            nonlocal body_spool
            if body_spool is not None:
                try:
                    body_spool.close()
                except Exception:
                    pass
                body_spool = None

        async def iter_body_spool():
            loop = asyncio.get_running_loop()
            while body_spool is not None:
                chunk = await loop.run_in_executor(None, body_spool.read, chunk_size)
                if not chunk:
                    break
                yield chunk

        mcp_authenticated_body = False
        if not body_too_large and not body_read_error and not body_decode_error:
            mcp_authenticated_body = await _gateway_mcp_authenticate_body(
                request.app.get("mcp_auth_client"), request.app.get("mcp_auth_semaphore"),
                mcp_auth_check_url, path, raw_path, request.headers.getall("Authorization", []),
            )
        decision, status, decision_body, decision_type, ctx = _gateway_security_decision(
            request.method, path_query, ip, country, ua, headers, content_length,
            body_text=body_text, body_hash=body_hash, body_inspection=inspection_state, policy=policy,
            mcp_authenticated_body=mcp_authenticated_body,
        )

        if body_too_large:
            decision = "block"
            status = 413
            decision_body = b"Request body too large"
            decision_type = "text/plain"
            ctx["decision"] = "block"
            ctx["decision_reason"] = "body_too_large"
            ctx["response_status"] = 413
        elif body_read_error:
            decision = "block"
            status = 408 if body_read_error == "request body read timed out" else 400
            decision_body = b"Request Timeout" if status == 408 else b"Invalid request body"
            decision_type = "text/plain"
            ctx["decision"] = "block"
            ctx["decision_reason"] = "body_read_error"
            ctx["response_status"] = status
        elif body_decode_error:
            decision = "block"
            status = 400
            decision_body = b"Invalid content encoding"
            decision_type = "text/plain"
            ctx["decision"] = "block"
            ctx["decision_reason"] = "body_decode_error"
            ctx["response_status"] = status

        if body_spool is not None and declared_length and body_bytes_read == declared_length and not body_too_large and not body_read_error:
            headers["Content-Length"] = str(declared_length)

        trace_environ = {"REMOTE_ADDR": ip, "HTTP_USER_AGENT": ua, "CONTENT_TYPE": request.headers.get("Content-Type", "")}
        for key, value in request.headers.items():
            normalized = "HTTP_" + str(key).upper().replace("-", "_")
            if normalized not in ("HTTP_COOKIE", "HTTP_AUTHORIZATION", "HTTP_PROXY_AUTHORIZATION", "HTTP_X_INFRAVEIL_EDGE"):
                trace_environ[normalized] = str(value)[:1000]

        def report(status_code, transport="streaming-http"):
            ctx["upstream_status"] = int(status_code or 0)
            ctx["response_status"] = int(status_code or ctx.get("response_status") or 0)
            ctx.setdefault("telemetry", {})["transport"] = transport
            _report_network_event(
                ip, request.method, path, trace_environ, body_preview=body_text,
                telemetry=_finalize_pipeline_reporting(ctx),
                body_size=content_length, body_hash=body_hash,
                body_inspection=inspection_state,
                content_type=request.headers.get("Content-Type", ""),
            )

        if decision != "allow":
            delay = min(120.0, max(0.0, float(ctx.get("tarpit_delay", 0) or 0)))
            if delay:
                await asyncio.sleep(delay)
            report(status, "blocked-http")
            response = web.Response(status=status, body=decision_body, content_type=decision_type)
            close_body_spool()
            if body_too_large or body_read_error or body_decode_error:
                response.force_close()
            if status == 429:
                response.headers["Retry-After"] = str(max(1, int(ctx.get("retry_after", 1) or 1)))
            return response

        ws_server = None
        if is_websocket:
            ws_server = web.WebSocketResponse(max_msg_size=websocket_max_message)
            try:
                ready = ws_server.can_prepare(request)
            except Exception:
                ready = None
            if ready is None or not ready.ok:
                ctx["decision_reason"] = "invalid_websocket_handshake"
                report(400, "invalid-websocket-handshake")
                close_body_spool()
                response = web.Response(status=400, text="Invalid WebSocket handshake.")
                response.force_close()
                return response

        route, svc, port = _gateway_route_target(manifest, path)
        if not svc or not port:
            ctx["decision_reason"] = "route_target_missing"
            report(502)
            close_body_spool()
            return web.Response(status=502, text="Route target is not running.")

        delay = min(120.0, max(0.0, float(ctx.get("tarpit_delay", 0) or 0)))
        if delay:
            await asyncio.sleep(delay)

        upstream = f"http://127.0.0.1:{port}{raw_path}"
        if request.query_string:
            upstream += "?" + request.query_string

        if is_websocket:
            try:
                ws_client = await request.app["client"].ws_connect(upstream, headers=headers, max_msg_size=websocket_max_message)
            except Exception as exc:
                ctx["decision_reason"] = "websocket_upstream_unavailable"
                report(502, "websocket-connect-failed")
                report_error(f"Gateway websocket connection failure: {exc}", label="[GATEWAY_ERROR]")
                close_body_spool()
                return web.Response(status=502, text="Upstream websocket unavailable.")
            message_times = []
            try:
                await ws_server.prepare(request)
                async def client_to_upstream():
                    async for msg in ws_server:
                        if msg.type in (WSMsgType.TEXT, WSMsgType.BINARY):
                            size = len(msg.data.encode("utf-8")) if msg.type == WSMsgType.TEXT else len(msg.data)
                            now = time.time()
                            message_times[:] = [item for item in message_times if now - item < 60]
                            if size > websocket_max_message or len(message_times) >= websocket_messages_per_minute:
                                await ws_server.close(code=1008, message=b"Policy limit exceeded")
                                await ws_client.close()
                                return
                            message_times.append(now)
                            if msg.type == WSMsgType.TEXT:
                                await ws_client.send_str(msg.data)
                            else:
                                await ws_client.send_bytes(msg.data)
                        elif msg.type == WSMsgType.CLOSE:
                            await ws_client.close()
                    await ws_client.close()

                async def upstream_to_client():
                    async for msg in ws_client:
                        if msg.type == WSMsgType.TEXT:
                            await ws_server.send_str(msg.data)
                        elif msg.type == WSMsgType.BINARY:
                            await ws_server.send_bytes(msg.data)
                        elif msg.type == WSMsgType.CLOSE:
                            await ws_server.close()
                    await ws_server.close()

                await asyncio.gather(client_to_upstream(), upstream_to_client(), return_exceptions=True)
            finally:
                await ws_client.close()
            report(101, "websocket")
            close_body_spool()
            return ws_server

        data = iter_body_spool() if body_spool is not None and body_bytes_read else None
        downstream = None
        upstream_status = 0
        try:
            async with request.app["client"].request(request.method, upstream, headers=headers, data=data, allow_redirects=False) as upstream_resp:
                upstream_status = int(upstream_resp.status)
                downstream = web.StreamResponse(status=upstream_resp.status)
                response_connection_tokens = set()
                for raw_key, raw_value in upstream_resp.raw_headers:
                    if raw_key.decode("utf-8", errors="ignore").lower() == "connection":
                        response_connection_tokens.update(
                            token.strip().lower()
                            for token in raw_value.decode("utf-8", errors="ignore").split(",")
                            if token.strip()
                        )
                for raw_key, raw_value in upstream_resp.raw_headers:
                    key = raw_key.decode("utf-8", errors="surrogateescape")
                    if key.lower() in HOP_BY_HOP_HEADERS or key.lower() in response_connection_tokens:
                        continue
                    value = raw_value.decode("utf-8", errors="surrogateescape")
                    downstream.headers.add(key, value)
                await downstream.prepare(request)
                async for chunk in upstream_resp.content.iter_chunked(chunk_size):
                    await downstream.write(chunk)
                await downstream.write_eof()
                report(upstream_resp.status)
                return downstream
        except asyncio.TimeoutError as exc:
            if downstream is not None and downstream.prepared:
                ctx["decision_reason"] = "upstream_response_truncated"
                report(upstream_status, "truncated-http")
                downstream.force_close()
                if request.transport is not None:
                    request.transport.close()
                return downstream
            ctx["decision_reason"] = "upstream_timeout"
            report(504)
            report_error(f"Gateway proxy timeout: {exc}", label="[GATEWAY_ERROR]")
            return web.Response(status=504, text="Upstream service timed out.")
        except Exception as exc:
            if downstream is not None and downstream.prepared:
                ctx["decision_reason"] = "upstream_response_truncated"
                report(upstream_status, "truncated-http")
                downstream.force_close()
                if request.transport is not None:
                    request.transport.close()
                return downstream
            ctx["decision_reason"] = "upstream_unavailable"
            report(502)
            report_error(f"Gateway proxy failure: {exc}", label="[GATEWAY_ERROR]")
            return web.Response(status=502, text="Upstream service unavailable.")
        finally:
            close_body_spool()

    async def on_startup(app):
        app["client"] = ClientSession(timeout=client_timeout, auto_decompress=False)
        if mcp_auth_check_url:
            # Separate from application proxy traffic: no environment proxy,
            # cookies, redirect authority or service-supplied configuration.
            app["mcp_auth_semaphore"] = asyncio.Semaphore(4)
            app["mcp_auth_client"] = ClientSession(
                timeout=ClientTimeout(total=1, connect=1, sock_read=1),
                connector=TCPConnector(limit=4, limit_per_host=4),
                cookie_jar=DummyCookieJar(), trust_env=False, auto_decompress=False,
            )

    async def on_cleanup(app):
        client = app.get("client")
        if client:
            await client.close()
        mcp_auth_client = app.get("mcp_auth_client")
        if mcp_auth_client:
            await mcp_auth_client.close()

    app = web.Application(client_max_size=1024 ** 3)
    app.on_startup.append(on_startup)
    app.on_cleanup.append(on_cleanup)
    app.router.add_route("*", "/{tail:.*}", proxy_handler)

    loop = asyncio.new_event_loop()
    asyncio.set_event_loop(loop)
    runner = web.AppRunner(app, access_log=None, auto_decompress=False)
    try:
        loop.run_until_complete(runner.setup())
        site = web.SockSite(runner, listen_socket) if listen_socket is not None else web.TCPSite(runner, bind_host, listen, reuse_address=True)
        loop.run_until_complete(site.start())
        if ready_event is not None:
            ready_event.set()
        report_log(f"[INFO] Infraveil async runtime gateway listening on {bind_host}:{listen} with aiohttp streaming proxy.")
        while not _shutdown and generation == _service_generation:
            loop.run_until_complete(asyncio.sleep(0.5))
    finally:
        try:
            loop.run_until_complete(runner.cleanup())
        finally:
            pending = [task for task in asyncio.all_tasks(loop) if not task.done()]
            for task in pending:
                task.cancel()
            if pending:
                loop.run_until_complete(asyncio.gather(*pending, return_exceptions=True))
            loop.run_until_complete(loop.shutdown_asyncgens())
            loop.close()
def _gateway_runtime_root():
    root = os.path.join(_agent_root(), "gateway_runtime")
    os.makedirs(root, exist_ok=True)
    try:
        os.chmod(root, 0o700)
    except Exception:
        pass
    return root

