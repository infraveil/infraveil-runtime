def _tail_external_systemd_logs(name, spec, generation):
    if os.name == "nt" or not shutil.which("journalctl"):
        return
    unit = str(spec.get("unit") or "")
    cursor_path = os.path.join(_agent_root(), f"journal_cursor_{_agent_slug()}_{re.sub(r'[^A-Za-z0-9_.-]', '_', name)}.txt")
    pending_path = cursor_path + ".pending.json"
    _external_log_health[name] = {"failures_total": 0, "last_failure_ts": 0,
                                  "last_record_ts": 0, "last_ack_ts": 0, "pending_since": 0}
    backoff = 1.0
    while not _shutdown and generation == _service_generation:
        try:
            _ack_journal_pending(name, pending_path, cursor_path)
        except Exception:
            _journal_capture_failure(name)
            time.sleep(backoff)
            backoff = min(30.0, backoff * 2.0)
            continue
        cursor = ""
        try:
            if os.path.isfile(cursor_path):
                with open(cursor_path, encoding="utf-8") as cursor_file:
                    cursor = cursor_file.read().strip()
        except Exception:
            _journal_capture_failure(name)
            time.sleep(backoff)
            backoff = min(30.0, backoff * 2.0)
            continue
        command = ["journalctl", "--unit", unit, "--follow", "--output", "json", "--no-pager"]
        if cursor:
            command.extend(["--after-cursor", cursor, "--lines", "all"])
        else:
            command.extend(["--since", "5 minutes ago", "--lines", "1000"])
        proc = None
        try:
            proc = subprocess.Popen(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                encoding="utf-8",
                errors="replace",
                start_new_session=True,
            )
            _external_log_processes[name] = proc
            backoff = 1.0
            if proc.stdout is not None:
                for raw_line in proc.stdout:
                    if _shutdown or generation != _service_generation:
                        break
                    line = str(raw_line or "").strip()
                    if not line:
                        continue
                    try:
                        record = json.loads(line)
                        message = str(record.get("MESSAGE") or "")
                        next_cursor = str(record.get("__CURSOR") or "")
                    except Exception:
                        raise ValueError("Journal did not return JSON records")
                    if not next_cursor:
                        raise ValueError("Journal record has no cursor")
                    _external_log_health[name]["last_record_ts"] = time.time()
                    if message:
                        level = _journal_log_level(record, message)
                        message = _redact_runtime_log_message(message)
                        _service_output_tail[name] = message[-2000:]
                        event = "[PROCESS_EVENT] " + json.dumps({
                            "service": name,
                            "stream": "journal",
                            "realm": "app",
                            "level": level,
                            "message": message[-4000:],
                            "phase": "external-runtime",
                        }, separators=(",", ":"))
                        event_id = "journal-" + hashlib.sha256((str(AGENT_ID) + ":" + unit + ":" + next_cursor).encode("utf-8")).hexdigest()
                        pending = {"cursor": next_cursor, "at": time.time(), "payload": {
                            "client_id": CLIENT_ID, "agent_id": AGENT_ID, "event_id": event_id,
                            "log": _bounded_agent_log(event)}}
                        _journal_atomic_write(pending_path, json.dumps(pending, separators=(",", ":")).encode("utf-8"))
                        _ack_journal_pending(name, pending_path, cursor_path)
                    else:
                        _journal_atomic_write(cursor_path, next_cursor.encode("utf-8"))
            if not _shutdown and generation == _service_generation:
                _journal_capture_failure(name)
            if proc.poll() is None:
                try:
                    proc.terminate()
                except Exception:
                    pass
        except Exception as exc:
            _journal_capture_failure(name)
        finally:
            current = _external_log_processes.get(name)
            if current is proc:
                _external_log_processes.pop(name, None)
            if proc is not None and proc.poll() is None:
                try:
                    proc.terminate()
                except Exception:
                    pass
        if not _shutdown and generation == _service_generation:
            time.sleep(backoff)
            backoff = min(30.0, backoff * 2.0)


def _runtime_candidate_is_healthy():
    if _payload_mode == "process":
        gateway_required = _current_manifest_summary.get("gateway_enabled", True) is not False
        if gateway_required and not (_gateway_thread and _gateway_thread.is_alive()):
            return False
        if not _service_specs:
            return False
        for name in _service_specs:
            proc = _service_processes.get(name)
            if proc is None or proc.poll() is not None:
                return False
            if int(_service_health_failures.get(name, 0) or 0) != 0:
                return False
            if not _service_health_observed(name):
                return False
            if int(_service_restart_counts.get(name, 0) or 0) != 0:
                return False
        return True
    if _payload_mode == "external-process":
        if not _external_service_specs:
            return False
        for name, spec in _external_service_specs.items():
            status = _external_service_status(spec)
            if not status.get("healthy") or int(_service_health_failures.get(name, 0) or 0) != 0:
                return False
        gateway_required = _current_manifest_summary.get("gateway_enabled", True) is not False
        return (not gateway_required) or bool(_gateway_thread and _gateway_thread.is_alive())
    return False



def _run_manifest_command(label, name, command, cwd, env, runtime="generic"):
    if not command:
        return
    commands = command if isinstance(command, list) else [command]
    for idx, item in enumerate(commands, start=1):
        command = _normalize_service_command(runtime, item)
        if not command:
            continue
        step_label = f"{label} [{idx}/{len(commands)}]" if len(commands) > 1 else label
        report_log(f"[INFO] {step_label} [{name}] {command}")
        try:
            parts = shlex.split(command, posix=(os.name != "nt"))
        except Exception as exc:
            raise RuntimeError(f"{step_label} command for {name} could not be parsed safely: {exc}")
        if not parts:
            continue
        if any(token in command for token in ("&&", "||", ";", "|", "`", "$(", "\n", "\r")):
            raise RuntimeError(f"{step_label} command for {name} uses shell operators; split it into explicit manifest steps.")
        if os.name == "nt":
            parts[0] = parts[0].strip("\"")
        if os.name == "nt" and parts[0].lower().endswith((".cmd", ".bat")):
            parts = [os.environ.get("ComSpec", "cmd.exe"), "/d", "/c", "call", *parts]
        try:
            subprocess.check_output(parts, cwd=cwd, env=env, shell=False, stderr=subprocess.STDOUT, timeout=300,
                creationflags=(getattr(subprocess, "CREATE_NO_WINDOW", 0) if os.name == "nt" else 0))
        except subprocess.CalledProcessError as exc:
            output = (exc.output or b"").decode("utf-8", errors="replace").strip()
            tail = output[-4000:] if output else "(no output captured)"
            report_log(f"[ERROR] {step_label} [{name}] failed with exit {exc.returncode}: {tail}")
            raise RuntimeError(f"{step_label} command for {name} failed with exit {exc.returncode}: {tail}") from exc
        except subprocess.TimeoutExpired as exc:
            output = (exc.output or b"").decode("utf-8", errors="replace").strip()
            tail = output[-4000:] if output else "(no output captured)"
            report_log(f"[ERROR] {step_label} [{name}] timed out after 300s: {tail}")
            raise RuntimeError(f"{step_label} command for {name} timed out after 300s: {tail}") from exc

