    "2a06:98c0::/29",
    "2c0f:f248::/32",
]

CLOUDFLARE_NETWORKS = [ipaddress.ip_network(cidr) for cidr in CLOUDFLARE_CIDRS]


def _is_cloudflare_ip(ip_str: str) -> bool:
    try:
        ip = ipaddress.ip_address(ip_str)
        return any(ip in net for net in CLOUDFLARE_NETWORKS)
    except ValueError:
        return False


def _is_valid_public_ip(ip_str: str) -> bool:
    try:
        ip = ipaddress.ip_address(ip_str)
        return not (
            ip.is_private or
            ip.is_loopback or
            ip.is_reserved or
            ip.is_multicast or
            ip.is_unspecified
        )
    except ValueError:
        return False


def _get_client_ip(environ):
    remote = environ.get("REMOTE_ADDR", "")
    if not _is_cloudflare_ip(remote):
        return remote
    cf_ip = environ.get("HTTP_CF_CONNECTING_IP", "").strip()
    if cf_ip and _is_valid_public_ip(cf_ip):
        return cf_ip
    return remote

def _get_request_country(environ):
    if not _is_cloudflare_ip(environ.get("REMOTE_ADDR", "")):
        return ""
    country = environ.get("HTTP_CF_IPCOUNTRY")
    country = str(country or "").strip().upper()
    if not country or country in ("XX", "T1", "UNKNOWN"):
        return ""
    if len(country) == 2 and country.isalpha():
        return country
    return ""



class InfraveilSecurityMiddleware:
    def __init__(self, app):
        self.app = app

    def __call__(self, environ, start_response):
        policy = _gateway_security_snapshot()
        ip = _get_client_ip(environ)
        country = _get_request_country(environ)
        path = environ.get("PATH_INFO", "/") or "/"
        query = environ.get("QUERY_STRING", "")
        path_query = path + (("?" + query) if query else "")
        method = str(environ.get("REQUEST_METHOD", "GET") or "GET").upper()
        ua = str(environ.get("HTTP_USER_AGENT", "") or "")
        headers = {}
        for key, value in environ.items():
            if key.startswith("HTTP_") and key not in ("HTTP_HOST", "HTTP_CONNECTION"):
                headers[key[5:].replace("_", "-").title()] = str(value)[:1000]
        if environ.get("CONTENT_TYPE"):
            headers["Content-Type"] = str(environ.get("CONTENT_TYPE"))[:160]

        max_body = _safe_int(policy.get("max_body_bytes", 262144), 262144, 0, 100 * 1024 * 1024)
        declared_length = _safe_int(environ.get("CONTENT_LENGTH", 0), 0, 0, 10 * 1024 * 1024 * 1024)
        body = b""
        if declared_length <= max_body:
            try:
                read_size = declared_length if declared_length > 0 else max_body + 1
                if read_size > 0:
                    body = environ["wsgi.input"].read(read_size)
                    if declared_length <= 0 and len(body) <= max_body:
                        remainder = environ["wsgi.input"].read(1)
                        if remainder:
                            body += remainder
                environ["wsgi.input"] = io.BytesIO(body)
            except Exception as exc:
                _write_boot_log(f"[WAF_BODY_READ_ERROR] {exc}")
                body = b""
        body_too_large = declared_length > max_body or len(body) > max_body
        content_length = declared_length or len(body)
        body_hash = hashlib.sha256(body).hexdigest() if body else ""
        compiled = policy.get("compiled_waf") if isinstance(policy.get("compiled_waf"), dict) else {}
        inspection = compiled.get("inspection") if isinstance(compiled.get("inspection"), dict) else {}
        inspect_limit = _safe_int(inspection.get("inspect_body_bytes", max_body), max_body, 0, max_body)
        inspected = body[:inspect_limit]
        if content_length <= 0:
            inspection_state = "not_applicable"
        elif body and len(body) == content_length and content_length <= inspect_limit:
            inspection_state = "fully_inspected"
        elif body:
            inspection_state = "partially_inspected"
        else:
            inspection_state = "not_inspected"
        body_text = inspected.decode("utf-8", errors="replace")

        decision, status, decision_body, decision_type, ctx = _gateway_security_decision(
            method, path_query, ip, country, ua, headers, content_length,
            body_text=body_text, body_hash=body_hash, body_inspection=inspection_state, policy=policy,
        )

        def report(status_code):
            ctx["upstream_status"] = int(status_code or 0)
            ctx["response_status"] = int(status_code or ctx.get("response_status") or 0)
            _report_network_event(
                ip, method, path, environ, body_preview=body_text,
                telemetry=_finalize_pipeline_reporting(ctx),
                body_size=content_length, body_hash=body_hash,
                body_inspection=inspection_state,
                content_type=headers.get("Content-Type", ""),
            )

        if body_too_large:
            decision = "block"
            status = 413
            decision_body = b"Request body too large"
            decision_type = "text/plain"
            ctx["decision"] = "block"
            ctx["decision_reason"] = "body_too_large"
            ctx["response_status"] = 413

        if decision != "allow":
            delay = min(120.0, max(0.0, float(ctx.get("tarpit_delay", 0) or 0)))
            if delay:
                time.sleep(delay)
            report(status)
            response_headers = [("Content-Type", decision_type)]
            if status == 429:
                response_headers.append(("Retry-After", str(max(1, int(ctx.get("retry_after", 1) or 1)))))
            start_response(_proxy_status_line(status), response_headers)
            return [decision_body]

        captured = {"status": 200}
        def capture_start_response(status_line, response_headers, exc_info=None):
            try:
                captured["status"] = int(str(status_line).split(" ", 1)[0])
            except Exception:
                captured["status"] = 500
            if exc_info is None:
                return start_response(status_line, response_headers)
            return start_response(status_line, response_headers, exc_info)

        try:
            response = self.app(environ, capture_start_response)
            report(captured["status"])
            return response
        except Exception:
            ctx["decision_reason"] = "upstream_exception"
            report(500)
            raise
"""Workload service planning with explicit identity and host-tool interfaces.

Importing this module creates no paths, processes, sockets or workers. The
standalone composition root supplies current identity and installed root paths.
The planner preserves the existing manifest, environment and argv contracts.
"""
import os as _service_plan_os
import re as _service_plan_re
import shlex as _service_plan_shlex
import shutil as _service_plan_shutil
import subprocess as _service_plan_subprocess
import sys as _service_plan_sys
import time as _service_plan_time

# Match the control plane's managed-source envelope. A generated package can
# contain the manifest twice, so allow 80 MiB across extracted entries.
MAX_WORKLOAD_ARCHIVE_ENTRIES = 2050
MAX_WORKLOAD_EXTRACTED_BYTES = 80 * 1024 * 1024


class AgentServiceLaunchPlanner:
    def __init__(self, *, identity, agent_root, report_log,
                 python_executable=lambda: _service_plan_sys.executable,
                 filesystem=_service_plan_os, arguments=_service_plan_shlex,
                 which=_service_plan_shutil.which,
                 windows_command_line=_service_plan_subprocess.list2cmdline,
                 now=_service_plan_time.time):
        self.identity = identity
        self.agent_root = agent_root
        self.report_log = report_log
        self.python_executable = python_executable
        self.os = filesystem
        self.arguments = arguments
        self.which = which
        self.windows_command_line = windows_command_line
        self.now = now
        self.unit_pattern = _service_plan_re.compile(r"^[A-Za-z0-9_.@-]{1,128}\.service$")

    def extract_package(self, z, dest):
        base = self.os.path.abspath(dest)
        entries = z.infolist()
        if len(entries) > MAX_WORKLOAD_ARCHIVE_ENTRIES:
            raise RuntimeError('Workload package exceeds the entry safety limit')
        expanded = 0
        for info in entries:
            expanded += info.file_size
            if expanded > MAX_WORKLOAD_EXTRACTED_BYTES:
                raise RuntimeError('Workload package exceeds the extracted-size safety limit')
            member = info.filename
            normalized = member.replace('\\', '/')
            if normalized.startswith('/') or normalized.startswith('../') or '/../' in normalized or (normalized == '..') or (':' in normalized) or ('\x00' in normalized):
                raise RuntimeError(f'Unsafe payload path rejected: {member}')
            mode = info.external_attr >> 16 & 61440
            if mode == 40960:
                raise RuntimeError(f'Unsafe payload symlink rejected: {member}')
            target = self.os.path.abspath(self.os.path.join(base, member))
            if not target.startswith(base + self.os.sep) and target != base:
                raise RuntimeError(f'Unsafe payload path rejected: {member}')
        self.os.makedirs(base, exist_ok=True)
        z.extractall(base)

    def is_within(self, base, path):
        try:
            base_abs = self.os.path.abspath(base)
            path_abs = self.os.path.abspath(path)
            return self.os.path.commonpath([base_abs, path_abs]) == base_abs
        except Exception:
            return False

    def environment(self, manifest):
        env = self.os.environ.copy()
        manifest_env = manifest.get('env') if isinstance(manifest.get('env'), dict) else {}
        for k, v in manifest_env.items():
            if isinstance(v, str) and v.startswith('infraveil:secret:'):
                continue
            if str(k).upper().startswith('INFRAVEIL_'):
                continue
            env[str(k)] = str(v)
        env['INFRAVEIL_CLIENT_ID'] = self.identity()[0]
        env['INFRAVEIL_AGENT_ID'] = self.identity()[1]
        env['INFRAVEIL_LAUNCHER_HOST_ID'] = self.identity()[2]
        env['INFRAVEIL_RUNTIME_OWNER'] = 'agent'
        env['PYTHONUNBUFFERED'] = '1'
        env.setdefault('PYTHONIOENCODING', 'utf-8')
        cache_root = self.os.path.join(self.agent_root(), 'runtime_cache')
        xdg_cache = self.os.path.join(cache_root, 'xdg')
        npm_cache = self.os.path.join(cache_root, 'npm')
        pip_cache = self.os.path.join(cache_root, 'pip')
        for path in (xdg_cache, npm_cache, pip_cache):
            try:
                self.os.makedirs(path, exist_ok=True)
            except Exception:
                pass
        env.setdefault('XDG_CACHE_HOME', xdg_cache)
        env.setdefault('npm_config_cache', npm_cache)
        env.setdefault('NPM_CONFIG_CACHE', npm_cache)
        env.setdefault('PIP_CACHE_DIR', pip_cache)
        return env

    def manifest_summary(self, manifest):
        services = manifest.get('services') if isinstance(manifest.get('services'), list) else []
        routes = manifest.get('routes') if isinstance(manifest.get('routes'), list) else []
        gateway = manifest.get('gateway') if isinstance(manifest.get('gateway'), dict) else {}
        return {'version': manifest.get('version', 1), 'mode': str(manifest.get('mode') or 'process'), 'service_count': len(services), 'services': [{'name': str(svc.get('name') or 'service'), 'runtime': str(svc.get('runtime') or 'python'), 'manager': str(svc.get('manager') or 'agent'), 'unit': str(svc.get('unit') or ''), 'has_install': bool(svc.get('install')), 'has_build': bool(svc.get('build')), 'has_health': bool(svc.get('health')), 'port': svc.get('port'), 'restart': str(svc.get('restart', 'always'))} for svc in services if isinstance(svc, dict)][:20], 'route_count': len(routes), 'routes': [{'path': str(route.get('path') or ''), 'service': str(route.get('service') or '')} for route in routes if isinstance(route, dict)][:30], 'gateway_enabled': gateway.get('enabled', True) is not False, 'gateway_listen': gateway.get('listen') or manifest.get('listen'), 'persistent_path_count': len(manifest.get('persistent_paths') or []) if isinstance(manifest.get('persistent_paths'), list) else 0, 'volume_count': len(manifest.get('volumes') or []) if isinstance(manifest.get('volumes'), list) else 0}

    def merge_environment(self, base_env, service_env):
