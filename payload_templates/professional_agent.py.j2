class AgentServiceSupervisor:
    """Own the current restart-window and health transitions, not OS policy."""
    def __init__(self, state, effects, policy):
        self._state = state
        self._effects = effects
        self._policy = policy

    def _watch_service_process(self, name, runtime, proc, generation):
        try:
            code = proc.wait()
            if self._state.process(name) is proc:
                self._state.discard_process(name)
            intentional_shutdown = self._state.shutdown() or generation != self._state.generation()
            expected_signal_exit = code in (-9, -15)
            level = "info" if code == 0 or (intentional_shutdown and expected_signal_exit) else "error"
            phase = "shutdown" if intentional_shutdown and expected_signal_exit else "exit"
            message = "Process stopped during controlled shutdown" if intentional_shutdown and expected_signal_exit else f"Process exited with code {code}"
            self._effects.report_log("[PROCESS_EVENT] " + json.dumps({
                "service": name,
                "runtime": runtime,
                "stream": "process",
                "level": level,
                "message": message,
                "process_exit_code": code,
                "phase": phase,
                "recent_output": self._state.output_tail(name)[-6:]
            }, separators=(",", ":")))
            spec = self._state.service_spec(name)
            if generation != self._state.generation():
                return
            if spec and not self._state.shutdown() and spec.get("restart", "always") not in ("never", "no", "false"):
                now = self._effects.now()
                window = [ts for ts in self._state.restart_stamps(name) if now - ts < self._policy.restart_window_seconds()]
                window.append(now)
                self._state.put_restart_stamps(name, window)
                count = len(window)
                self._state.put_restart_count(name, count)
                self._effects.persist_recovery()
                if count > self._policy.restart_max_attempts():
                    self._effects.record_failure(RuntimeError(f"Service {name} exhausted its restart budget ({self._policy.restart_max_attempts()} retries in {self._policy.restart_window_seconds()}s)."), component="service:" + name, terminal=True)
                    self._effects.report_exception(
                        f"Traceback (most recent call last):\n  File \"<service-supervisor>\", line 0, in watch\nRuntimeError: Service {name} exceeded restart budget ({count} restarts in window).",
                        label="[SERVICE_CRASH_LOOP]"
                    )
                    # Keep the managed runtime and gateway in place. Clearing the
                    # payload here makes main() refetch it and reset this budget,
                    # turning a stopped crash loop into unlimited fresh attempts.
                    return
                delay = min(30, 2 * count)
                self._effects.report_log("[PROCESS_EVENT] " + json.dumps({
                    "service": name,
                    "runtime": runtime,
                    "stream": "process",
                    "level": "warn",
                    "message": f"Restarting service after exit code {code} in {delay}s",
                    "process_exit_code": code,
                    "phase": "restart",
                    "restart_count": count,
                    "recent_output": self._state.output_tail(name)[-6:]
                }, separators=(",", ":")))
                self._effects.sleep(delay)
                if generation == self._state.generation() and not self._state.shutdown():
                    self._effects.start_service(name, runtime, spec["start"], spec["cwd"], spec["env"])
        except Exception:
            pass

    def _service_health_url(self, spec):
        if not isinstance(spec, dict):
            return ""
        health_path = str(spec.get("health") or "").strip()
        port = spec.get("port")
        if not health_path or not port:
            return ""
        if not health_path.startswith("/"):
            health_path = "/" + health_path
        return f"http://127.0.0.1:{int(port)}{health_path}"

    def _service_is_healthy(self, spec):
        url = self._effects.health_url(spec)
        if not url:
            return True, "no-healthcheck"
        try:
            response = self._effects.http_get(url, timeout=(self._policy.http_connect_timeout(), min(5, self._policy.http_read_timeout())))
            if 200 <= response.status_code < 400:
                return True, str(response.status_code)
            return False, f"http:{response.status_code}"
        except Exception as exc:
            return False, str(exc)

    def _service_health_observed(self, name):
        spec = self._state.health_spec(name) or {}
        if not self._effects.health_url(spec):
            return True
        observed = float(self._state.health_observed(name) or 0)
        return observed > 0 and observed >= float(spec.get("started_at", 0) or 0) and 0 <= self._effects.now() - observed <= max(30, self._policy.health_interval_seconds() * 3)

    def _health_monitor_loop(self, generation):
        while not self._state.shutdown() and generation == self._state.generation():
            self._effects.sweep_security()
            for name, spec in list(self._state.health_items()):
                proc = self._state.process(name)
                external = self._state.is_external(name)
                if not external and (proc is None or proc.poll() is not None):
                    continue
                started_at = float(spec.get("started_at") or 0)
                if started_at and self._effects.now() - started_at < max(15, self._policy.health_interval_seconds() * 2):
                    continue
                if external:
                    status = self._effects.external_status(spec)
                    healthy = bool(status.get("healthy"))
                    reason = f"systemd:{status.get('active_state')}/{status.get('sub_state')} health:{status.get('health_reason')}"
                else:
                    healthy, reason = self._effects.health_probe(spec)
                if healthy:
                    self._state.put_health_observed(name, self._effects.now())
                    self._state.put_health_failure(name, 0)
                    continue
                self._state.put_health_observed(name, 0.0)
                count = int(self._state.health_failure(name) or 0) + 1
                self._state.put_health_failure(name, count)
                self._effects.report_log("[PROCESS_EVENT] " + json.dumps({
                    "service": name,
                    "stream": "health",
                    "level": "warn",
                    "message": f"Health check failed ({count}/{self._policy.health_max_failures()}): {reason}",
                    "phase": "health"
                }, separators=(",", ":")))
                if count >= self._policy.health_max_failures() and external:
                    if count == self._policy.health_max_failures():
                        self._effects.report_log("[PROCESS_EVENT] " + json.dumps({
                            "service": name,
                            "stream": "health",
                            "level": "error",
                            "message": "External service health threshold exceeded; observation continues without automatic restart",
                            "phase": "external-health"
                        }, separators=(",", ":")))
                    continue
                if count >= self._policy.health_max_failures():
                    self._effects.report_log("[PROCESS_EVENT] " + json.dumps({
                        "service": name,
                        "stream": "health",
                        "level": "error",
                        "message": "Health check threshold exceeded; recycling service process",
                        "phase": "health-restart"
                    }, separators=(",", ":")))
                    try:
                        proc.kill()
                    except Exception:
                        pass
            self._effects.sleep(self._policy.health_interval_seconds())
"""Durable journal pending/ACK/cursor transaction; inlined into the standalone agent.

Inert explicit ports preserve predecessor ordering, including uncertainty after a
rename or deletion. JSON parsing retains the predecessor unbounded json.load.
No journal follower, retry policy, process ownership or installation authority.
"""
import json


class AgentJournalCheckpointState:
    """Per-name late state access; no whole-runtime namespace."""
    def __init__(self, *, health):
        self.health = health


class AgentJournalCheckpointEffects:
    """Only named existing effects; constructing ports performs no work."""
    def __init__(self, *, os_name, directory_sync_supported, directory_flag, readonly_flag, writeonly_flag, create_flag, exclusive_flag, dirname, abspath, open_descriptor, close_descriptor, fsync, fdopen, replace, remove, exists, isfile, open_text, unique_suffix, now, signed_post_json, record_delivery_observation, sync_directory, atomic_write):
        self.os_name = os_name
        self.directory_sync_supported = directory_sync_supported
        self.directory_flag = directory_flag
        self.readonly_flag = readonly_flag
        self.writeonly_flag = writeonly_flag
        self.create_flag = create_flag
        self.exclusive_flag = exclusive_flag
        self.dirname = dirname
        self.abspath = abspath
        self.open_descriptor = open_descriptor
        self.close_descriptor = close_descriptor
        self.fsync = fsync
        self.fdopen = fdopen
        self.replace = replace
        self.remove = remove
        self.exists = exists
        self.isfile = isfile
        self.open_text = open_text
        self.unique_suffix = unique_suffix
        self.now = now
        self.signed_post_json = signed_post_json
        self.record_delivery_observation = record_delivery_observation
        self.sync_directory = sync_directory
        self.atomic_write = atomic_write


class AgentJournalCheckpoint:
    def __init__(self, state, effects):
        self._state = state
        self._effects = effects

    def _journal_sync_directory(self, path):
        if self._effects.os_name() != "posix" or not self._effects.directory_sync_supported():
            return
        directory_fd = self._effects.open_descriptor(self._effects.dirname(self._effects.abspath(path)), self._effects.readonly_flag() | self._effects.directory_flag())
        try:
            self._effects.fsync(directory_fd)
        finally:
            self._effects.close_descriptor(directory_fd)


    def _journal_atomic_write(self, path, data):
        # Journal checkpoints require durable acknowledgement ordering; generic
        # best-effort cache writes intentionally retain their separate behavior.
        tmp_path = path + "." + self._effects.unique_suffix() + ".tmp"
        fd = self._effects.open_descriptor(tmp_path, self._effects.writeonly_flag() | self._effects.create_flag() | self._effects.exclusive_flag(), 0o600)
        try:
            with self._effects.fdopen(fd, "wb") as checkpoint:
                checkpoint.write(data)
                checkpoint.flush()
                self._effects.fsync(checkpoint.fileno())
            self._effects.replace(tmp_path, path)
            self._effects.sync_directory(path)
        finally:
            if self._effects.exists(tmp_path):
                self._effects.remove(tmp_path)


    def _ack_journal_pending(self, name, pending_path, cursor_path):
        if not self._effects.isfile(pending_path):
            return
        # A previous atomic rename may have succeeded just before directory fsync
        # failed. Require that directory barrier again before delivering its record.
        self._effects.sync_directory(pending_path)
        with self._effects.open_text(pending_path, encoding="utf-8") as pending_file:
            pending = json.load(pending_file)
        if not isinstance(pending, dict) or not isinstance(pending.get("payload"), dict) or not pending.get("cursor"):
            raise ValueError("Invalid bounded journal pending record")
        state = self._state.health(name)
        state["pending_since"] = float(pending.get("at") or self._effects.now())
        # One durable record per follower bounds memory/disk and preserves the first
        # unacknowledged record across queue pressure, reconnect and agent crashes.
        try:
            response = self._effects.signed_post_json("/agent/log", pending["payload"], timeout=10)
        except Exception:
            self._effects.record_delivery_observation(False)
            raise
        if not 200 <= int(getattr(response, "status_code", 0) or 0) < 300:
            self._effects.record_delivery_observation(False)
            raise RuntimeError("Journal ingestion rejected")
        self._effects.record_delivery_observation(True)
        # ACK precedes cursor persistence. A crash between these operations replays
        # the same deterministic event_id, which the server deduplicates.
        self._effects.atomic_write(cursor_path, str(pending["cursor"]).encode("utf-8"))
        self._effects.remove(pending_path)
        self._effects.sync_directory(pending_path)
        state["last_ack_ts"] = self._effects.now()
        state["pending_since"] = 0
