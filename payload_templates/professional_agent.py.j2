def _validate_base_url():
    try:
        parsed = urllib.parse.urlparse(BASE_URL)
        host = (parsed.hostname or "").lower()
        if parsed.scheme == "https":
            return
        if parsed.scheme == "http" and host in ("127.0.0.1", "localhost", "::1"):
            return
    except Exception:
        pass
    _write_boot_log("[BOOTSTRAP] Refusing non-HTTPS control-plane URL outside localhost.")
    raise SystemExit("Infraveil agent requires HTTPS control-plane traffic outside localhost.")

_validate_base_url()

class StreamCatcher:
    def __init__(self, prefix=""):
        self.prefix = prefix
        self.buf = ""

    def write(self, t):
        self.buf += str(t)
        if chr(10) in self.buf:
            lines = self.buf.split(chr(10))
            for line in lines[:-1]:
                if line.strip():
                    try:
                        report_log(_normalize_runtime_log_line(self.prefix, line.strip()))
                    except Exception:
                        report_log(self.prefix + line.strip())
            self.buf = lines[-1]

    def flush(self): pass

def _normalize_runtime_log_line(prefix, line):
    text = _redact_runtime_log_message(line).strip()
    if not text:
        return "[PROCESS_EVENT] " + json.dumps({"level": "info", "stream": "stdout" if prefix == "[INFO] " else "stderr", "message": text})
    stream_label = "stderr" if prefix == "[ERROR] " else "stdout"
    clean = re.sub(r"\x1b\[[0-9;]*m", "", text)
    upper = clean.upper().lstrip()
    level = None
    for keyword in ("FATAL", "CRITICAL", "ERROR", "WARN", "WARNING", "INFO", "DEBUG", "TRACE"):
        if upper.startswith(keyword):
            level = keyword.lower().replace("warning", "warn")
            break
    if level is None:
        m = re.match(r"\[(ERROR|WARN|WARNING|INFO|DEBUG|TRACE|FATAL|CRITICAL)\]", upper)
        if m:
            level = m.group(1).lower().replace("warning", "warn")
    if level is None:
        level = stream_label
    return "[PROCESS_EVENT] " + json.dumps({"realm": "runtime", "level": level, "stream": stream_label, "message": text}, separators=(",", ":"))

def _bounded_agent_log(message, limit=2048):
    text = str(message or "")
    if len(text) <= limit:
        return text
    prefix = "[PROCESS_EVENT] "
    if not text.startswith(prefix):
        return text[:limit]
    try:
        event = json.loads(text[len(prefix):].strip())
    except Exception:
        return text[:limit]
    if not isinstance(event, dict):
        return text[:limit]

    original_message = str(event.get("message") or "")
    event["message"] = ""
    event["truncated"] = True
    event["original_message_length"] = len(original_message)
    if isinstance(event.get("recent_output"), list):
        event["recent_output"] = event["recent_output"][-2:]
        for item in event["recent_output"]:
            if isinstance(item, dict) and "message" in item:
                item["message"] = str(item.get("message") or "")[:200]

    def render():
        return prefix + json.dumps(event, separators=(",", ":"))

    rendered = render()
    if len(rendered) > limit:
        event.pop("recent_output", None)
        rendered = render()
    available = max(0, limit - len(rendered))
    event["message"] = original_message[:available]
    rendered = render()
    while len(rendered) > limit and event["message"]:
        event["message"] = event["message"][:-(len(rendered) - limit)]
        rendered = render()
    if len(rendered) <= limit:
        return rendered
    return prefix + json.dumps({
        "service": str(event.get("service") or "application")[:120],
        "stream": str(event.get("stream") or "process")[:32],
        "level": str(event.get("level") or "info")[:32],
        "message": "log entry exceeded structured telemetry limit",
        "truncated": True,
        "original_message_length": len(original_message),
    }, separators=(",", ":"))

def report_log(msg):
    safe_msg = _redact_runtime_log_message(msg)
    _write_boot_log(safe_msg)
    try:
        _enqueue_event_post("/agent/log", {
            "client_id": CLIENT_ID,
            "agent_id": AGENT_ID,
            "log": _bounded_agent_log(safe_msg),
        })
    except Exception:
        pass

def _atomic_write_bytes(path, data):
    tmp_path = f"{path}.tmp"
    with open(tmp_path, "wb") as f:
        f.write(data)
        f.flush()
        try:
            os.fsync(f.fileno())
        except Exception:
            pass
    os.replace(tmp_path, path)
    try:
        os.chmod(path, 0o600)
    except Exception:
        pass

def _atomic_write_json(path, payload):
    data = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode("utf-8")
    _atomic_write_bytes(path, data)

def _load_cache_purge_state():
    global _pending_cache_purge_ack, _completed_cache_purge_request_id
    _pending_cache_purge_ack = {}
    _completed_cache_purge_request_id = ""
    try:
        if not os.path.isfile(CACHE_PURGE_STATE):
            return
        with open(CACHE_PURGE_STATE, "r", encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, dict):
            return
        ack = data.get("pending_cache_purge_ack")
        if (
            isinstance(ack, dict)
            and isinstance(ack.get("request_id"), str)
            and ack.get("request_id").strip()
            and ack.get("status") == "succeeded"
        ):
            _pending_cache_purge_ack = {
                "request_id": ack["request_id"].strip(),
                "status": "succeeded",
            }
        completed_id = data.get("completed_cache_purge_request_id")
        if isinstance(completed_id, str):
            _completed_cache_purge_request_id = completed_id.strip()
    except Exception:
        _pending_cache_purge_ack = {}
        _completed_cache_purge_request_id = ""

def _persist_cache_purge_state():
    try:
        _atomic_write_json(CACHE_PURGE_STATE, {
            "pending_cache_purge_ack": _pending_cache_purge_ack,
            "completed_cache_purge_request_id": _completed_cache_purge_request_id,
            "updated_at": time.time(),
        })
        return True
    except Exception:
        return False

_load_cache_purge_state()

PAYLOAD_CACHE_MAGIC = b"INFV_PAYLOAD_CACHE_V1:"

def _encrypt_payload_cache_bytes(data):
    aes = AESGCM(bytes.fromhex(ENCRYPTION_KEY))
    nonce = os.urandom(12)
    return PAYLOAD_CACHE_MAGIC + nonce + aes.encrypt(nonce, data, None)

def _decrypt_payload_cache_bytes(data):
    if not data:
        return None
    if data.startswith(PAYLOAD_CACHE_MAGIC):
        body = data[len(PAYLOAD_CACHE_MAGIC):]
        if len(body) <= 12:
            return None
        aes = AESGCM(bytes.fromhex(ENCRYPTION_KEY))
        return aes.decrypt(body[:12], body[12:], None)
    return None

def _read_payload_cache_file(path):
    try:
        with open(path, "rb") as f:
            raw = f.read()
        return _decrypt_payload_cache_bytes(raw)
    except Exception:
        return None

def _load_payload_meta():
    if os.path.isfile(PAYLOAD_META):
        try:
            with open(PAYLOAD_META, "r", encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    return data
            raise ValueError("payload cache metadata root is not an object")
        except Exception as exc:
            _write_boot_log(f"[PAYLOAD_CACHE] metadata read failed: {exc}")
            raise RuntimeError("payload cache metadata is unreadable; refusing to overwrite rollback history") from exc
    return {}

def _record_cached_payload_version(zip_bytes, payload_hash, vendor_sig="", approval_sig=""):
    if not payload_hash:
        return
    os.makedirs(PAYLOAD_VERSION_DIR, exist_ok=True)
    version_path = os.path.join(PAYLOAD_VERSION_DIR, f"{payload_hash}.bin")
    if not os.path.isfile(version_path):
        _atomic_write_bytes(version_path, _encrypt_payload_cache_bytes(zip_bytes))
    meta = _load_payload_meta()
    history = meta.get("history") if isinstance(meta.get("history"), list) else []
    was_promoted = any(
        isinstance(item, dict)
        and item.get("payload_hash") == payload_hash
        and item.get("promoted") is not False
        for item in history
    )
    history = [item for item in history if isinstance(item, dict) and item.get("payload_hash") != payload_hash]
    history.insert(0, {
        "payload_hash": payload_hash,
        "cached_at": time.time(),
        "path": version_path,
        "vendor_sig": vendor_sig,
        "approval_sig": approval_sig,
        "promoted": was_promoted,
    })
    meta["payload_hash"] = payload_hash
    meta["cached_at"] = time.time()
    retained_history = history[:5]
    promoted = next((item for item in history if isinstance(item, dict) and item.get("promoted") is not False), None)
    if promoted and promoted not in retained_history:
        retained_history[-1:] = [promoted]
    meta["history"] = retained_history
    _atomic_write_json(PAYLOAD_META, meta)
    retained = {item.get("payload_hash") for item in meta["history"] if isinstance(item, dict)}
    for fname in os.listdir(PAYLOAD_VERSION_DIR):
        if fname.endswith(".bin") and fname[:-4] not in retained:
            try:
                os.remove(os.path.join(PAYLOAD_VERSION_DIR, fname))
            except Exception:
                pass
    _append_local_audit("payload_cached", payload_hash=payload_hash, cache_versions=len(meta["history"]))

def _cached_payload_verified(cached, item):
    try:
        h = hashlib.sha256(cached).hexdigest()
        if h != str(item.get("payload_hash") or ""):
            return False
        if RELEASE_PUBLIC_KEY and not verify_payload_ed25519(h, str(item.get("vendor_sig") or "")):
            return False
        if CUSTOMER_APPROVAL_KEY and not verify_customer_approval(h, str(item.get("approval_sig") or "")):
            return False
        return True
    except Exception:
        return False

def _load_cached_payload_version():
    meta = _load_payload_meta()
    history = meta.get("history") if isinstance(meta.get("history"), list) else []
    for item in history:
        if not isinstance(item, dict):
            continue
        if item.get("promoted") is False:
            continue
        path = item.get("path")
        if path and os.path.isfile(path):
            cached = _read_payload_cache_file(path)
            if cached and _cached_payload_verified(cached, item):
                return cached, item
            if cached:
                _append_local_audit("cached_payload_rejected", payload_hash=item.get("payload_hash", ""))
    return None, None

def _activate_cached_payload_identity(meta):
    """Make runtime identity describe the exact cached bytes being activated."""
    global _current_payload_hash, _current_payload_vendor_sig, _current_payload_approval_sig
    safe_meta = meta if isinstance(meta, dict) else {}
    _current_payload_hash = str(safe_meta.get("payload_hash", "") or "")
    _current_payload_vendor_sig = str(safe_meta.get("vendor_sig", "") or "")
    _current_payload_approval_sig = str(safe_meta.get("approval_sig", "") or "")

def _cached_payload_meta_for_hash(payload_hash):
    meta = _load_payload_meta()
    history = meta.get("history") if isinstance(meta.get("history"), list) else []
    for item in history:
        if isinstance(item, dict) and hmac.compare_digest(str(item.get("payload_hash") or ""), payload_hash):
            return meta, history, item
    return meta, history, None

def _activate_staged_payload_identity(zip_bytes):
    payload_hash = hashlib.sha256(zip_bytes).hexdigest()
    _meta, _history, candidate_item = _cached_payload_meta_for_hash(payload_hash)
    if candidate_item is None:
        raise RuntimeError("verified payload candidate metadata is missing")
    _activate_cached_payload_identity(candidate_item)
    _append_local_audit("payload_candidate_activated", payload_hash=payload_hash)

def _promote_cached_payload_hash(payload_hash):
    meta, history, promoted_item = _cached_payload_meta_for_hash(payload_hash)
    if promoted_item is None:
        raise RuntimeError("verified payload candidate metadata is missing")
    if promoted_item.get("promoted") is True and meta.get("promoted_payload_hash") == payload_hash:
        return
    promoted_item["promoted"] = True
    promoted_item["promoted_at"] = time.time()
    meta["promoted_payload_hash"] = payload_hash
    meta["history"] = history
    _atomic_write_json(PAYLOAD_META, meta)
    _activate_cached_payload_identity(promoted_item)
    _append_local_audit("payload_cache_promoted", payload_hash=payload_hash)

def _activate_last_known_good_after_candidate_failure(failed_hash=""):
    cached, cached_meta = _load_cached_payload_version()
    if not cached:
        return False
    if failed_hash and hmac.compare_digest(str(cached_meta.get("payload_hash") or ""), failed_hash):
        return False
    _runtime_rejected_hashes.add(str(failed_hash or ""))
    with _runtime_recovery_lock:
        _runtime_recovery.update(phase="repairing", repair_attempted=True,
            component=_runtime_recovery.get("component", "runtime-health"),
            cause=_runtime_recovery.get("cause", "Candidate failed its health gate."),
            attempts=max(1, int(_runtime_recovery.get("attempts", 0))), limit=RUNTIME_RESTART_MAX_ATTEMPTS,
            next_action="Verify healthy evidence from the restored package.",
            repair={"status": "verifying", "action": "verified_known_good"})
    run_payload_package(cached, recovery_repair=True)
    _activate_cached_payload_identity(cached_meta)
    _append_local_audit(
        "payload_candidate_rolled_back",
        failed_hash=failed_hash,
        restored_hash=str(cached_meta.get("payload_hash") or ""),
    )
    return True

def _stop_unrecoverable_payload_candidate(failed_hash=""):
    global _payload_thread, _payload_mode, _gateway_thread
    global _payload_detached_ok, _payload_detached_note, _current_payload_started_at
    global _current_payload_hash, _current_payload_vendor_sig, _current_payload_approval_sig
    global _service_generation
    _service_generation += 1
    _stop_service_processes()
    _runtime_rejected_hashes.add(str(failed_hash or _runtime_package_hash))
    with _runtime_recovery_lock:
        _runtime_recovery.update(phase="blocked", reason="unhealthy_candidate",
            component="runtime-health", cause="The candidate did not pass its 120-second health gate.",
            attempts=max(1, int(_runtime_recovery.get("attempts", 0))), limit=RUNTIME_RESTART_MAX_ATTEMPTS,
            failed_at=time.time(), repair_attempted=True,
            repair={"status": "unavailable", "action": "verified_known_good", "detail": "No different verified known-good package is available."},
            next_action="Correct the failure, then publish a new package or explicitly restart this workload.")
    _persist_runtime_recovery()
    report_error("Runtime stopped: candidate unhealthy; no verified rollback is available. Automatic retries are paused.", label="[RUNTIME_RECOVERY]")
    _payload_thread = "RECOVERY_BLOCKED"
    _payload_mode = "failed"
    _gateway_thread = None
    _payload_detached_ok = False
    _payload_detached_note = ""
    _current_payload_started_at = 0.0
    _current_payload_hash = ""
    _current_payload_vendor_sig = ""
    _current_payload_approval_sig = ""
    _append_local_audit("payload_candidate_stopped_without_lkg", failed_hash=failed_hash)

def _evaluate_runtime_candidate_stability(now=None):
    global _current_payload_started_at
    if _payload_thread in (None, "RECOVERY_BLOCKED") or not _current_payload_started_at or not _current_payload_hash:
        return "inactive"
    if _runtime_recovery.get("phase") == "blocked":
        return "blocked"
    current_time = float(now if now is not None else time.time())
    if current_time - _current_payload_started_at < 120:
        return "pending"
    _meta, _history, current_item = _cached_payload_meta_for_hash(_current_payload_hash)
    if current_item is None or _meta.get("promoted_payload_hash") == _current_payload_hash:
        return "stable"
    failed_candidate_hash = _current_payload_hash
    if not _payload_failures and _runtime_candidate_is_healthy():
        _promote_cached_payload_hash(failed_candidate_hash)
        _current_payload_started_at = current_time
        return "promoted"
    if not _activate_last_known_good_after_candidate_failure(failed_candidate_hash):
        _stop_unrecoverable_payload_candidate(failed_candidate_hash)
        return "stopped"
    if _payload_failures:
        _clear_payload_failures()
    _current_payload_started_at = current_time
    return "rolled-back"

def _set_control_plane_status(online, detail=""):
    global _control_plane_online, _last_control_plane_log_at, _control_plane_backoff
    now = time.time()
    if online:
        if not _control_plane_online:
            report_log(f"[INFO] Control plane connection restored{': ' + detail if detail else ''}")
            _append_local_audit("control_plane_restored", detail=detail)
        _control_plane_online = True
        _control_plane_backoff = 5
        return
    if _control_plane_online or (now - _last_control_plane_log_at) >= 60:
        report_log(f"[WARN] Control plane unavailable{': ' + detail if detail else ''}; keeping local services alive")
        _append_local_audit("control_plane_unavailable", detail=detail, backoff=_control_plane_backoff)
        _last_control_plane_log_at = now
    _control_plane_online = False
    _control_plane_backoff = min(60, max(5, int(_control_plane_backoff * 1.7)))

def _cache_payload(zip_bytes, payload_hash="", vendor_sig="", approval_sig=""):
    _atomic_write_bytes(PAYLOAD_CACHE, _encrypt_payload_cache_bytes(zip_bytes))
    if payload_hash:
        _record_cached_payload_version(zip_bytes, payload_hash, vendor_sig, approval_sig)

def _load_cached_payload():
    if os.path.isfile(PAYLOAD_CACHE):
        cached = _read_payload_cache_file(PAYLOAD_CACHE)
        if cached:
            return cached
    return None

def _purge_local_runtime_cache():
    targets = [
        PAYLOAD_CACHE,
        PAYLOAD_META,
        PAYLOAD_VERSION_DIR,
        os.path.join(_agent_root(), "runtime_cache"),
    ]
    try:
        for target in targets:
            if os.path.isdir(target):
                shutil.rmtree(target)
            elif os.path.exists(target):
                os.remove(target)
        if any(os.path.exists(target) for target in targets):
            return False
        _append_local_audit("agent_runtime_cache_purged")
        return True
    except Exception as exc:
        _append_local_audit("agent_runtime_cache_purge_failed", error=str(exc)[:200])
        return False

def report_error(error_text, send_console=True, label="[AGENT_ERROR]"):
    global _last_error_fingerprint, _last_error_sent_at
    text = _redact_runtime_log_message(error_text).strip()
    if not text:
        return
    fingerprint = text[-2048:]
    now = time.time()
    if fingerprint == _last_error_fingerprint and (now - _last_error_sent_at) < 30:
        return
    _last_error_fingerprint = fingerprint
    _last_error_sent_at = now
    msg = f"{label} {text}"
    _write_boot_log(msg)
    _append_local_audit("agent_error", label=label, fingerprint=hashlib.sha256(fingerprint.encode("utf-8", errors="ignore")).hexdigest())
    try:
        if send_console:
            _signed_post_json("/agent/log", {"client_id": CLIENT_ID, "agent_id": AGENT_ID, "log": msg[:2048]}, timeout=10)
    except Exception:
        pass
    try:
        _signed_post_json("/report", {"client_id": CLIENT_ID, "agent_id": AGENT_ID, "error": text[:20000]}, timeout=10)
    except Exception:
        pass

def report_exception(error_text, label="[TRACEBACK]"):
    text = str(error_text).strip()
    if not text:
        return
    # Put the exception, not the uninformative traceback header, in collapsed
    # rows. Retain the complete redacted traceback in the same evidence event.
    cause = next((line.strip() for line in reversed(text.splitlines()) if line.strip()), text)
    report_log(f"{label} {cause}\n{text}" if "\n" in text else f"{label} {text}")
    report_error(text, send_console=False, label=label)


def _persist_runtime_recovery():
    with _runtime_recovery_lock:
        _atomic_write_json(RUNTIME_RECOVERY_STATE, {"package_hash": _runtime_package_hash,
            "recovery": dict(_runtime_recovery), "rejected_hashes": sorted(_runtime_rejected_hashes)[-32:],
            "service_restart_windows": dict(_service_restart_windows),
            "retry_id": _runtime_retry_id})


def _restore_runtime_recovery():
    """Agent/launcher restarts do not reset a failed workload's budget."""
    global _runtime_package_hash, _runtime_retry_id, _payload_thread, _payload_mode
    if os.path.isfile(RUNTIME_RECOVERY_STATE):
        with open(RUNTIME_RECOVERY_STATE, encoding="utf-8") as source:
            state = json.load(source)
        _runtime_package_hash = str(state.get("package_hash") or "")
        _runtime_recovery.update(state.get("recovery") or {})
        _runtime_rejected_hashes.update(state.get("rejected_hashes") or [])
        _runtime_retry_id = str(state.get("retry_id") or "")
        _service_restart_windows.update({name: [ts for ts in stamps if time.time() - float(ts) < SERVICE_RESTART_WINDOW_SECONDS]
            for name, stamps in (state.get("service_restart_windows") or {}).items()})
        _service_restart_counts.update({name: len(stamps) for name, stamps in _service_restart_windows.items()})
    retry_id = os.environ.get("INFRAVEIL_RUNTIME_RETRY_ID", "")
    if retry_id and retry_id != _runtime_retry_id:
        _runtime_retry_id = retry_id
        _runtime_recovery.clear()
        _runtime_rejected_hashes.clear()
        _service_restart_windows.clear()
        _service_restart_counts.clear()
        _persist_runtime_recovery()
        _append_local_audit("runtime_retry_authorized", command_id=retry_id)
    elif _runtime_recovery.get("phase") == "blocked":
        _payload_thread = "RECOVERY_BLOCKED"
        _payload_mode = "failed"
    elif _runtime_recovery.get("phase") == "repairing":
        _runtime_recovery.update(phase="blocked", next_action="Recovery was interrupted. Inspect the failure, then explicitly restart this workload.")
        _payload_thread = "RECOVERY_BLOCKED"
        _payload_mode = "failed"
        _persist_runtime_recovery()


def _record_runtime_failure(error, component="gateway", terminal=False):
    """One budget for the runtime, outside per-service/redeployment resets."""
    with _runtime_recovery_lock:
        previous = dict(_runtime_recovery)
        if previous.get("phase") == "blocked":
            return previous
        count = int(previous.get("attempts", 0)) + 1
        if terminal or (previous.get("phase") == "repairing" and previous.get("repair_attempted")):
            count = max(count, RUNTIME_RESTART_MAX_ATTEMPTS)
        cause = _redact_runtime_log_message(str(error)).strip()[-1000:]
        port_conflict = isinstance(error, OSError) and getattr(error, "errno", None) in {48, 98, 10048}
        port_conflict = port_conflict or "address already in use" in cause.lower()
        blocked = port_conflict or count >= RUNTIME_RESTART_MAX_ATTEMPTS
        _runtime_recovery.update({
            "component": component, "cause": cause, "attempts": count,
            "limit": RUNTIME_RESTART_MAX_ATTEMPTS, "failed_at": time.time(),
            "phase": "blocked" if blocked else "retrying",
            "reason": "port_conflict" if port_conflict else "restart_limit" if blocked else "runtime_failure",
            "next_action": "A fixed port is occupied. Free it or publish a corrected port contract, then explicitly restart; the existing listener was not stopped."
                if port_conflict else "Inspect the failure and retry deliberately after correcting its cause."
                if blocked else "Retry the same verified runtime with bounded backoff.",
            "repair": {"status": "blocked", "action": "port_conflict_diagnosis", "detail": "Changing ports or stopping another process requires an explicit operator change."}
                if port_conflict else {"status": "failed", "action": "verified_known_good", "detail": "The restored package also failed; automatic recovery is stopped."}
                if blocked and previous.get("repair_attempted") else previous.get("repair", {"status": "pending", "action": "verified_runtime_recovery"}),
        })
        snapshot = dict(_runtime_recovery)
        if blocked:
            _runtime_rejected_hashes.add(_runtime_package_hash)
    _append_local_audit("runtime_recovery", **snapshot)
    _persist_runtime_recovery()
    report_error(f"{component} failed: {cause}. Attempt {count}/{RUNTIME_RESTART_MAX_ATTEMPTS}. {snapshot['next_action']}", label="[RUNTIME_RECOVERY]")
    return snapshot


def _recover_managed_runtime():
    """Never kill an unrelated listener or alter a signed runtime contract."""
    global _payload_thread, _payload_mode, _payload_detached_ok, _payload_detached_note, _service_generation
    with _runtime_recovery_lock:
        state = dict(_runtime_recovery)
    if not state:
        state = _record_runtime_failure(RuntimeError("Managed gateway stopped without a reported exception"))
    _payload_detached_ok = False
    _payload_detached_note = str(state.get("cause") or "Runtime failed")
    if state.get("phase") == "blocked":
        # A different, already verified/promoted package is the only automatic
        # repair after retry exhaustion. Port collisions are configuration faults;
        # changing application code cannot safely resolve ownership of that port.
        if state.get("reason") != "port_conflict" and not state.get("repair_attempted"):
            with _runtime_recovery_lock:
                _runtime_recovery["repair_attempted"] = True
                _runtime_recovery["repair"] = {"status": "checking", "action": "verified_known_good"}
            cached, meta = _load_cached_payload_version()
            if cached and str((meta or {}).get("payload_hash") or "") != _runtime_package_hash:
                # Keep the exhausted budget across this one repair; it cannot
                # turn alternating packages into another unbounded restart loop.
                exhausted = dict(_runtime_recovery)
                try:
                    with _runtime_recovery_lock:
                        _runtime_recovery.update(phase="repairing", repair={"status": "verifying", "action": "verified_known_good"})
                    run_payload_package(cached, recovery_repair=True)
                    _activate_cached_payload_identity(meta)
                    report_log("[RUNTIME_RECOVERY] Restored a previously verified package; awaiting fresh healthy evidence.")
                    return "repairing"
                except Exception as exc:
                    with _runtime_recovery_lock:
                        _runtime_recovery.update(exhausted)
                        _runtime_recovery["repair"] = {"status": "failed", "action": "verified_known_good", "detail": _redact_runtime_log_message(str(exc))[:500]}
            else:
                with _runtime_recovery_lock:
                    _runtime_recovery["repair"] = {"status": "unavailable", "action": "verified_known_good", "detail": "No different verified known-good package is available."}
        if _payload_thread != "RECOVERY_BLOCKED":
            _service_generation += 1
            _stop_service_processes()
        _payload_thread = "RECOVERY_BLOCKED"
        _payload_mode = "failed"
        _persist_runtime_recovery()
        return "blocked"
    _payload_thread = None
    _payload_mode = "idle"
    time.sleep(min(30, 5 * max(1, int(state.get("attempts", 1)))))
    return "retrying"

def report_thread_exit_failure(reason="Payload thread exited unexpectedly"):
    text = (
        "Traceback (most recent call last):\n"
        "  File \"<payload-thread>\", line 0, in run\n"
        f"RuntimeError: {reason}. "
        "Infraveil treats all payload thread exits as failure conditions and will attempt recovery."
    )
    report_exception(text, label="[TRACEBACK]")

def _mark_payload_detached(note="payload is continuing via daemonized/background services"):
    global _payload_detached_ok, _payload_detached_note
    _payload_detached_ok = True
    _payload_detached_note = str(note or "payload is continuing via daemonized/background services")

def _has_live_service_processes():
    alive = False
    for proc in list(_service_processes.values()):
        try:
            if proc and proc.poll() is None:
                alive = True
                break
        except Exception:
            continue
    return alive

def _has_live_payload_children():
    try:
        parent = psutil.Process(os.getpid())
        for child in parent.children(recursive=True):
            try:
                if child.is_running() and child.status() != psutil.STATUS_ZOMBIE:
                    return True
            except Exception:
                continue
    except Exception:
        return False
    return False

def _handle_uncaught(exc_type, exc, tb):
    try:
        report_exception("".join(traceback.format_exception(exc_type, exc, tb)), label="[UNCAUGHT]")
    except Exception:
        pass

sys.excepthook = _handle_uncaught

if hasattr(threading, "excepthook"):
    def _thread_excepthook(args):
        try:
            report_exception("".join(traceback.format_exception(args.exc_type, args.exc_value, args.exc_traceback)), label="[THREAD_CRASH]")
        except Exception:
            pass
    threading.excepthook = _thread_excepthook

def decrypt(enc):
    aes = AESGCM(bytes.fromhex(ENCRYPTION_KEY))
    return aes.decrypt(enc[:12], enc[12:], None)

def verify_payload_signature(payload_hash, signature_hex):
    expected = hmac.new(bytes.fromhex(ENCRYPTION_KEY), payload_hash.encode("utf-8"), hashlib.sha256).hexdigest()
    return hmac.compare_digest(expected, (signature_hex or "").strip())

def verify_payload_ed25519(payload_hash, signature_hex):
    if not RELEASE_PUBLIC_KEY:
        return True
    try:
        pub = Ed25519PublicKey.from_public_bytes(bytes.fromhex(RELEASE_PUBLIC_KEY))
        pub.verify(bytes.fromhex((signature_hex or "").strip()), payload_hash.encode("utf-8"))
        return True
    except Exception:
        return False

def verify_customer_approval(payload_hash, signature_hex):
    if not CUSTOMER_APPROVAL_KEY:
        return True
    try:
        pub = Ed25519PublicKey.from_public_bytes(bytes.fromhex(CUSTOMER_APPROVAL_KEY))
        pub.verify(bytes.fromhex((signature_hex or "").strip()), payload_hash.encode("utf-8"))
        return True
    except Exception:
        return False

def verify_response_signature(response, request_nonce, request_path):
    request_nonce = str(request_nonce or "").strip()
    request_path = str(request_path or "").strip()
    if not request_nonce or not request_path:
        raise RuntimeError("Control-plane response signature binding missing")
    version = str(response.headers.get("X-Infraveil-Response-Signature-Version") or "").strip()
    if version != "2":
        raise RuntimeError("Control-plane response signature version invalid")
    timestamp = str(response.headers.get("X-Infraveil-Response-Timestamp") or "").strip()
    signature = str(response.headers.get("X-Infraveil-Response-Signature") or "").strip()
    if not timestamp or not signature:
        raise RuntimeError("Control-plane response missing signature")
    try:
        ts = int(timestamp)
    except Exception:
        raise RuntimeError("Control-plane response has invalid signature timestamp")
    if abs(int(time.time()) - ts) > 300:
        raise RuntimeError("Control-plane response signature expired")
    try:
        status = str(int(response.status_code))
    except Exception:
        raise RuntimeError("Control-plane response has invalid status binding")
    body_hash = hashlib.sha256(response.content or b"").hexdigest()
    canonical = "\n".join([
        "RESPONSE",
        timestamp,
        request_nonce,
        request_path,
        status,
        body_hash,
    ])
    expected = hmac.new(TOKEN.encode("utf-8"), canonical.encode("utf-8"), hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected, signature):
        raise RuntimeError("Control-plane response signature invalid")

def _signed_headers(method, path, params=None, body_bytes=b""):
    timestamp = str(int(time.time()))
    nonce = uuid.uuid4().hex
    params = params or {}
    pairs = []
    for key in sorted(params.keys()):
        value = params.get(key)
        if isinstance(value, (list, tuple)):
            for item in value:
                pairs.append((key, str(item)))
        else:
            pairs.append((key, str(value)))
    query = urllib.parse.urlencode(pairs, doseq=True)
    body_hash = hashlib.sha256(body_bytes or b"").hexdigest()
    canonical = "\n".join([
        "REQUEST",
        method.upper(),
        path,
        timestamp,
        nonce,
        query,
        body_hash,
    ])
    signature = hmac.new(TOKEN.encode("utf-8"), canonical.encode("utf-8"), hashlib.sha256).hexdigest()
    return {
        "Authorization": f"Bearer {TOKEN}",
        "X-Infraveil-Signature-Version": "2",
        "X-Infraveil-Timestamp": timestamp,
        "X-Infraveil-Nonce": nonce,
        "X-Infraveil-Signature": signature,
    }

def _agent_source_hash():
    try:
        with open(os.path.realpath(__file__), "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except Exception:
        return ""

def _host_fingerprint():
    try:
        raw = "|".join([
            socket.gethostname(),
            platform.system(),
            platform.release(),
            platform.machine(),
            _agent_root(),
        ])
        return hashlib.sha256(raw.encode("utf-8", errors="ignore")).hexdigest()
    except Exception:
        return ""

def _payload_cache_summary():
    meta = _load_payload_meta()
    history = meta.get("history") if isinstance(meta.get("history"), list) else []
    known_good, known_good_meta = _load_cached_payload_version()
    return {
        "active_payload_hash": _current_payload_hash,
        "promoted_payload_hash": meta.get("promoted_payload_hash", ""),
        "cached_at": meta.get("cached_at", 0),
        "cached_versions": [
            {
                "payload_hash": item.get("payload_hash", ""),
                "cached_at": item.get("cached_at", 0),
                "promoted": item.get("promoted") is not False,
            }
            for item in history[:5]
            if isinstance(item, dict)
        ],
        "cache_present": os.path.isfile(PAYLOAD_CACHE),
        "known_good_available": bool(known_good),
        "rollback_available": bool(known_good and str((known_good_meta or {}).get("payload_hash") or "") != _runtime_package_hash),
    }

def _runtime_capability_summary():
    return {
        "agent_version": AGENT_VERSION,
        **RUNTIME_DEPENDENCY_STATUS,
        "agent_capabilities": AGENT_CAPABILITIES,
        "agent_source_hash": _agent_source_hash(),
        "host_fingerprint": _host_fingerprint(),
        "hostname": socket.gethostname(),
        "platform": {
            "system": platform.system(),
            "release": platform.release(),
            "machine": platform.machine(),
            "python": platform.python_version(),
        },
    }

def _signed_post_json(path, payload, timeout=10):
    body = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode("utf-8")
    headers = _signed_headers("POST", path, body_bytes=body)
    headers["Content-Type"] = "application/json"
    request_nonce = headers["X-Infraveil-Nonce"]
    resolved_timeout = timeout if isinstance(timeout, tuple) else (HTTP_CONNECT_TIMEOUT, timeout)
    response = HTTP.post(f"{BASE_URL}{path}", headers=headers, data=body, timeout=resolved_timeout)
    verify_response_signature(response, request_nonce, path)
    return response

def _signed_get(path, params=None, timeout=10):
    headers = _signed_headers("GET", path, params=params or {}, body_bytes=b"")
    request_nonce = headers["X-Infraveil-Nonce"]
    resolved_timeout = timeout if isinstance(timeout, tuple) else (HTTP_CONNECT_TIMEOUT, timeout)
    response = HTTP.get(f"{BASE_URL}{path}", headers=headers, params=params or {}, timeout=resolved_timeout)
    verify_response_signature(response, request_nonce, path)
    return response

def _request_with_retries(method, path, *, params=None, payload=None, timeout=10, attempts=3, backoff=1.5):
    last_exc = None
    for attempt in range(max(1, attempts)):
        try:
            if method == "GET":
                return _signed_get(path, params=params, timeout=timeout)
            if method == "POST":
                return _signed_post_json(path, payload or {}, timeout=timeout)
            raise RuntimeError(f"Unsupported method {method}")
        except Exception as exc:
            last_exc = exc
            if attempt >= attempts - 1:
                break
            time.sleep(min(10, backoff * (attempt + 1)))
    raise last_exc

def _record_payload_failure():
    global _payload_failures
    now = time.time()
    _payload_failures = [ts for ts in _payload_failures if now - ts < PAYLOAD_FAILURE_WINDOW_SECONDS]
    _payload_failures.append(now)
    return len(_payload_failures)

def _clear_payload_failures():
    global _payload_failures
    _payload_failures = []

def heartbeat():
    global _pending_cache_purge_ack, _completed_cache_purge_request_id
    try:
        import psutil
        cpu = psutil.cpu_percent(interval=None)
        mem = psutil.virtual_memory().percent
        disk = psutil.disk_usage(_agent_root()).percent
    except Exception:
        cpu = 0
        mem = 0
        disk = 0

    managed_services = {
        name: {
            "pid": getattr(proc, "pid", 0),
            "alive": bool(proc is not None and proc.poll() is None),
            "healthy": bool(proc is not None and proc.poll() is None and _service_health_failures.get(name, 0) == 0 and _service_health_observed(name)),
            "health_observed_at": _service_health_observed_at.get(name, 0),
            "health_check": "http" if _service_health_url(_service_health_specs.get(name) or {}) else "process",
            "restart_count": _service_restart_counts.get(name, 0),
            "port": (_service_health_specs.get(name) or {}).get("port"),
            "restart_budget_exhausted": _service_restart_counts.get(name, 0) > SERVICE_RESTART_MAX_ATTEMPTS,
            "health_failures": _service_health_failures.get(name, 0),
            "manager": "agent",
        }
        for name in list(_service_specs)
        for proc in [_service_processes.get(name)]
    }
    for name, spec in list(_external_service_specs.items()):
        managed_services[name] = {
            **_external_service_status(spec),
            "restart_count": 0,
            "health_failures": _service_health_failures.get(name, 0),
            "manager": "systemd",
            "unit": str(spec.get("unit") or ""),
            "log_capture": _journal_capture_summary(name),
        }

    runtime = {
        **_runtime_capability_summary(),
        "pid": os.getpid(),
        "control_plane_online": _control_plane_online,
        "payload_hash": _current_payload_hash,
        "payload_started_at": _current_payload_started_at,
        "payload_cache": _payload_cache_summary(),
        "payload_mode": _payload_mode,
        "gateway_alive": bool(_gateway_thread and getattr(_gateway_thread, "is_alive", lambda: False)()),
        "recovery": dict(_runtime_recovery),
        "port_allocation": _agent_runtime_ports.snapshot(),
        "manifest": _current_manifest_summary,
        "payload_detached_ok": _payload_detached_ok,
        "payload_detached_note": _payload_detached_note,
        "service_count": len(managed_services),
        "services": managed_services,
        "event_queue_size": _event_post_queue.qsize(),
        **_event_drop_summary(),
        "event_retry_count": _event_post_retry_count,
        "event_delivery_failure_count": _event_post_delivery_failure_count,
        "event_delivery_last_success_ts": _event_delivery_last_success_ts,
        "event_delivery_last_failure_ts": _event_delivery_last_failure_ts,
        "event_delivery_consecutive_failures": _event_delivery_consecutive_failures,
        "event_delivery_observation_version": 1,
        **_event_delivery_summary(),
        "runtime_observed_at": time.time(),
        "waf_revision": str(((_sec_policy or {}).get("compiled_waf") or {}).get("revision") or ""),
        "waf_mode": str(((_sec_policy or {}).get("compiled_waf") or {}).get("mode") or "off"),
    }
    sent_cache_ack = dict(_pending_cache_purge_ack)
    heartbeat_payload = {
        "client_id": CLIENT_ID,
        "agent_id": AGENT_ID,
        "metrics": {"cpu": cpu, "memory": mem, "disk": disk},
        "runtime": runtime,
        "audit_chain": {"head": _audit_chain_head, "seq": _audit_chain_seq},
    }
    if sent_cache_ack:
        if not _persist_cache_purge_state():
            raise RuntimeError("Could not persist pending cache purge acknowledgement")
        heartbeat_payload["cache_purge_ack"] = sent_cache_ack
    r = _request_with_retries("POST", "/agent/heartbeat", payload=heartbeat_payload, timeout=10, attempts=2)
    if r.status_code == 423:
        raise _workspace_locked_from_response(r)
    if r.status_code != 200:
        raise RuntimeError("Heartbeat rejected")
    data = r.json()
    if not isinstance(data, dict):
        raise RuntimeError("Heartbeat response is not a JSON object")
    if sent_cache_ack and _pending_cache_purge_ack == sent_cache_ack:
        _pending_cache_purge_ack = {}
        _persist_cache_purge_state()
    if data.get("cache_purge_requested"):
        purge_request_id = data.get("cache_purge_request_id")
        if not isinstance(purge_request_id, str) or not purge_request_id.strip():
            _append_local_audit("agent_runtime_cache_purge_rejected", reason="missing-request-id")
            return data
        purge_request_id = purge_request_id.strip()
        if purge_request_id == _completed_cache_purge_request_id:
            _append_local_audit("agent_runtime_cache_purge_stale", request_id=purge_request_id)
            return data
        if _purge_local_runtime_cache():
            _pending_cache_purge_ack = {
                "request_id": purge_request_id,
                "status": "succeeded",
            }
            _completed_cache_purge_request_id = purge_request_id
            _persist_cache_purge_state()
        else:
            _append_local_audit("agent_runtime_cache_purge_unacknowledged", request_id=purge_request_id)
    if data.get("runtime_stop_required") is True or data.get("locked") is True or data.get("command") == "stop":
        raise WorkspaceLocked(
            "Workspace is locked.",
            reasons=data.get("workspace_lock_reasons") if isinstance(data.get("workspace_lock_reasons"), list) else [],
            continuity_allowed=False,
            runtime_stop_required=True,
        )
    if data.get("workspace_locked"):
        raise WorkspaceLocked(
            "Workspace is billing-locked; new deploys are paused.",
            reasons=data.get("workspace_lock_reasons") if isinstance(data.get("workspace_lock_reasons"), list) else [],
            continuity_allowed=data.get("billing_continuity_allowed") is True,
            runtime_stop_required=False,
        )
    return data

def fetch_payload():
    global _current_payload_hash, _current_payload_vendor_sig, _current_payload_approval_sig
    r = _request_with_retries("GET", "/agent/secureportal", params={"client_id": CLIENT_ID, "agent_id": AGENT_ID}, timeout=20, attempts=3)
    if r.status_code == 423:
        raise _workspace_locked_from_response(r)
    if r.status_code == 200:
        raw_zip = decrypt(r.content)
        import hashlib as _hashlib
        local_hash = _hashlib.sha256(raw_zip).hexdigest()

        server_hash_header = r.headers.get("X-Payload-Hash", "").strip()
        server_sig_header = r.headers.get("X-Payload-Signature", "").strip()
        server_ed_header = r.headers.get("X-Payload-Ed25519", "").strip()
        if not verify_payload_signature(local_hash, server_sig_header):
            _append_local_audit("payload_signature_rejected", payload_hash=local_hash)
            raise RuntimeError("Payload authenticity check failed: signature mismatch.")
        if RELEASE_PUBLIC_KEY and not verify_payload_ed25519(local_hash, server_ed_header):
            _append_local_audit("payload_ed25519_rejected", payload_hash=local_hash)
            raise RuntimeError("Payload authenticity check failed: release signature invalid.")
        if CUSTOMER_APPROVAL_KEY and not verify_customer_approval(local_hash, r.headers.get("X-Payload-Customer-Approval", "").strip()):
            _append_local_audit("payload_customer_approval_rejected", payload_hash=local_hash)
            raise RuntimeError("Payload rejected: this release was not approved by your offline approval key.")
        try:
            vr = _request_with_retries("GET", "/agent/hash-verify", params={"client_id": CLIENT_ID, "agent_id": AGENT_ID}, timeout=10, attempts=2)
            server_hash_db = vr.json().get("payload_hash", "") if vr.status_code == 200 else server_hash_header
        except Exception:
            server_hash_db = server_hash_header

        if local_hash != server_hash_db:
            _append_local_audit("payload_hash_rejected", local_hash=local_hash, server_hash=server_hash_db)
            raise RuntimeError("Payload integrity check failed: hash mismatch.")
        approval_sig = r.headers.get("X-Payload-Customer-Approval", "").strip()
        _cache_payload(raw_zip, local_hash, server_ed_header, approval_sig)
        _clear_payload_failures()
        _append_local_audit("payload_verified", payload_hash=local_hash)
        return raw_zip
    raise RuntimeError("Fetch failed")

def _server_payload_hash():
    """Return the control plane's desired payload hash or raise on an unverifiable response."""
    vr = _request_with_retries("GET", "/agent/hash-verify", params={"client_id": CLIENT_ID, "agent_id": AGENT_ID}, timeout=10, attempts=2)
    if vr.status_code != 200:
        raise RuntimeError(f"payload hash verification failed (HTTP {vr.status_code})")
    data = vr.json()
    if not isinstance(data, dict):
        raise RuntimeError("control plane returned a malformed payload hash response")
    payload_hash = str(data.get("payload_hash", "") or "").strip()
    if not re.fullmatch(r"[0-9a-f]{64}", payload_hash):
        raise RuntimeError("control plane returned an invalid payload hash")
    return payload_hash

SECURITY_POLICY_CACHE = os.path.join(_agent_root(), f"agent_security_policy_{_agent_slug()}.json")
SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS = 10.0
GATEWAY_BIND_STARTUP_TIMEOUT_SECONDS = 5.0
_sec_policy = {
    "rate_limit_enabled": False,
    "rate_limit_rpm": 120,
    "rate_limit_burst": 30,
    "rate_limit_enforcement_mode": "enforce",
    "blocked_ips": [],
    "whitelisted_ips": [],
