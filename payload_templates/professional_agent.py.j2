        "control_plane_exempt_paths": [],
        "revision": "bootstrap",
    },
}
_sec_policy_ready = threading.Event()
_sec_policy_source = "bootstrap"
_sec_last_failure_log_at = 0.0

def _valid_runtime_security_policy(policy):
    if not isinstance(policy, dict):
        return False
    compiled = policy.get("compiled_waf")
    if not isinstance(compiled, dict):
        return False
    revision = str(compiled.get("revision") or "").strip().lower()
    if revision == "bootstrap" or len(revision) != 64 or not re.fullmatch(r"[0-9a-f]{64}", revision):
        return False
    try:
        if int(compiled.get("schema_version")) != 1:
            return False
    except Exception:
        return False
    if str(compiled.get("mode") or "").strip().lower() not in {"off", "simulate", "enforce"}:
        return False
    if not isinstance(compiled.get("rules"), list) or not isinstance(compiled.get("exclusions"), list):
        return False
    if not isinstance(compiled.get("inspection"), dict) or not isinstance(compiled.get("control_plane_exempt_paths"), list):
        return False
    canonical_compiled = dict(compiled)
    canonical_compiled.pop("revision", None)
    try:
        canonical = json.dumps(canonical_compiled, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    except Exception:
        return False
    expected_revision = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
    if not hmac.compare_digest(expected_revision, revision):
        return False
    runtime_revision = str(policy.get("runtime_revision") or "").strip().lower()
    if len(runtime_revision) != 64 or not re.fullmatch(r"[0-9a-f]{64}", runtime_revision):
        return False
    canonical_policy = dict(policy)
    canonical_policy.pop("runtime_revision", None)
    try:
        canonical_runtime = json.dumps(canonical_policy, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
    except Exception:
        return False
    expected_runtime_revision = hashlib.sha256(canonical_runtime.encode("utf-8")).hexdigest()
    return hmac.compare_digest(expected_runtime_revision, runtime_revision)

try:
    if os.path.isfile(SECURITY_POLICY_CACHE):
        _cached_sec_policy = json.loads(open(SECURITY_POLICY_CACHE, encoding="utf-8").read())
        if _valid_runtime_security_policy(_cached_sec_policy):
            _sec_policy = _cached_sec_policy
            _sec_policy_source = "last-known-good-cache"
            _sec_policy_ready.set()
        else:
            _write_boot_log("[SECURITY_POLICY_CACHE] ignored invalid or bootstrap policy cache")
except Exception as _policy_cache_exc:
    _write_boot_log(f"[SECURITY_POLICY_CACHE] ignored invalid cache: {_policy_cache_exc}")
_sec_last_sync = 0
_sec_lock = threading.Lock()
SECURITY_STATE_MAX_IDENTITIES = 50000
SECURITY_STATE_MAX_PIPELINE_KEYS = 100000
_sec_ip_hits = OrderedDict()
_sec_rate_buckets = OrderedDict()
_sec_auto_blocked = OrderedDict()
_sec_honeypot_blocked = OrderedDict()
_sec_sync_inflight = False
_sec_rate_windows = OrderedDict()
_sec_last_sweep = 0

def _bounded_security_state_put(store, key, value, limit):
    store[key] = value
    try:
        store.move_to_end(key)
    except AttributeError:
        pass
    while len(store) > limit:
        try:
            store.popitem(last=False)
        except TypeError:
            store.pop(next(iter(store)))

def _sweep_security_state():
    global _sec_last_sweep
    now = time.time()
    if now - _sec_last_sweep < 300:
        return
    with _sec_lock:
        _sec_last_sweep = now
        stale = now - 600
        for store in (_sec_ip_hits, _sec_rate_windows):
            for key in [k for k, v in store.items() if not v or float(v[-1]) < stale]:
                store.pop(key, None)
        for key in [k for k, v in _sec_rate_buckets.items() if not v or v[1] < stale]:
            _sec_rate_buckets.pop(key, None)
        for store in (_sec_auto_blocked, _sec_honeypot_blocked):
            for key in [k for k, until in store.items() if until <= now]:
                store.pop(key, None)

def _sync_security_policy(force=False):
    global _sec_policy, _sec_policy_source, _sec_last_sync, _sec_sync_inflight
    now = time.time()
    if not force and now - _sec_last_sync < 5:
        return
    with _sec_lock:
        if _sec_sync_inflight:
            return
        _sec_sync_inflight = True

    def _pull():
        global _sec_policy, _sec_policy_source, _sec_last_sync, _sec_sync_inflight, _sec_last_failure_log_at
        try:
            r = _signed_get("/agent/security-policy", {"client_id": CLIENT_ID, "agent_id": AGENT_ID}, timeout=4)
            if r.status_code == 423:
                _shutdown_handler(signal.SIGTERM)
                return
            if r.status_code == 200:
                data = r.json()
                next_policy = data.get("policy", _sec_policy)
                if not _valid_runtime_security_policy(next_policy):
                    raise RuntimeError("security policy missing valid non-bootstrap compiled WAF contract")
                with _sec_lock:
                    whitelisted = set(next_policy.get("whitelisted_ips", []) or [])
                    limiter_changed = any(
                        next_policy.get(key) != _sec_policy.get(key)
                        for key in ("rate_limit_enabled", "rate_limit_rpm", "rate_limit_burst")
                    )
                    if limiter_changed:
                        _sec_rate_buckets.clear()
                        _sec_ip_hits.clear()
                    for ip in list(_sec_auto_blocked.keys()):
                        if ip in whitelisted or not next_policy.get("auto_block_enabled"):
                            _sec_auto_blocked.pop(ip, None)
                            _sec_ip_hits.pop(ip, None)
                    # Trap bans have their own lifetime; the rate-limit toggle
                    # must not remove them. Whitelisting explicitly releases both.
                    for ip in list(_sec_honeypot_blocked):
                        if ip in whitelisted or _sec_honeypot_blocked[ip] <= now:
                            _sec_honeypot_blocked.pop(ip, None)
                    _sec_policy = next_policy
                    _sec_policy_source = "control-plane"
                    _sec_last_sync = time.time()
                    _sec_policy_ready.set()
                try:
                    tmp_path = SECURITY_POLICY_CACHE + ".tmp"
                    with open(tmp_path, "w", encoding="utf-8") as cache_file:
                        json.dump(next_policy, cache_file, separators=(",", ":"), sort_keys=True)
                        cache_file.flush()
                        try:
                            os.fsync(cache_file.fileno())
                        except Exception:
                            pass
                    os.replace(tmp_path, SECURITY_POLICY_CACHE)
                    try:
                        os.chmod(SECURITY_POLICY_CACHE, 0o600)
                    except Exception:
                        pass
                except Exception as cache_exc:
                    _write_boot_log(f"[SECURITY_POLICY_CACHE] write failed: {cache_exc}")
            else:
                raise RuntimeError(f"security policy fetch failed (HTTP {r.status_code})")
        except Exception as exc:
            failure_now = time.time()
            if failure_now - _sec_last_failure_log_at >= 60:
                report_log(f"[WARN] Security policy synchronization failed; retaining last-known-good policy: {exc}")
                _append_local_audit("security_policy_sync_failed", error=str(exc)[:200])
                _sec_last_failure_log_at = failure_now
        finally:
            with _sec_lock:
                _sec_sync_inflight = False

    threading.Thread(target=_pull, daemon=True).start()

def _runtime_security_policy_source():
    with _sec_lock:
        if _sec_policy_ready.is_set() and _valid_runtime_security_policy(_sec_policy):
            return _sec_policy_source
    return ""

def _wait_for_runtime_security_policy(timeout=SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS):
    timeout = max(0.05, min(30.0, float(timeout or SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS)))
    deadline = time.monotonic() + timeout
    next_attempt = 0.0
    while not _shutdown:
        source = _runtime_security_policy_source()
        if source:
            return source
        now = time.monotonic()
        if now >= deadline:
            break
        if now >= next_attempt:
            _sync_security_policy(force=True)
            next_attempt = now + 0.5
        _sec_policy_ready.wait(timeout=min(0.1, max(0.0, deadline - time.monotonic())))
    source = _runtime_security_policy_source()
    if source:
        return source
    raise RuntimeError("No valid non-bootstrap control-plane security policy or last-known-good policy cache available")

def _event_post_retry_delay(item, attempt, response=None):
    try:
        retry_after = str((getattr(response, "headers", {}) or {}).get("Retry-After", "")).strip()
        if retry_after:
            return min(_EVENT_POST_MAX_BACKOFF_SECONDS, max(0.05, float(retry_after)))
    except Exception:
        pass
    event_id = str(item.get("event_id") or "")
    digest = hashlib.sha256(f"{event_id}:{attempt}".encode("utf-8")).hexdigest()
    jitter = 0.75 + (int(digest[:8], 16) / 0xFFFFFFFF) * 0.5
    delay = _EVENT_POST_BASE_BACKOFF_SECONDS * (2 ** max(0, attempt - 1)) * jitter
    return min(_EVENT_POST_MAX_BACKOFF_SECONDS, delay)

def _record_event_drop_locked():
    global _event_post_drop_count, _event_post_drop_last_at
    _event_post_drop_count += 1
    _event_post_drop_last_at = time.time()
    second = int(time.monotonic())
    if _event_post_drop_buckets and _event_post_drop_buckets[-1][0] == second:
        stamp, count = _event_post_drop_buckets.pop()
        _event_post_drop_buckets.append((stamp, count + 1))
    else:
        _event_post_drop_buckets.append((second, 1))

def _event_drop_summary():
    with _event_post_drop_lock:
        cutoff = time.monotonic() - _EVENT_POST_DROP_WINDOW_SECONDS
        while _event_post_drop_buckets and _event_post_drop_buckets[0][0] + 1 <= cutoff:
            _event_post_drop_buckets.popleft()
        return {
            "event_drop_count": _event_post_drop_count,
            "event_drop_recent_count": sum(count for _stamp, count in _event_post_drop_buckets),
            "event_drop_window_seconds": _EVENT_POST_DROP_WINDOW_SECONDS,
            "event_drop_window_resolution_seconds": 1,
            "event_drop_last_at": _event_post_drop_last_at,
            "event_drop_observation_version": 1,
        }

def _event_delivery_summary():
    with _event_post_queue.mutex:
        timestamps = [float(item.get("queued_at") or time.time()) for item in _event_post_queue.queue if isinstance(item, dict)]
    with _event_post_drop_lock:
        timestamps.extend(_event_post_inflight.values())
    return {
        "event_delivery_worker_alive": (not _event_post_workers_started and not timestamps) or
            (len(_event_post_worker_threads) == 2 and all(worker.is_alive() for worker in _event_post_worker_threads)),
        "event_delivery_oldest_pending_age_seconds": max(0, time.time() - min(timestamps)) if timestamps else 0,
    }


def _record_event_delivery_failure(item, reason):
    global _event_post_drop_count, _event_post_delivery_failure_count
    _record_delivery_observation(False)
    with _event_post_drop_lock:
        _record_event_drop_locked()
        _event_post_delivery_failure_count += 1
        failure_count = _event_post_delivery_failure_count
    if failure_count in (1, 10, 100, 500, 1000):
        _write_boot_log(
            f"[EVENT_DELIVERY] Failed {failure_count} event posts after retries "
            f"path={item.get('path', '')} event_id={item.get('event_id', '')} reason={reason}"
        )

def _event_post_worker():
    global _event_post_retry_count
    while True:
        try:
            item = _event_post_queue.get()
            if item is None:
                return
            with _event_post_drop_lock:
                _event_post_inflight[threading.get_ident()] = float(item.get("queued_at") or time.time())
            try:
                delivered = False
                last_reason = "unknown"
                for attempt in range(1, _EVENT_POST_MAX_ATTEMPTS + 1):
                    response = None
                    try:
                        response = _signed_post_json(item["path"], item["payload"], timeout=item.get("timeout", 5))
                        status = int(getattr(response, "status_code", 0) or 0)
                        if 200 <= status < 300:
                            delivered = True
                            _record_delivery_observation(True)
                            break
                        if status == 423:
                            _shutdown_handler(signal.SIGTERM)
                            return
                        last_reason = f"HTTP {status}"
                        if status not in _EVENT_POST_RETRYABLE_STATUS:
                            break
                    except Exception as exc:
                        last_reason = f"{type(exc).__name__}: {exc}"
                    if attempt >= _EVENT_POST_MAX_ATTEMPTS:
                        break
                    with _event_post_drop_lock:
                        _event_post_retry_count += 1
                    time.sleep(_event_post_retry_delay(item, attempt, response=response))
                if not delivered:
                    _record_event_delivery_failure(item, last_reason)
            except Exception as exc:
                _record_event_delivery_failure(item, f"worker error: {type(exc).__name__}: {exc}")
            finally:
                with _event_post_drop_lock:
                    _event_post_inflight.pop(threading.get_ident(), None)
                _event_post_queue.task_done()
        except Exception:
            pass

def _ensure_event_post_workers():
    global _event_post_workers_started
    if _event_post_workers_started:
        return
    _event_post_workers_started = True
    for _ in range(2):
        worker = threading.Thread(target=_event_post_worker, daemon=True)
        _event_post_worker_threads.append(worker)
        worker.start()

def _enqueue_event_post(path, payload, timeout=5):
    global _event_post_drop_count
    _ensure_event_post_workers()
    event_id = f"{AGENT_ID}-{uuid.uuid4().hex}"
    payload = dict(payload or {})
    payload.setdefault("event_id", event_id)
    try:
        _event_post_queue.put_nowait({
            "path": path,
            "payload": payload,
            "timeout": timeout,
            "event_id": str(payload.get("event_id") or event_id),
            "queued_at": time.time(),
        })
        return True
    except queue.Full:
        with _event_post_drop_lock:
            _record_event_drop_locked()
            if _event_post_drop_count in (1, 10, 100, 500, 1000):
                _write_boot_log(f"[BACKPRESSURE] Dropped {_event_post_drop_count} queued event posts")
        return False

def _sec_report_event(event_type, ip, message, path="", pattern="", extra=None):
    try:
        _enqueue_event_post("/agent/security-event", {"client_id": CLIENT_ID, "agent_id": AGENT_ID,
                  "type": event_type, "ip": ip, "message": message,
                  "path": path, "pattern": pattern, "extra": extra or {}}, timeout=5)
    except Exception as exc:
        _write_boot_log(f"[SECURITY_EVENT_DROP] {exc}")

def _report_network_event(ip, method, path, environ, body_preview="", telemetry=None,
                          body_size=None, body_hash="", body_inspection="", content_type=""):
    try:
        headers = {}
        for k, v in environ.items():
            if k.startswith("HTTP_") and k not in ("HTTP_HOST", "HTTP_CONNECTION", "HTTP_COOKIE", "HTTP_AUTHORIZATION"):
                headers[k[5:].replace("_", "-").title()] = str(v)[:200]

        body_bytes = (body_preview or "").encode("utf-8", errors="replace")
        if body_size is None:
            body_size = len(body_bytes)
        if body_bytes and not body_hash:
            body_hash = hashlib.sha256(body_bytes).hexdigest()

        _enqueue_event_post("/agent/network-event", {
                "client_id": CLIENT_ID,
                "agent_id": AGENT_ID,
                "method": method,
                "path": path,
                "ip": ip,
                "user_agent": environ.get("HTTP_USER_AGENT", "")[:200],
                "headers": headers,
                "payload_metadata": {
                    "captured": False,
                    "size_bytes": int(body_size or 0),
                    "sha256": str(body_hash or ""),
                    "inspection_state": str(body_inspection or ""),
                    "content_type": str(content_type or environ.get("CONTENT_TYPE", ""))[:160],
                },
                "telemetry": telemetry or {},
            }, timeout=3)
    except Exception:
        pass


def _safe_json_loads(raw, fallback=None):
    text = str(raw or "").strip()
    if not text:
        return {} if fallback is None else fallback
    try:
        return json.loads(text)
    except Exception:
        return {} if fallback is None else fallback


def _route_family(path):
    path = str(path or "/")
    if path == "/":
        return "root"
    bits = [b for b in path.split("/") if b]
    if not bits:
        return "root"
    if len(bits) == 1:
        return f"/{bits[0]}"
    return f"/{bits[0]}/*"


def _dim_value(ctx, name):
    name = str(name or "").strip()
    if not name:
        return "(unknown)"
    telemetry = ctx.setdefault("telemetry", {})
    if name == "path":
        return ctx.get("path") or "/"
    if name == "method":
        return ctx.get("method") or "GET"
    if name == "country":
        return ctx.get("country") or "(unknown)"
    if name == "ip":
        return ctx.get("ip") or "(unknown)"
    if name == "user_agent":
        return ctx.get("ua") or "(unknown)"
    if name == "route_group":
        return telemetry.get("route_group") or _route_family(ctx.get("path"))
    if name == "status":
        return str(ctx.get("upstream_status") or ctx.get("response_status") or ctx.get("proposed_status") or "allow")
    return telemetry.get(name, ctx.get(name, "(unknown)"))


def _ctx_log(ctx, level, msg, stage=None):
    logs = ctx.setdefault("pipeline_logs", [])
    logs.append({"level": level, "message": msg, "stage": stage or "", "stack": ctx.get("current_stack_name", "")})


def _stage_config(stage):
    cfg = stage.get("config")
    if isinstance(cfg, dict):
        return cfg
    return _safe_json_loads(stage.get("config_json") or "{}", {})


def _module_matches(module, ctx):
    trigger = str(module.get("trigger") or "").strip().lower()
    schema = module.get("schema")
    if not isinstance(schema, dict):
        schema = _safe_json_loads(module.get("schema_json") or "{}", {})
    path = (ctx.get("path") or "").lower()
    ua = (ctx.get("ua") or "").lower()
    method = (ctx.get("method") or "").upper()
    payload = (ctx.get("body_preview") or "").lower()
    if trigger and trigger not in " ".join([path, ua, method.lower(), payload]):
        return False, schema
    methods = [str(m).upper() for m in (schema.get("methods") or []) if str(m).strip()]
    if methods and method not in methods:
        return False, schema
    path_contains = [str(v).lower() for v in (schema.get("path_contains") or []) if str(v).strip()]
    if path_contains and not any(piece in path for piece in path_contains):
        return False, schema
    header_rules = schema.get("headers") or {}
    if isinstance(header_rules, dict):
        header_blob = json.dumps(ctx.get("headers") or {}, default=str).lower()
        for key, value in header_rules.items():
            if str(key).lower() not in header_blob or str(value).lower() not in header_blob:
                return False, schema
    return True, schema


def _outbound_url_blocked(url):
    try:
        import ipaddress
        p = urllib.parse.urlparse(str(url or ""))
        if p.scheme != "https":
            return True
        host = (p.hostname or "").strip("[]")
        if not host:
            return True
        try:
            infos = socket.getaddrinfo(host, None)
        except Exception:
            return True
        for info in infos:
            ip = ipaddress.ip_address(str(info[4][0]).split("%")[0])
            if (ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_reserved
                    or ip.is_multicast or ip.is_unspecified):
                return True
            mapped = getattr(ip, "ipv4_mapped", None)
            if mapped is not None and (mapped.is_private or mapped.is_loopback
                                       or mapped.is_link_local or mapped.is_reserved):
                return True
        return False
    except Exception:
        return True

class _DiscardingAnalysisToolSession(requests.Session):
    def resolve_redirects(self, *args, **kwargs):
        # Even allow_redirects=False normally prepares Response.next and reads
        # the redirect body. Tool responses are discarded, never followed.
        return iter(())


def _invoke_analysis_tool(ctx, tool_name, phase):
    policy = ctx.get("_policy_snapshot") if isinstance(ctx.get("_policy_snapshot"), dict) else {}
    learning = policy.get("learning_engine", {}) or {}
    tools = learning.get("custom_tools") or []
    tool = next((t for t in tools if str(t.get("name") or "").strip() == tool_name), None)
    if not tool:
        _ctx_log(ctx, "WARN", f"Tool contract not found: {tool_name}", stage="call_tool")
        return
    input_contract = tool.get("input_contract")
    if not isinstance(input_contract, dict):
        input_contract = _safe_json_loads(tool.get("input_contract_json") or "{}", {})
    endpoint = str(input_contract.get("endpoint") or "").strip()
    if not endpoint:
        _ctx_log(ctx, "INFO", f"Tool contract recorded without endpoint: {tool_name}", stage="call_tool")
        return
    if _outbound_url_blocked(endpoint):
        _ctx_log(ctx, "WARN", f"Tool endpoint refused (must be HTTPS to a public address; internal/loopback/metadata blocked): {tool_name}", stage="call_tool")
        return
    method = str(input_contract.get("method") or "POST").upper()
    if method not in {"GET", "POST"}:
        _ctx_log(ctx, "WARN", f"Tool endpoint refused (unsupported HTTP method): {tool_name}", stage="call_tool")
        return
    headers = input_contract.get("headers") or {}
    timeout = max(0.5, min(float(input_contract.get("timeout_seconds", 2) or 2), 10.0))
    payload = {
        "tool": tool_name,
        "phase": phase,
        "request": {
            "ip": ctx.get("ip"),
            "path": ctx.get("path"),
            "method": ctx.get("method"),
            "country": ctx.get("country"),
            "user_agent": ctx.get("ua"),
        },
        "telemetry": ctx.get("telemetry", {}),
        "risk_score": ctx.get("risk_score", 0),
    }
    if not _ANALYSIS_TOOL_SEMAPHORE.acquire(blocking=False):
        _ctx_log(ctx, "WARN", f"Tool invocation dropped at concurrency limit: {tool_name}", stage="call_tool")
        return
    def _send():
        try:
            if _outbound_url_blocked(endpoint):
                _sec_report_event("policy", ctx.get("ip", ""), f"Tool endpoint changed or became unsafe: {tool_name}",
                                  path=ctx.get("path", "/"), pattern="tool-contract",
                                  extra={"method": ctx.get("method", "GET"), "tool": tool_name})
                return
            with _DiscardingAnalysisToolSession() as session:
                with session.request(method, endpoint, json=payload, headers=headers, timeout=timeout,
                                     allow_redirects=False, stream=True):
                    pass
        except Exception as e:
            _sec_report_event("policy", ctx.get("ip", ""), f"Tool invocation failed: {tool_name}: {e}",
                              path=ctx.get("path", "/"), pattern="tool-contract",
                              extra={"method": ctx.get("method", "GET"), "tool": tool_name})
        finally:
            _ANALYSIS_TOOL_SEMAPHORE.release()
    try:
        threading.Thread(target=_send, daemon=True).start()
    except Exception:
        _ANALYSIS_TOOL_SEMAPHORE.release()
        raise
    _ctx_log(ctx, "AUDIT", f"Tool invoked: {tool_name}", stage="call_tool")


def _apply_custom_modules(ctx, modules, phase):
    for module in modules or []:
        if not isinstance(module, dict):
            continue
        try:
            matches, schema = _module_matches(module, ctx)
            if not matches:
                continue
            action = str(schema.get("action") or "annotate").lower()
            module_name = module.get("name") or module.get("id") or "custom-module"
            ctx.setdefault("telemetry", {}).setdefault("modules_hit", []).append(module_name)
            _ctx_log(ctx, "AUDIT", f"Custom module matched: {module_name}", stage=module_name)
            if action == "annotate":
                additions = schema.get("set") or {}
                if isinstance(additions, dict):
                    ctx.setdefault("telemetry", {}).update(additions)
            elif action == "score":
                ctx["risk_score"] = int(ctx.get("risk_score", 0)) + int(schema.get("score", 10) or 10)
            elif action == "block" and phase == "response":
                ctx["decision"] = "block"
                ctx["response_status"] = int(schema.get("status", 403) or 403)
                ctx["response_body"] = str(schema.get("body") or "Forbidden").encode("utf-8")
                ctx["response_content_type"] = str(schema.get("content_type") or "text/plain")
                ctx["decision_reason"] = f"module:{module_name}"
                return
            elif action == "deceive" and phase == "response":
                ctx["decision"] = "deceive"
                ctx["response_status"] = int(schema.get("status", 200) or 200)
                ctx["response_body"] = json.dumps(schema.get("payload", {"status": "ok"})).encode("utf-8")
                ctx["response_content_type"] = "application/json"
                ctx["decision_reason"] = f"module:{module_name}"
                return
            elif action == "tarpit" and phase == "response":
                ctx["tarpit_delay"] = max(ctx.get("tarpit_delay", 0), int(schema.get("delay_seconds", 5) or 5))
        except Exception as e:
            _ctx_log(ctx, "ERROR", f"Custom module failure: {e}", stage=module.get("name") or module.get("id") or "custom-module")


def _geo_country_blocked(country, mode, countries):
    # A configured allowlist requires a known, permitted country. An empty
    # list remains disabled; an unknown country does not match a blocklist.
    return bool(countries) and (
        (mode == "blocklist" and country in countries)
        or (mode == "allowlist" and country not in countries)
    )


def _execute_pipeline(ctx, pipeline, phase):
    for stage in pipeline or []:
        if not isinstance(stage, dict) or not stage.get("enabled", True):
            continue
        stage_id = stage.get("stage") or stage.get("id") or "unknown"
        cfg = _stage_config(stage)
        try:
            if stage_id == "observe_request":
                telemetry = ctx.setdefault("telemetry", {})
                for name in ctx.get("telemetry_dimensions", []):
                    telemetry[name] = _dim_value(ctx, name)
                telemetry.setdefault("route_family", _route_family(ctx.get("path")))
                telemetry.setdefault("has_payload", bool(ctx.get("body_preview")))
                telemetry.setdefault("body_size_band", "present" if ctx.get("body_preview") else "none")
            elif stage_id == "tag_route":
                route_map = cfg.get("map") or {}
                group = route_map.get(ctx.get("path")) or _route_family(ctx.get("path"))
                ctx.setdefault("telemetry", {})["route_group"] = group
            elif stage_id == "count_dimension":
                dims = cfg.get("dimensions") or ctx.get("telemetry_dimensions", [])
                counts = ctx.setdefault("telemetry", {}).setdefault("dimension_counts", {})
                for name in dims:
                    key = f"{name}:{_dim_value(ctx, name)}"
                    counts[key] = counts.get(key, 0) + 1
            elif stage_id == "capture_payload_shape":
                telemetry = ctx.setdefault("telemetry", {})
                telemetry["payload_present"] = bool(ctx.get("body_preview"))
                telemetry["content_type"] = ctx.get("content_type") or "(none)"
                telemetry["content_length"] = ctx.get("content_length", 0)
                telemetry["payload_shape"] = "json" if "json" in str(ctx.get("content_type") or "").lower() else ("form" if "form" in str(ctx.get("content_type") or "").lower() else "raw")
            elif stage_id == "session_fingerprint":
                base = "|".join([ctx.get("ip",""), ctx.get("ua",""), ctx.get("path",""), ctx.get("method","")])
                ctx.setdefault("telemetry", {})["session_fingerprint"] = hashlib.sha256(base.encode("utf-8")).hexdigest()[:16]
            elif stage_id == "detect_pattern":
                if cfg.get("paths") or cfg.get("user_agents") or cfg.get("payloads") or cfg.get("headers"):
                    _match_policy = {
                        "suspicious_path_patterns": cfg.get("paths") or [],
                        "suspicious_user_agents": cfg.get("user_agents") or [],
                        "suspicious_payload_patterns": cfg.get("payloads") or [],
                        "custom_block_headers": cfg.get("headers") or [],
                    }
                else:
                    _match_policy = ctx.get("_policy_snapshot") if isinstance(ctx.get("_policy_snapshot"), dict) else {}
                kind, value = _match_security_patterns(ctx.get("path"), ctx.get("ua"), ctx.get("body_preview"), ctx.get("headers"), _match_policy)
                if kind:
                    ctx.setdefault("telemetry", {})["detected_pattern"] = {"kind": kind, "value": value}
                    ctx["risk_score"] = int(ctx.get("risk_score", 0)) + int(cfg.get("score", 25) or 25)
            elif stage_id == "risk_score":
                threshold = cfg.get("weights") or {}
                if ctx.get("country") and ctx.get("country") in (cfg.get("country_weights") or {}):
                    ctx["risk_score"] = int(ctx.get("risk_score", 0)) + int((cfg.get("country_weights") or {}).get(ctx.get("country"), 0) or 0)
                if ctx.get("telemetry", {}).get("detected_pattern"):
                    patt = ctx["telemetry"]["detected_pattern"]["kind"]
                    ctx["risk_score"] = int(ctx.get("risk_score", 0)) + int(threshold.get(patt, 0) or 0)
            elif stage_id == "geo_gate":
                policy = ctx.get("_policy_snapshot") if isinstance(ctx.get("_policy_snapshot"), dict) else {}
                mode = str(cfg.get("mode") or policy.get("geo_block_mode", "blocklist")).lower()
                countries = {str(c).strip().upper() for c in (cfg.get("countries") or policy.get("geo_block_countries", [])) if str(c).strip()}
                country = ctx.get("country") or ""
                if _geo_country_blocked(country, mode, countries) and phase == "response":
                    ctx["decision"] = "block"
                    ctx["response_status"] = 403
                    ctx["response_body"] = b"Forbidden"
                    ctx["response_content_type"] = "text/plain"
                    ctx["decision_reason"] = "geo_gate"
                    return
            elif stage_id == "rate_shape":
                window = int(cfg.get("window_seconds", 60) or 60)
                key = f"{ctx.get('ip','')}|{ctx.get('path','')}"
                now = time.time()
                with _sec_lock:
                    window_started, hit_count, _last_seen = _sec_rate_windows.get(key, (now, 0, now))
                    if now - window_started >= window:
                        window_started, hit_count = now, 0
                    hit_count += 1
                    _bounded_security_state_put(
                        _sec_rate_windows,
                        key,
                        (window_started, hit_count, now),
                        SECURITY_STATE_MAX_PIPELINE_KEYS,
                    )
                ctx.setdefault("telemetry", {})["burst_hits"] = hit_count
                if hit_count >= int(cfg.get("risk_threshold", 20) or 20):
                    ctx["risk_score"] = int(ctx.get("risk_score", 0)) + int(cfg.get("score", 15) or 15)
            elif stage_id == "enrich_request":
                additions = cfg.get("set") or {}
                if isinstance(additions, dict):
                    ctx.setdefault("telemetry", {}).update(additions)
            elif stage_id == "emit_dashboard_signal":
                signal_name = str(cfg.get("name") or "pipeline_signal")
                signal_value = _dim_value(ctx, cfg.get("dimension") or "path")
                ctx.setdefault("telemetry", {}).setdefault("signals", {})[signal_name] = signal_value
            elif stage_id == "branch_by_condition":
                if int(ctx.get("risk_score", 0)) < int(cfg.get("min_risk", 0) or 0):
                    _ctx_log(ctx, "INFO", f"Branch skipped downstream actions below risk {cfg.get('min_risk', 0)}", stage=stage_id)
                    break
            elif stage_id == "call_tool":
                tool_name = str(cfg.get("tool") or cfg.get("name") or "").strip()
                if tool_name:
                    ctx.setdefault("telemetry", {}).setdefault("tool_calls", []).append({
                        "tool": tool_name,
                        "kind": cfg.get("kind") or "analysis",
                        "phase": phase,
                    })
                    _invoke_analysis_tool(ctx, tool_name, phase)
            elif stage_id == "invoke_module":
                _apply_custom_modules(ctx, ctx.get("current_stack_modules", []), phase)
                if ctx.get("decision"):
                    return
            elif phase == "response" and stage_id == "log_event":
                _ctx_log(ctx, "AUDIT", cfg.get("message") or f"Response pipeline log_event on {ctx.get('path')}", stage=stage_id)
            elif phase == "response" and stage_id == "block_request":
                threshold = int(cfg.get("threshold", 1) or 1)
                if int(ctx.get("risk_score", 0)) >= threshold:
                    ctx["decision"] = "block"
                    ctx["response_status"] = int(cfg.get("status", 403) or 403)
                    ctx["response_body"] = str(cfg.get("body") or "Forbidden").encode("utf-8")
                    ctx["response_content_type"] = str(cfg.get("content_type") or "text/plain")
                    ctx["decision_reason"] = "pipeline:block_request"
                    return
            elif phase == "response" and stage_id == "tarpit_request":
                threshold = int(cfg.get("threshold", 1) or 1)
                if int(ctx.get("risk_score", 0)) >= threshold:
                    ctx["tarpit_delay"] = max(ctx.get("tarpit_delay", 0), int(cfg.get("delay_seconds", 5) or 5))
            elif phase == "response" and stage_id == "serve_deception":
                threshold = int(cfg.get("threshold", 1) or 1)
                if int(ctx.get("risk_score", 0)) >= threshold:
                    ctx["decision"] = "deceive"
                    payload = cfg.get("payload", {"status": "ok", "debug": False})
                    ctx["response_status"] = int(cfg.get("status", 200) or 200)
                    ctx["response_body"] = json.dumps(payload).encode("utf-8")
                    ctx["response_content_type"] = str(cfg.get("content_type") or "application/json")
                    ctx["decision_reason"] = "pipeline:serve_deception"
                    return
        except Exception as e:
            _ctx_log(ctx, "ERROR", f"Pipeline stage failed: {e}", stage=stage_id)
            try:
                _sec_report_event(
                    "policy",
                    ctx.get("ip", ""),
                    f"Pipeline stage failure in {stage_id}: {e}",
                    path=ctx.get("path", "/"),
                    pattern="pipeline",
                    extra={"method": ctx.get("method", "GET"), "country": ctx.get("country", ""), "stage": stage_id}
                )
            except Exception:
                pass


def _get_pipeline_stacks(policy):
    stacks = []
    raw = policy.get("pipeline_stacks") if isinstance(policy, dict) else None
    if isinstance(raw, list) and raw:
        for idx, stack in enumerate(raw):
            if not isinstance(stack, dict) or stack.get("enabled", True) is False:
                continue
            target_mode = str(stack.get("target_mode") or "all").strip().lower()
            target_agent_ids = stack.get("target_agent_ids") or []
            target_launcher_host_ids = stack.get("target_launcher_host_ids") or []
            if target_mode == "agents" and AGENT_ID not in target_agent_ids:
                continue
            if target_mode == "launcher_hosts" and LAUNCHER_HOST_ID not in target_launcher_host_ids:
                continue
            stacks.append({
                "id": stack.get("id") or f"stack-{idx + 1}",
                "name": stack.get("name") or f"Stack {idx + 1}",
                "order": int(stack.get("order", idx + 1) or idx + 1),
                "telemetry_dimensions": stack.get("telemetry_dimensions") if isinstance(stack.get("telemetry_dimensions"), list) else list(policy.get("telemetry_dimensions", []) or []),
                "telemetry_pipeline": stack.get("telemetry_pipeline") if isinstance(stack.get("telemetry_pipeline"), list) else [],
                "response_pipeline": stack.get("response_pipeline") if isinstance(stack.get("response_pipeline"), list) else [],
                "custom_defense_modules": stack.get("custom_defense_modules") if isinstance(stack.get("custom_defense_modules"), list) else [],
            })
    if not stacks:
        stacks.append({
            "id": "primary-stack",
            "name": "Primary Stack",
            "order": 1,
            "telemetry_dimensions": list(policy.get("telemetry_dimensions", []) or []),
            "telemetry_pipeline": list(policy.get("telemetry_pipeline", []) or []),
            "response_pipeline": list(policy.get("response_pipeline", []) or []),
            "custom_defense_modules": list(policy.get("custom_defense_modules", []) or []),
        })
    stacks.sort(key=lambda item: int(item.get("order", 9999) or 9999))
    return stacks


def _run_stack(ctx, stack, phase):
    if not isinstance(stack, dict):
        return
    stages = stack.get("telemetry_pipeline") if phase == "telemetry" else stack.get("response_pipeline")
    if not isinstance(stages, list):
        return
    original_dimensions = list(ctx.get("telemetry_dimensions", []))
    stack_dimensions = stack.get("telemetry_dimensions") if isinstance(stack.get("telemetry_dimensions"), list) and stack.get("telemetry_dimensions") else original_dimensions
    ctx["telemetry_dimensions"] = stack_dimensions
    ctx["current_stack_name"] = stack.get("name") or "Unnamed Stack"
    ctx["current_stack_modules"] = stack.get("custom_defense_modules") if isinstance(stack.get("custom_defense_modules"), list) else []
    log_start = len(ctx.get("pipeline_logs", []))
    try:
        _apply_custom_modules(ctx, ctx["current_stack_modules"], phase)
        if not ctx.get("decision"):
            _execute_pipeline(ctx, stages, phase)
    finally:
        stack_logs = list(ctx.get("pipeline_logs", [])[log_start:])
        ctx.setdefault("stack_runs", []).append({
            "id": stack.get("id") or "",
            "name": stack.get("name") or "Unnamed Stack",
            "phase": phase,
            "decision": ctx.get("decision") or "allow",
            "decision_reason": ctx.get("decision_reason") or "",
            "risk_score": int(ctx.get("risk_score", 0) or 0),
            "logs": stack_logs,
        })
        ctx["telemetry_dimensions"] = original_dimensions
        ctx.pop("current_stack_modules", None)


def _finalize_pipeline_reporting(ctx):
    telemetry = ctx.get("telemetry", {})
    telemetry["risk_score"] = int(ctx.get("risk_score", 0) or 0)
    telemetry["decision"] = ctx.get("decision") or "allow"
    telemetry["decision_reason"] = ctx.get("decision_reason") or ""
    telemetry["pipeline_logs"] = list(ctx.get("pipeline_logs", []))
    telemetry["stack_runs"] = list(ctx.get("stack_runs", []))
    telemetry["status"] = int(ctx.get("upstream_status") or ctx.get("response_status") or 0)
    telemetry["body_inspection"] = str(ctx.get("body_inspection") or "")
    telemetry["matched_rule_ids"] = list(ctx.get("matched_rule_ids") or [])
    telemetry["waf_revision"] = str(ctx.get("waf_revision") or "")
    return telemetry

def _path_matches_policy(path, patterns):
    path = str(path or "/")
    for pattern in patterns or []:
        pattern = str(pattern or "").strip()
        if not pattern:
            continue
        if pattern.endswith("/*") and (path == pattern[:-2] or path.startswith(pattern[:-1])):
            return True
        if fnmatch.fnmatchcase(path, pattern):
            return True
    return False


def _ip_matches_policy(ip, entries):
    try:
        address = ipaddress.ip_address(str(ip or "").split("%", 1)[0])
    except ValueError:
        return False
    for entry in entries or []:
        try:
            candidate = str(entry or "").strip()
            if "/" in candidate:
                if address in ipaddress.ip_network(candidate, strict=False):
                    return True
            elif address == ipaddress.ip_address(candidate):
                return True
        except ValueError:
            continue
    return False


def _rate_limit_decision(ip, path="/", policy=None):
    with _sec_lock:
        p = policy if isinstance(policy, dict) else _sec_policy
        if not p.get("rate_limit_enabled"):
            return {"allowed": True, "enforced": False, "retry_after": 0, "reason": "disabled"}
        enforcement = str(p.get("rate_limit_enforcement_mode") or "enforce").lower()
        if enforcement == "disabled":
            return {"allowed": True, "enforced": False, "retry_after": 0, "reason": "disabled"}
        exempt_paths = list(p.get("rate_limit_exempt_paths") or []) + list(p.get("rate_limit_whitelisted_paths") or [])
        if _ip_matches_policy(ip, p.get("rate_limit_bypass_ips") or []) or _path_matches_policy(path, exempt_paths):
            return {"allowed": True, "enforced": False, "retry_after": 0, "reason": "exempt"}
        now = time.time()
        try:
            rpm = max(1.0, float(p.get("rate_limit_rpm", 120) or 120))
        except (TypeError, ValueError):
            rpm = 120.0
        try:
            burst = max(1, int(p.get("rate_limit_burst", 30) or 30))
            burst = max(1, int(burst * max(0.1, float(p.get("rate_limit_burst_multiplier", 1.0) or 1.0))))
        except (TypeError, ValueError):
            burst = 30

        tokens, updated_at = _sec_rate_buckets.get(ip, (float(burst), now))
        tokens = min(float(burst), tokens + max(0.0, now - updated_at) * (rpm / 60.0))
        allowed = tokens >= 1.0
        if allowed:
            tokens -= 1.0
        _bounded_security_state_put(
            _sec_rate_buckets,
            ip,
            (tokens, now),
            SECURITY_STATE_MAX_IDENTITIES,
        )

        try:
            ab_window = max(1.0, float(p.get("auto_block_window_seconds", 60) or 60))
        except (TypeError, ValueError):
            ab_window = 60.0
        window_started, hit_count, _last_seen = _sec_ip_hits.get(ip, (now, 0, now))
        if now - window_started >= ab_window:
            window_started, hit_count = now, 0
        hit_count += 1
        _bounded_security_state_put(
            _sec_ip_hits,
            ip,
            (window_started, hit_count, now),
            SECURITY_STATE_MAX_IDENTITIES,
        )
        if not allowed:
            if p.get("auto_block_enabled"):
                threshold = max(1, int(p.get("auto_block_threshold", 50) or 50))
                if hit_count > threshold:
                    dur = max(1, int(p.get("auto_block_duration_minutes", 30) or 30))
                    _bounded_security_state_put(
                        _sec_auto_blocked,
                        ip,
                        now + (dur * 60),
                        SECURITY_STATE_MAX_IDENTITIES,
                    )
                    _sec_report_event("auto_block", ip, f"Auto-blocked: {hit_count} requests in {int(ab_window)}s", pattern="ddos")
            retry_after = max(1, int(math.ceil((1.0 - tokens) / max(rpm / 60.0, 0.001))))
            return {"allowed": enforcement != "enforce", "enforced": enforcement == "enforce", "retry_after": retry_after, "reason": "rate_limit"}
        return {"allowed": True, "enforced": False, "retry_after": 0, "reason": "allow"}


def _check_rate_limit(ip, path="/"):
    return bool(_rate_limit_decision(ip, path).get("allowed"))

def _match_security_patterns(path, ua, body_preview, headers, policy):
    path_l = (path or "").lower()
    ua_l = (ua or "").lower()
    body_l = (body_preview or "").lower()
    hdr_l = json.dumps(headers or {}, default=str).lower()

    for pattern in policy.get("suspicious_path_patterns", []) or []:
        if pattern and pattern.lower() in path_l:
            return "path", pattern
    for pattern in policy.get("suspicious_user_agents", []) or []:
        if pattern and pattern.lower() in ua_l:
            return "user-agent", pattern
    for pattern in policy.get("suspicious_payload_patterns", []) or []:
        pl = (pattern or "").lower()
        if pl and (pl in body_l or pl in path_l):
            return "payload", pattern
    for header_name in policy.get("custom_block_headers", []) or []:
        hn = str(header_name or "").lower()
        if hn and hn in hdr_l:
            return "header", header_name
    return None, None



