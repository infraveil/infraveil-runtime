class WorkspaceLocked(RuntimeError):
    def __init__(self, message, *, reasons=None, continuity_allowed=False, runtime_stop_required=True):
        super().__init__(message)
        self.reasons = tuple(sorted(str(item) for item in (reasons or []) if str(item)))
        self.continuity_allowed = bool(continuity_allowed)
        self.runtime_stop_required = bool(runtime_stop_required)


def _workspace_locked_from_response(response):
    try:
        payload = response.json()
    except Exception:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    reasons = payload.get("workspace_lock_reasons")
    if not isinstance(reasons, list):
        reasons = []
    return WorkspaceLocked(
        str(payload.get("error") or "Workspace is locked."),
        reasons=reasons,
        continuity_allowed=payload.get("billing_continuity_allowed") is True,
        runtime_stop_required=payload.get("runtime_stop_required") is not False,
    )

def _safe_int(value, default=0, min_value=None, max_value=None):
    try:
        parsed = int(float(value))
    except Exception:
        return default
    if min_value is not None:
        parsed = max(int(min_value), parsed)
    if max_value is not None:
        parsed = min(int(max_value), parsed)
    return parsed

