def _managed_caddy_dir():
    root = os.path.join(_gateway_runtime_root(), "caddy")
    os.makedirs(root, exist_ok=True)
    return root

def _managed_caddy_binary_path():
    stem, ext = os.path.splitext(_caddy_binary_filename())
    return os.path.join(_managed_caddy_dir(), f"{stem}-{MANAGED_CADDY_VERSION}{ext}")

def _platform_caddy_tags():
    system = platform.system().lower()
    machine = platform.machine().lower()
    if system.startswith("win"):
        os_tag = "windows"
    elif system == "darwin":
        os_tag = "mac"
    elif system == "linux":
        os_tag = "linux"
    else:
        os_tag = system
    if machine in ("x86_64", "amd64"):
        arch_tag = "amd64"
    elif machine in ("aarch64", "arm64"):
        arch_tag = "arm64"
    elif machine.startswith("armv7") or machine == "armv7l":
        arch_tag = "armv7"
    else:
        arch_tag = machine
    return os_tag, arch_tag

def _managed_caddy_asset_name():
    os_tag, arch_tag = _platform_caddy_tags()
    extension = "zip" if os_tag == "windows" else "tar.gz"
    return f"caddy_{MANAGED_CADDY_VERSION.lstrip('v')}_{os_tag}_{arch_tag}.{extension}"

def _sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as binary_file:
        for chunk in iter(lambda: binary_file.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

def _verified_cached_caddy_binary(target, asset_name):
    if not os.path.isfile(target):
        return ""
    expected = MANAGED_CADDY_BINARY_SHA256.get(str(asset_name or "").lower())
    if expected and hmac.compare_digest(_sha256_file(target), expected):
        return target
    report_log("[WARN] Cached managed Caddy binary is unverified or changed; replacing it from the pinned archive")
    try:
        os.remove(target)
    except Exception as exc:
        raise RuntimeError("Unverified cached Caddy binary could not be removed") from exc
    return ""

def _extract_caddy_binary(archive_bytes, asset_name, target_path):
    staging = target_path + ".download"
    if asset_name.endswith(".zip"):
        with zipfile.ZipFile(io.BytesIO(archive_bytes)) as z:
            member = next((m for m in z.namelist() if os.path.basename(m).lower() == _caddy_binary_filename().lower()), None)
            if not member:
                raise RuntimeError("Caddy binary not found in zip asset")
            with z.open(member) as src, open(staging, "wb") as dst:
                shutil.copyfileobj(src, dst)
    elif asset_name.endswith(".tar.gz") or asset_name.endswith(".tgz"):
        with tarfile.open(fileobj=io.BytesIO(archive_bytes), mode="r:gz") as t:
            member = next((m for m in t.getmembers() if os.path.basename(m.name).lower() == _caddy_binary_filename().lower() and m.isfile()), None)
            if not member:
                raise RuntimeError("Caddy binary not found in tar asset")
            with t.extractfile(member) as src, open(staging, "wb") as dst:
                shutil.copyfileobj(src, dst)
    else:
        raise RuntimeError(f"Unsupported Caddy asset format: {asset_name}")
    os.replace(staging, target_path)
    try:
        os.chmod(target_path, 0o700)
    except Exception:
        pass
    return target_path

def _verify_caddy_checksum(assets, asset_name, archive_bytes):
    checksum_url = None
    checksum_asset_name = f"caddy_{MANAGED_CADDY_VERSION.lstrip('v')}_checksums.txt"
    for asset in assets or []:
        if isinstance(asset, dict) and str(asset.get("name") or "").lower() == checksum_asset_name:
            checksum_url = asset.get("browser_download_url")
            break
    if not checksum_url:
        raise RuntimeError("Caddy release checksum asset missing; refusing to run downloaded asset")
    try:
        req = urllib.request.Request(checksum_url, headers={"User-Agent": "Infraveil-Agent"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            text = resp.read().decode("utf-8", errors="replace")
    except Exception as exc:
        raise RuntimeError("Could not download Caddy checksum asset; refusing to run downloaded asset") from exc
    expected = None
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[-1].lstrip("*") == asset_name:
            expected = parts[0].strip().lower()
            break
    if not expected:
        raise RuntimeError("Caddy release checksum entry missing; refusing to run downloaded asset")
    if len(expected) == 64:
        actual = hashlib.sha256(archive_bytes).hexdigest()
    elif len(expected) == 128:
        actual = hashlib.sha512(archive_bytes).hexdigest()
    else:
        raise RuntimeError("Unsupported Caddy checksum format; refusing to run downloaded asset")
    if not hmac.compare_digest(actual, expected):
        raise RuntimeError("Caddy binary checksum mismatch; refusing to run downloaded asset")

def _verify_caddy_pinned_digest(asset_name, archive_bytes):
    expected = MANAGED_CADDY_ARCHIVE_SHA512.get(str(asset_name or "").lower())
    if not expected:
        raise RuntimeError("Caddy asset has no vendor-pinned digest; refusing to run downloaded asset")
    actual = hashlib.sha512(archive_bytes).hexdigest()
    if not hmac.compare_digest(actual, expected):
        raise RuntimeError("Caddy vendor-pinned digest mismatch; refusing to run downloaded asset")

def _download_managed_caddy():
    target = _managed_caddy_binary_path()
    os_tag, arch_tag = _platform_caddy_tags()
    expected_asset_name = _managed_caddy_asset_name()
    cached = _verified_cached_caddy_binary(target, expected_asset_name)
    if cached:
        return cached
    api = f"https://api.github.com/repos/caddyserver/caddy/releases/tags/{MANAGED_CADDY_VERSION}"
    req = urllib.request.Request(api, headers={"User-Agent": "Infraveil-Agent"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        release = json.loads(resp.read().decode("utf-8", errors="replace"))
    if not isinstance(release, dict) or str(release.get("tag_name") or "") != MANAGED_CADDY_VERSION:
        raise RuntimeError("Pinned Caddy release tag mismatch; refusing to run downloaded asset")
    assets = release.get("assets") if isinstance(release, dict) else []
    candidates = []
    for asset in assets or []:
        if not isinstance(asset, dict):
            continue
        name = str(asset.get("name") or "").lower()
        url = asset.get("browser_download_url")
        if not url:
            continue
        if os_tag in name and arch_tag in name and (name.endswith(".zip") or name.endswith(".tar.gz") or name.endswith(".tgz")):
            candidates.append((name, url))
    if not candidates:
        raise RuntimeError(f"No Caddy release asset found for {os_tag}/{arch_tag}")
    asset_name, asset_url = candidates[0]
    report_log(f"[INFO] Downloading managed Caddy {MANAGED_CADDY_VERSION} gateway binary: {asset_name}")
    req = urllib.request.Request(asset_url, headers={"User-Agent": "Infraveil-Agent"})
    with urllib.request.urlopen(req, timeout=120) as resp:
        archive_bytes = resp.read()
    if len(archive_bytes) < 1024 * 1024:
        raise RuntimeError("Downloaded Caddy asset is unexpectedly small")
    _verify_caddy_pinned_digest(asset_name, archive_bytes)
    _verify_caddy_checksum(assets, asset_name, archive_bytes)
    installed = _extract_caddy_binary(archive_bytes, asset_name, target)
    if not _verified_cached_caddy_binary(installed, asset_name):
        raise RuntimeError("Extracted Caddy binary did not match the vendor-pinned binary digest")
    return installed

def _resolve_caddy_binary(gateway):
    configured = str((gateway or {}).get("caddy_binary") or "").strip()
    if configured:
        if os.path.isfile(configured):
            return configured
        found = shutil.which(configured)
        if found:
            return found
        raise RuntimeError(f"Configured Caddy binary not found: {configured}")
    found = shutil.which("caddy")
    if found:
        return found
    if (gateway or {}).get("bootstrap_caddy", True) is False:
        raise RuntimeError("Caddy binary not found and bootstrap_caddy is false")
    return _download_managed_caddy()

def _caddy_quote(value):
    return str(value or "").replace("\\", "\\\\").replace('"', '\\"')

def _caddy_matcher_path(pattern):
    pattern = str(pattern or "/*").strip() or "/*"
    if pattern in ("*", "/*"):
        return "/*"
    if pattern.endswith("/*"):
        return pattern
    return pattern

def _write_caddyfile(manifest, listen, upstream_port=None, edge_secret=None):
    gateway = manifest.get("gateway") if isinstance(manifest.get("gateway"), dict) else {}
    routes, services = _gateway_routes_and_services(manifest)
    root = _gateway_runtime_root()
    caddyfile = os.path.join(root, "Caddyfile")
    log_path = os.path.join(root, "caddy_access.jsonl")
    lines = [
        "{",
        "    admin off",
        "    auto_https off",
        "    persist_config off",
        "}",
        "",
        f":{int(listen)} " + "{",
        "    encode zstd gzip",
        "    log {",
        f"        output file \"{_caddy_quote(log_path)}\"",
        "        format json",
        "    }",
    ]
    if upstream_port:
        lines.extend([
            "    handle {",
            f"        reverse_proxy 127.0.0.1:{int(upstream_port)} " + "{",
            "            header_up X-Forwarded-For {http.request.remote.host}",
            (f"            header_up X-Infraveil-Edge \"{_caddy_quote(edge_secret)}\"" if edge_secret else "            header_up -X-Infraveil-Edge"),
            "        }",
            "    }",
            "}",
            "",
        ])
        with open(caddyfile, "w", encoding="utf-8") as f:
            f.write("\n".join(lines))
        return caddyfile, log_path
    emitted_default = False
    for idx, route in enumerate([r for r in routes if isinstance(r, dict)]):
        svc = services.get(str(route.get("service")))
        port = _safe_int(svc.get("port") if svc else None, 0, 1, 65535)
        if not port:
            continue
        pattern = _caddy_matcher_path(route.get("path"))
        upstream = f"127.0.0.1:{port}"
        if pattern in ("*", "/*"):
            lines.extend([
                "    handle {",
                f"        reverse_proxy {upstream}",
                "    }",
            ])
            emitted_default = True
        else:
            matcher = f"route{idx}"
            lines.extend([
                f"    @{matcher} path {pattern}",
                f"    handle @{matcher} " + "{",
                f"        reverse_proxy {upstream}",
                "    }",
            ])
    if not emitted_default and services:
        first = next(iter(services.values()))
        port = _safe_int(first.get("port"), 0, 1, 65535)
        if port:
            lines.extend([
                "    handle {",
                f"        reverse_proxy 127.0.0.1:{port}",
                "    }",
            ])
    lines.extend([
        "    respond \"Route target is not running.\" 502",
        "}",
        "",
    ])
    with open(caddyfile, "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    return caddyfile, log_path

def _stream_gateway_process_output(proc, log_path):
    def pump(stream, prefix):
        try:
            for raw in iter(stream.readline, b""):
                if not raw:
                    break
                line = raw.decode("utf-8", errors="replace").strip()
                if line:
                    report_log("[PROCESS_EVENT] " + json.dumps({"realm": "runtime", "service": "runtime-gateway", "runtime": "caddy", "stream": prefix, "level": "info", "message": line}, separators=(",", ":")))
        except Exception:
            pass
    threading.Thread(target=pump, args=(proc.stdout, "stdout"), daemon=True).start()
    threading.Thread(target=pump, args=(proc.stderr, "stderr"), daemon=True).start()

def _stop_gateway_process():
    global _gateway_process
    proc = _gateway_process
    _gateway_process = None
    if not proc:
        return
    try:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except Exception:
                proc.kill()
    except Exception:
        pass

def _find_free_loopback_port():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.bind(("127.0.0.1", 0))
        return int(s.getsockname()[1])
    finally:
        try:
            s.close()
        except Exception:
            pass

def _wait_for_local_port(port, timeout=15):
    deadline = time.time() + timeout
    while time.time() < deadline:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(0.5)
        try:
            s.connect(("127.0.0.1", int(port)))
            return True
        except Exception:
            time.sleep(0.2)
        finally:
            try:
                s.close()
            except Exception:
                pass
    return False

def _run_caddy_gateway(
    manifest,
    listen,
    generation,
    require_runtime_policy=False,
    policy_timeout=SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS,
):
    global _gateway_process
    if require_runtime_policy:
        policy_source = _wait_for_runtime_security_policy(timeout=policy_timeout)
        report_log(f"[INFO] Managed Caddy gateway startup policy gate satisfied by {policy_source}.")
    gateway = manifest.get("gateway") if isinstance(manifest.get("gateway"), dict) else {}
    caddy_bin = _resolve_caddy_binary(gateway)
    inner_port = _find_free_loopback_port()
    edge_secret = os.urandom(24).hex()
    inner_thread = threading.Thread(
        target=_run_aiohttp_gateway,
        args=(manifest, inner_port, generation),
        kwargs={
            "bind_host": "127.0.0.1",
            "edge_secret": edge_secret,
            "require_runtime_policy": require_runtime_policy,
            "policy_timeout": policy_timeout,
        },
        daemon=True,
    )
    inner_thread.start()
    if not _wait_for_local_port(inner_port, timeout=15):
        raise RuntimeError(f"Inner security gateway failed to start on 127.0.0.1:{inner_port}")
    report_log(f"[INFO] Infraveil security gateway (aiohttp) listening on 127.0.0.1:{inner_port} behind managed Caddy.")
    caddyfile, log_path = _write_caddyfile(manifest, listen, upstream_port=inner_port, edge_secret=edge_secret)
    env = os.environ.copy()
    env["INFRAVEIL_CLIENT_ID"] = CLIENT_ID
    env["INFRAVEIL_AGENT_ID"] = AGENT_ID
    env["INFRAVEIL_LAUNCHER_HOST_ID"] = LAUNCHER_HOST_ID
    env["INFRAVEIL_RUNTIME_OWNER"] = "agent-gateway"
    runtime_root = _gateway_runtime_root()
    env["XDG_CONFIG_HOME"] = os.path.join(runtime_root, "xdg_config")
    env["XDG_DATA_HOME"] = os.path.join(runtime_root, "xdg_data")
    os.makedirs(env["XDG_CONFIG_HOME"], exist_ok=True)
    os.makedirs(env["XDG_DATA_HOME"], exist_ok=True)
    popen_kwargs = {
        "args": [caddy_bin, "run", "--config", caddyfile, "--adapter", "caddyfile"],
        "cwd": runtime_root,
        "env": env,
        "stdout": subprocess.PIPE,
        "stderr": subprocess.PIPE,
    }
    if os.name == "nt":
        popen_kwargs["creationflags"] = getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0) | getattr(subprocess, "CREATE_NO_WINDOW", 0)
    else:
        popen_kwargs["start_new_session"] = True
    proc = subprocess.Popen(**popen_kwargs)
    _gateway_process = proc
    _stream_gateway_process_output(proc, log_path)
    report_log(f"[INFO] Infraveil managed Caddy gateway listening on port {listen}.")
    try:
        while not _shutdown and generation == _service_generation and proc.poll() is None:
            time.sleep(0.5)
        if proc.poll() is not None and not _shutdown and generation == _service_generation:
            raise RuntimeError(f"Managed Caddy gateway exited with code {proc.returncode}")
    finally:
        _stop_gateway_process()

def run_external_process_mode(zip_bytes, manifest):
    global _payload_thread, _payload_mode, _gateway_thread, _shutdown
    global _service_processes, _service_specs, _service_restart_counts, _service_restart_windows
    global _service_health_specs, _service_health_failures, _service_output_tail
    global _external_service_specs, _service_generation, _current_payload_started_at, _current_manifest_summary

    previous_gateway = _gateway_thread if hasattr(_gateway_thread, "is_alive") else None
    _payload_mode = "restarting"
    _shutdown = True
    _service_generation += 1
    _stop_service_processes()
    if previous_gateway and previous_gateway.is_alive():
        try:
            previous_gateway.join(timeout=3)
        except Exception:
            pass
    _shutdown = False
    _payload_thread = None
    _gateway_thread = None
    generation = _service_generation

    workspace = _payload_workspace()
    _remove_path(workspace)
    with zipfile.ZipFile(io.BytesIO(zip_bytes)) as z:
        _safe_extract_zip(z, workspace)

    _service_processes = {}
    _service_specs = {}
    _service_restart_counts = {}
    _service_restart_windows = {}
    _service_health_specs = {}
    _service_health_failures = {}
    _service_output_tail = {}
    _external_service_specs = {}
    _current_manifest_summary = _summarize_manifest(manifest)
    _current_payload_started_at = time.time()

    for raw_service in manifest.get("services", []):
        spec = _validated_external_service_spec(raw_service)
        name = spec["name"]
        if name in _external_service_specs:
            raise RuntimeError(f"Duplicate external service name: {name}")
        _external_service_specs[name] = spec
        _service_health_specs[name] = dict(spec)
        _service_health_failures[name] = 0
        report_log(
            f"[INFO] Observing external service [{name}] via systemd unit {spec['unit']} "
            f"and health http://127.0.0.1:{spec['port']}{spec['health']}"
        )

    if not _external_service_specs:
        raise RuntimeError("External-process manifest requires at least one service")

    health_deadline = time.time() + 30
    while True:
        unhealthy = []
        for name, spec in list(_external_service_specs.items()):
            status = _external_service_status(spec)
            if not status.get("healthy"):
                unhealthy.append(f"{name}:{status.get('active_state')}/{status.get('health_reason')}")
        if not unhealthy:
            break
        if time.time() >= health_deadline:
            raise RuntimeError("External services failed startup health gate: " + ", ".join(unhealthy))
        time.sleep(0.5)

    _append_local_audit("external_manifest_loaded", **_current_manifest_summary)
    for name, spec in list(_external_service_specs.items()):
        threading.Thread(
            target=_tail_external_systemd_logs,
            args=(name, spec, generation),
            daemon=True,
        ).start()
    threading.Thread(target=_health_monitor_loop, args=(generation,), daemon=True).start()
    gateway = manifest.get("gateway") if isinstance(manifest.get("gateway"), dict) else {}
    if gateway.get("enabled", True) is not False:
        listen = _safe_int(gateway.get("listen") or manifest.get("listen") or 18443, 18443, 1, 65535)
        bind_host = str(gateway.get("bind_host") or "127.0.0.1").strip()
        if bind_host not in {"127.0.0.1", "::1"}:
            raise RuntimeError("External-process gateway must bind to loopback")
        gateway_ready = threading.Event()
        gateway_failure = []
        def external_gateway_target():
            try:
                _run_aiohttp_gateway(
                    manifest,
                    listen,
                    generation,
                    bind_host=bind_host,
                    ready_event=gateway_ready,
                    require_runtime_policy=True,
                    policy_timeout=SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS,
                )
            except Exception as exc:
                gateway_failure.append(str(exc))
                report_exception(traceback.format_exc(), label="[EXTERNAL_GATEWAY_CRASH]")
        _gateway_thread = threading.Thread(target=external_gateway_target, daemon=True)
        _gateway_thread.start()
        startup_deadline = time.monotonic() + SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS + GATEWAY_BIND_STARTUP_TIMEOUT_SECONDS
        while not gateway_ready.is_set() and not gateway_failure and _gateway_thread.is_alive():
            remaining = startup_deadline - time.monotonic()
            if remaining <= 0:
                break
            gateway_ready.wait(timeout=min(0.1, remaining))
        if not gateway_ready.is_set():
            detail = gateway_failure[-1] if gateway_failure else "gateway did not bind before timeout"
            raise RuntimeError(f"External traffic gateway failed startup gate: {detail}")
        report_log(f"[INFO] External service traffic gateway active at {bind_host}:{listen}.")
    _payload_thread = "DETACHED_OK"
    _payload_mode = "external-process"
    _mark_payload_detached("existing systemd services are observed without transferring process ownership")

def run_payload_process_mode(zip_bytes, manifest):
    global _payload_thread, _payload_mode, _gateway_thread, _shutdown, _service_processes, _service_specs, _service_restart_counts, _service_restart_windows, _service_health_specs, _service_health_failures, _service_output_tail, _external_service_specs, _service_generation, _current_payload_started_at, _current_manifest_summary
    previous_thread = _gateway_thread if hasattr(_gateway_thread, "is_alive") else (_payload_thread if hasattr(_payload_thread, "is_alive") else None)
    _payload_mode = "restarting"
    _shutdown = True
    _service_generation += 1
    _stop_service_processes()
    if previous_thread and previous_thread.is_alive():
        try:
            previous_thread.join(timeout=3)
        except Exception:
            pass
    _shutdown = False
    _payload_thread = None
    _gateway_thread = None
    generation = _service_generation
    workspace = _payload_workspace()
    _remove_path(workspace)
    with zipfile.ZipFile(io.BytesIO(zip_bytes)) as z:
        _safe_extract_zip(z, workspace)
    _mount_persistent_paths(manifest, workspace)
    gateway = manifest.get("gateway") if isinstance(manifest.get("gateway"), dict) else {}
    gateway_enabled = gateway.get("enabled", True) is not False
    if gateway_enabled:
        try:
            policy_source = _wait_for_runtime_security_policy(timeout=SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS)
            report_log(f"[INFO] Managed gateway startup policy gate satisfied by {policy_source}.")
        except Exception as policy_exc:
            _payload_mode = "idle"
            _stop_service_processes()
            message = f"Managed traffic gateway failed startup policy gate; refusing to bind: {policy_exc}"
            report_error(message, label="[MANAGED_GATEWAY_POLICY_GATE_FAILED]")
            raise RuntimeError(message) from policy_exc
    manifest = _allocate_runtime_ports(manifest)
    base_env = _service_env(manifest)
    _service_specs = {}
    _service_restart_windows = {name: [ts for ts in stamps if time.time() - float(ts) < SERVICE_RESTART_WINDOW_SECONDS]
        for name, stamps in _service_restart_windows.items()}
    _service_restart_counts = {name: len(stamps) for name, stamps in _service_restart_windows.items()}
    _service_health_specs = {}
    _service_health_failures = {}
    _service_output_tail = {}
    _external_service_specs = {}
    _current_manifest_summary = _summarize_manifest(manifest)
    _append_local_audit("manifest_loaded", **_current_manifest_summary)
    _current_payload_started_at = time.time()
    for svc in manifest.get("services", []):
        if not isinstance(svc, dict):
            continue
        name = str(svc.get("name") or "service")
        env = _merge_service_env(base_env, svc.get("env"))
        _svc_port = svc.get("port")
        if _svc_port not in (None, ""):
            env.setdefault("PORT", str(_svc_port))
            env.setdefault("INFRAVEIL_PORT", str(_svc_port))
        cwd = os.path.abspath(os.path.join(workspace, str(svc.get("cwd") or ".")))
        if not _is_within(workspace, cwd):
            raise RuntimeError(f"Unsafe service cwd rejected: {name}")
        _run_manifest_command("Installing", name, svc.get("install"), cwd, env, str(svc.get("runtime", "generic")))
        _run_manifest_command("Building", name, svc.get("build"), cwd, env, str(svc.get("runtime", "generic")))
        start = str(svc.get("start") or "").strip()
        if not start:
            raise RuntimeError(f"Service {name} missing start command")
        runtime = str(svc.get("runtime", "generic"))
        cwd, start = _resolve_service_layout(svc, workspace, cwd, start, runtime)
        _service_specs[name] = {"runtime": runtime, "start": start, "cwd": cwd, "env": env, "restart": str(svc.get("restart", "always")).lower(), "started_at": time.time()}
        _service_health_specs[name] = {
            "port": svc.get("port"),
            "health": svc.get("health"),
            "started_at": time.time(),
        }
        if _start_service_process(name, runtime, start, cwd, env) is None:
            raise RuntimeError(f"Required service {name} failed to start")

    gateway = manifest.get("gateway") if isinstance(manifest.get("gateway"), dict) else {}
    gateway_enabled = gateway.get("enabled", True) is not False
    if not gateway_enabled:
        _payload_thread = "DETACHED_OK"
        _payload_mode = "process"
        threading.Thread(target=_health_monitor_loop, args=(_service_generation,), daemon=True).start()
        _mark_payload_detached("manifest process mode is supervised by the service monitor; managed gateway is disabled")
        return

    listen = int(gateway.get("listen") or manifest.get("listen") or 18443)
    gateway_engine = str(gateway.get("engine") or gateway.get("mode") or "aiohttp").strip().lower()

    def target():
        global _service_generation
        server = None
        try:
            if gateway_engine in ("caddy", "managed-caddy"):
                try:
                    _run_caddy_gateway(
                        manifest,
                        listen,
                        generation,
                        require_runtime_policy=True,
                        policy_timeout=SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS,
                    )
                    return
                except Exception as caddy_exc:
                    report_error(f"Managed Caddy gateway unavailable; falling back to aiohttp: {caddy_exc}", label="[GATEWAY_FALLBACK]")
                    _run_aiohttp_gateway(
                        manifest,
                        listen,
                        generation,
                        require_runtime_policy=True,
                        policy_timeout=SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS,
                    )
                    return
            if gateway_engine in ("aiohttp", "async", "streaming"):
                _run_aiohttp_gateway(
                    manifest,
                    listen,
                    generation,
                    require_runtime_policy=True,
                    policy_timeout=SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS,
                    listen_socket=_agent_runtime_ports.listener("gateway"),
                )
                return
            report_log(f"[WARN] Gateway engine {gateway_engine!r} is not security-equivalent; using the hardened aiohttp gateway.")
            _run_aiohttp_gateway(
                manifest,
                listen,
                generation,
                require_runtime_policy=True,
                policy_timeout=SECURITY_POLICY_STARTUP_TIMEOUT_SECONDS,
                listen_socket=_agent_runtime_ports.listener("gateway"),
            )
        except Exception as exc:
            _record_runtime_failure(exc)
            report_exception(traceback.format_exc(), label="[GATEWAY_CRASH]")
        finally:
            if server is not None:
                try:
                    server.close()
                except Exception:
                    pass
            if generation == _service_generation:
                # The gateway owns this shutdown. Invalidate service watchers
                # before killing children so they do not resurrect an unserved app.
                _service_generation += 1
                _stop_service_processes()
    _gateway_thread = threading.Thread(target=target, daemon=True)
    _gateway_thread.start()
    _payload_thread = "DETACHED_OK"
    _payload_mode = "process"
    threading.Thread(target=_health_monitor_loop, args=(generation,), daemon=True).start()
    _mark_payload_detached("manifest process mode is supervised by the gateway and service monitor")

def run_payload_package(zip_bytes, recovery_repair=False):
    global _payload_thread, _payload_mode, _shutdown, _payload_detached_ok, _payload_detached_note, _current_payload_started_at, _current_manifest_summary
    global _runtime_package_hash, _service_generation

    package_hash = hashlib.sha256(zip_bytes).hexdigest()
    with _runtime_recovery_lock:
        if not recovery_repair and (package_hash in _runtime_rejected_hashes or
                (package_hash == _runtime_package_hash and _runtime_recovery.get("phase") == "blocked")):
            _payload_thread = "RECOVERY_BLOCKED"
            _payload_mode = "failed"
            raise RuntimeError("Automatic retries are paused for this package. Correct the failure and explicitly restart or publish a new package.")
        if package_hash != _runtime_package_hash and not recovery_repair:
            _runtime_recovery.clear()
        if package_hash != _runtime_package_hash or recovery_repair:
            _service_restart_windows.clear()
            _service_restart_counts.clear()
        _runtime_package_hash = package_hash
        _persist_runtime_recovery()

    _shutdown = True

    _stop_service_processes()

    _shutdown = False
    _payload_thread = None
    _payload_detached_ok = False
    _payload_detached_note = ""
    _current_payload_started_at = time.time()

    try:
        with zipfile.ZipFile(io.BytesIO(zip_bytes)) as z:
            names = z.namelist()
            report_log(f"[BOOT] ZIP entries: {', '.join(names[:25])}")
            if "infraveil.json" not in names:
                raise RuntimeError("Payload package missing infraveil.json. Infraveil now runs manifest-defined supervised services only.")
            try:
                parsed_manifest = json.loads(z.read("infraveil.json").decode("utf-8"))
            except Exception as exc:
                raise RuntimeError(f"Invalid infraveil.json manifest: {exc}")
        if not isinstance(parsed_manifest, dict):
            raise RuntimeError("Invalid infraveil.json manifest: root must be an object")
        manifest = parsed_manifest
        services = manifest.get("services") if isinstance(manifest.get("services"), list) else []
        if not services:
            raise RuntimeError("Invalid infraveil.json manifest: at least one supervised service is required")
        report_log("[INFO] Runtime manifest loaded: infraveil.json")
        manifest_env = manifest.get("env") if isinstance(manifest.get("env"), dict) else {}
        for k, v in manifest_env.items():
            if isinstance(v, str) and v.startswith("infraveil:secret:"):
                continue
            if str(k).upper().startswith("INFRAVEIL_"):
                continue
            os.environ[str(k)] = str(v)
        _current_manifest_summary = _summarize_manifest(manifest)
        _append_local_audit("manifest_loaded", **_current_manifest_summary)
        if str(manifest.get("mode") or "process").strip().lower() == "external-process":
            report_log("[INFO] Runtime manifest selected external systemd observation mode.")
            run_external_process_mode(zip_bytes, manifest)
        else:
            report_log("[INFO] Runtime manifest selected supervised process mode.")
            run_payload_process_mode(zip_bytes, manifest)

    except Exception as exc:
        _record_runtime_failure(exc, component="runtime-startup")
        report_exception(traceback.format_exc())
        # A later manifest service can fail after earlier children started.
        # Invalidate their watchers before stopping the incomplete owned runtime.
        _service_generation += 1
        _stop_service_processes()
        _payload_thread = None
        _payload_mode = "idle"
        _payload_detached_ok = False
        _payload_detached_note = ""
        raise
    return True

def cleanup_old_logs():
    # Writers already rotate this agent's bounded log. Startup must not erase
    # the failure we are investigating, or another workload's runtime evidence.
    return

def _enter_workspace_locked_idle(reason):
    global _payload_thread, _payload_mode, _gateway_thread, _payload_detached_ok, _payload_detached_note, _shutdown, _service_generation, _current_payload_started_at
    reason_text = str(reason or "workspace locked")
    continuity_allowed = bool(
        isinstance(reason, WorkspaceLocked)
        and reason.continuity_allowed
        and not reason.runtime_stop_required
        and set(reason.reasons) == {"billing_required"}
    )
    if continuity_allowed and _payload_mode != "idle" and (_service_processes or _external_service_specs):
        _write_boot_log(f"[LOCKED] {reason_text}; continuity mode — keeping current services running, pausing new deploys")
        _append_local_audit("workspace_locked_continuity", reason=reason_text, payload_hash=_current_payload_hash)
        _set_control_plane_status(True, "workspace locked (continuity)")
        report_log("[INFO] Workspace is billing-locked. Continuity mode is on: your current services keep running; new deploys are paused until billing is active.")
        for _ in range(max(1, int(max(INTERVAL, 30)))):
            if _shutdown:
                break
            time.sleep(1)
        return
    _write_boot_log(f"[LOCKED] {reason_text}; stopping local services and holding agent online")
    _append_local_audit("workspace_locked_idle", reason=reason_text, payload_hash=_current_payload_hash)
    try:
        _shutdown = True
        _service_generation += 1
        _stop_service_processes()
    finally:
        _shutdown = False
    _payload_thread = None
    _payload_mode = "idle"
    _gateway_thread = None
    _payload_detached_ok = False
    _payload_detached_note = ""
    _current_payload_started_at = None
    _set_control_plane_status(True, "workspace locked")
    report_log("[INFO] Workspace locked by control plane; agent is idle and will retry without exiting.")
    for _ in range(max(1, int(max(INTERVAL, 30)))):
        if _shutdown:
            break
        time.sleep(1)

def main():
    ensure_dependencies()
    global _payload_thread, _payload_mode, _gateway_thread, _payload_detached_ok, _payload_detached_note
    global _current_payload_hash, _current_payload_vendor_sig, _current_payload_approval_sig, _last_payload_reconcile, _current_payload_started_at

    if sys.platform.startswith("linux"):
        _enable_linux_child_subreaper()
    cleanup_old_logs()
    _load_audit_chain()
    _append_local_audit("agent_started", version=AGENT_VERSION, source_hash=_agent_source_hash(), host_fingerprint=_host_fingerprint())
    _restore_runtime_recovery()
    cached, cached_meta = _load_cached_payload_version()
    if cached and not _runtime_recovery and _payload_thread != "RECOVERY_BLOCKED":
        try:
            report_log("[INFO] Bootstrapping from cached payload while control plane sync initializes")
            run_payload_package(cached)
            _activate_cached_payload_identity(cached_meta)
        except Exception:
            report_exception(traceback.format_exc(), label="[CACHE_BOOT_FAILED]")

    while not _shutdown:
        try:
            _sync_security_policy()
            try:
                heartbeat()
                _set_control_plane_status(True, "heartbeat ok")
            except WorkspaceLocked as locked_exc:
                _enter_workspace_locked_idle(locked_exc)
                continue
            except Exception as hb_exc:
                _set_control_plane_status(False, str(hb_exc))

            if _payload_thread == "RECOVERY_BLOCKED":
                # Stay reachable, keep reporting the latched fault, and allow a
                # genuinely changed approved package. Time alone never rearms it.
                try:
                    desired_hash = _server_payload_hash()
                    if desired_hash and desired_hash != _runtime_package_hash and desired_hash not in _runtime_rejected_hashes:
                        data = fetch_payload()
                        run_payload_package(data)
                        _activate_staged_payload_identity(data)
                except WorkspaceLocked as locked_exc:
                    _enter_workspace_locked_idle(locked_exc)
                except Exception as exc:
                    _set_control_plane_status(False, str(exc))
                time.sleep(INTERVAL)
                continue

            if _payload_thread is not None:
                _evaluate_runtime_candidate_stability()
                if _payload_thread == "RECOVERY_BLOCKED":
                    continue
                _now = time.time()
                if _now - _last_payload_reconcile >= PAYLOAD_RECONCILE_INTERVAL:
                    _last_payload_reconcile = _now
                    try:
                        _srv_hash = _server_payload_hash()
                        if _srv_hash and _srv_hash != _current_payload_hash and _srv_hash not in _runtime_rejected_hashes:
                            report_log(f"[INFO] Control-plane payload changed ({(_current_payload_hash or 'none')[:8]} -> {_srv_hash[:8]}); fetching fresh and redeploying")
                            _data = fetch_payload()
                            _candidate_hash = hashlib.sha256(_data).hexdigest()
                            run_payload_package(_data)
                            _activate_staged_payload_identity(_data)
                            continue
                    except WorkspaceLocked as _locked:
                        _enter_workspace_locked_idle(_locked)
                        continue
                    except Exception as _rec_exc:
                        failed_hash = locals().get("_candidate_hash", "") or _current_payload_hash
                        try:
                            _activate_last_known_good_after_candidate_failure(failed_hash)
                        except Exception as _rollback_exc:
                            report_exception(traceback.format_exc(), label="[PAYLOAD_RECONCILE_ROLLBACK_FAILED]")
                        _set_control_plane_status(False, f"reconcile failed: {_rec_exc}")
                        time.sleep(min(INTERVAL, 5))
                        continue

            if _payload_thread is None:
                recovery_attempts_before = int(_runtime_recovery.get("attempts", 0))
                try:
                    data = fetch_payload()
                    _set_control_plane_status(True, "payload fetched")
                    run_payload_package(data)
                    _activate_staged_payload_identity(data)
                except WorkspaceLocked as locked_exc:
                    _enter_workspace_locked_idle(locked_exc)
                    continue
                except Exception as fetch_exc:
                    _set_control_plane_status(False, str(fetch_exc))
                    failure_count = _record_payload_failure()
                    if _runtime_recovery:
                        if int(_runtime_recovery.get("attempts", 0)) == recovery_attempts_before:
                            _record_runtime_failure(fetch_exc, component="payload-delivery")
                        _recover_managed_runtime()
                        continue
                    if failure_count >= PAYLOAD_FAILURE_MAX_ATTEMPTS:
                        _record_runtime_failure(fetch_exc, component="payload-delivery")
                        _recover_managed_runtime()
                        continue
                    cached, cached_meta = _load_cached_payload_version()
                    if cached:
                        report_log(f"[WARN] Reloading last known good payload {cached_meta.get('payload_hash', 'unknown')} after fetch failure ({failure_count}/{PAYLOAD_FAILURE_MAX_ATTEMPTS})")
                        run_payload_package(cached)
                        _activate_cached_payload_identity(cached_meta)
                    else:
                        time.sleep(_control_plane_backoff)
                        continue
            if _payload_thread == "DETACHED_OK":
                if _payload_mode == "external-process":
                    # External services remain systemd-owned. An unhealthy or stopped
                    # unit is telemetry, not a reason to churn the observer agent.
                    time.sleep(INTERVAL)
                    continue
                if _payload_mode == "process":
                    if _runtime_recovery.get("phase") == "blocked":
                        _recover_managed_runtime()
                        continue
                    gateway_required = _current_manifest_summary.get("gateway_enabled", True) is not False
                    gateway_alive = (not gateway_required) or bool(_gateway_thread and _gateway_thread.is_alive())
                    # The per-service watcher owns exit recovery and its retry
                    # budget. Zero live children is normal during backoff or
                    # after the budget is exhausted; it is not a reason for a
                    # second supervisor to tear down the whole runtime.
                    if gateway_alive and _service_specs:
                        if _runtime_recovery and _runtime_candidate_is_healthy() and time.time() - _current_payload_started_at >= 120:
                            with _runtime_recovery_lock:
                                _runtime_recovery.clear()
                                _persist_runtime_recovery()
                            report_log("[RUNTIME_RECOVERED] Runtime has remained healthy for 120 seconds.")
                        time.sleep(INTERVAL)
                        continue
                    _recover_managed_runtime()
                    continue
                if not _has_live_service_processes() and not _has_live_payload_children():
                    note = _payload_detached_note or "daemonized/background payload is no longer running"
                    _payload_thread = None
                    _payload_mode = "idle"
                    _payload_detached_ok = False
                    _payload_detached_note = ""
                    report_thread_exit_failure(note)
                    continue
                time.sleep(INTERVAL)
                continue
            if _payload_thread and _payload_thread != "DETACHED_OK" and not _payload_thread.is_alive():
                _payload_thread = None
                report_thread_exit_failure("Payload thread exited")
                continue
            time.sleep(INTERVAL)
        except Exception as e:
            tb = traceback.format_exc()
            report_exception(tb, label="[AGENT_LOOP_CRASH]")
            failure_count = _record_payload_failure()
            gateway_alive = bool(_gateway_thread and _gateway_thread.is_alive())
            if _payload_thread == "DETACHED_OK" and (_payload_mode == "external-process" or gateway_alive):
                # A control-loop/network failure is not authority to kill a
                # healthy managed runtime or an externally owned systemd service.
                time.sleep(_control_plane_backoff)
                continue
            _record_runtime_failure(e, component="agent-loop")
            _recover_managed_runtime()

def _shutdown_handler(signum, *_):
    global _shutdown
    _shutdown = True
    _append_local_audit("agent_shutdown", signal=signum, payload_hash=_current_payload_hash)

    report_error(f"Signal {signum} received; agent shutting down.", send_console=False, label="[SIGNAL]")

    _stop_service_processes()

    try:
        import psutil
        parent = psutil.Process(os.getpid())
        children = parent.children(recursive=True)
        for child in children:
            try:
                child.kill()
            except Exception:
                pass
        gone, alive = psutil.wait_procs(children, timeout=2)
        for proc in alive:
            try:
                proc.kill()
            except Exception:
                pass
    except Exception:
        pass
    os._exit(0)

signal.signal(signal.SIGINT, _shutdown_handler)
signal.signal(signal.SIGTERM, _shutdown_handler)

if __name__ == "__main__":
    main()
