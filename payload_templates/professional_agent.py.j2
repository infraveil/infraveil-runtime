_SENSITIVE_HEADER_KEYS = {
    "authorization", "proxy-authorization", "cookie", "set-cookie",
    "x-api-key", "x-auth-token", "x-session-token", "x-csrf-token", "x-amz-security-token",
}
_SENSITIVE_LOG_KEYS = _SENSITIVE_HEADER_KEYS | {
    "api-key", "apikey", "access-token", "refresh-token", "id-token", "auth-token", "token",
    "nonce", "password", "passwd", "pwd", "client-secret", "api-secret", "secret",
}
_LOG_SECRET_KEY_PATTERN = (
    r"authorization|proxy[-_ ]authorization|x[-_ ]api[-_ ]key|api[-_ ]?key|apikey|"
    r"x[-_ ]auth[-_ ]token|x[-_ ]session[-_ ]token|x[-_ ]csrf[-_ ]token|"
    r"x[-_ ]amz[-_ ]security[-_ ]token|access[-_ ]token|refresh[-_ ]token|id[-_ ]token|"
    r"auth[-_ ]token|token|nonce|password|passwd|pwd|client[-_ ]secret|api[-_ ]secret|secret"
)
_LOG_QUOTED_SECRET_RE = re.compile(
    rf"(?i)(?P<prefix>(?<![\w-])[\"']?(?:cookie|set[-_ ]cookie|{_LOG_SECRET_KEY_PATTERN})[\"']?\s*[:=]\s*)"
    rf"(?P<quote>[\"'])(?P<value>.*?)(?P=quote)"
)
_LOG_UNQUOTED_SECRET_RE = re.compile(
    rf"(?i)(?P<prefix>(?<![\w-])(?:{_LOG_SECRET_KEY_PATTERN})\s*[:=]\s*)"
    r"(?P<scheme>(?:bearer|basic|digest|token)\s+)?(?P<value>[^\s,;]+)"
)
_LOG_COOKIE_HEADER_RE = re.compile(r"(?i)(?P<prefix>\b(?:cookie|set-cookie)\s*:\s*)(?P<value>[^\r\n]+)")
_LOG_COOKIE_PAIR_RE = re.compile(
    r"(?i)(?P<prefix>(?:^|[;,]\s*)[^=;,\s]+\s*=\s*)(?P<value>\"[^\"]*\"|'[^']*'|[^;,\s]*)"
)
_LOG_BARE_AUTH_RE = re.compile(r"(?i)\b(?P<scheme>bearer|basic|digest|token)\s+(?P<value>[A-Za-z0-9._~+/=-]{4,})")

def _redact_sensitive_text(value):
    text = str(value or "")

    def redact_quoted(match):
        return f"{match.group('prefix')}{match.group('quote')}[REDACTED]{match.group('quote')}"

    def redact_cookie_header(match):
        value_text = _LOG_COOKIE_PAIR_RE.sub(
            lambda pair: f"{pair.group('prefix')}[REDACTED]",
            match.group("value"),
        )
        return f"{match.group('prefix')}{value_text}"

    def redact_unquoted(match):
        return f"{match.group('prefix')}{match.group('scheme') or ''}[REDACTED]"

    text = _LOG_QUOTED_SECRET_RE.sub(redact_quoted, text)
    text = _LOG_COOKIE_HEADER_RE.sub(redact_cookie_header, text)
    text = _LOG_UNQUOTED_SECRET_RE.sub(redact_unquoted, text)
    return _LOG_BARE_AUTH_RE.sub(lambda match: f"{match.group('scheme')} [REDACTED]", text)

def _redact_log_value(value, key=""):
    normalized_key = re.sub(r"[^a-z0-9]+", "-", str(key or "").strip().lower()).strip("-")
    sensitive_suffixes = ("token", "secret", "password", "passwd", "passphrase", "nonce", "cookie", "credential", "private-key", "encryption-key")
    if normalized_key in _SENSITIVE_LOG_KEYS or normalized_key in sensitive_suffixes or any(normalized_key.endswith("-" + suffix) for suffix in sensitive_suffixes):
        return "[REDACTED]"
    if isinstance(value, dict):
        return {item_key: _redact_log_value(item_value, item_key) for item_key, item_value in value.items()}
    if isinstance(value, list):
        return [_redact_log_value(item) for item in value]
    if isinstance(value, tuple):
        return tuple(_redact_log_value(item) for item in value)
    if isinstance(value, str):
        return _redact_sensitive_text(value)
    return value

def _redact_runtime_log_message(message):
    text = str(message or "")
    prefix = "[PROCESS_EVENT] "
    if text.startswith(prefix):
        try:
            event = json.loads(text[len(prefix):].strip())
            if isinstance(event, dict):
                return prefix + json.dumps(_redact_log_value(event), separators=(",", ":"))
        except Exception:
            pass
    return _redact_sensitive_text(text)

def _write_boot_log(msg):
    global _boot_log_write_count
    try:
        msg = _redact_runtime_log_message(msg)
        ts = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
        _boot_log_write_count += 1
        if _boot_log_write_count % 50 == 0:
            try:
                if os.path.exists(BOOT_LOG) and os.path.getsize(BOOT_LOG) > _BOOT_LOG_MAX_BYTES:
                    os.replace(BOOT_LOG, BOOT_LOG + ".1")
            except Exception:
                pass
        with open(BOOT_LOG, "a", encoding="utf-8") as f:
            f.write(f"{ts} {msg}\\n")
    except Exception:
        pass

def _load_audit_chain():
    global _audit_chain_head, _audit_chain_seq
    head_error = None
    try:
        if os.path.exists(AUDIT_HEAD_PATH):
            with open(AUDIT_HEAD_PATH, encoding="utf-8") as head_file:
                d = json.load(head_file)
            candidate_head = str(d.get("head", "") or "")
            candidate_seq = int(d.get("seq", 0) or 0)
            head_shape_valid = (
                (candidate_seq == 0 and candidate_head == "")
                or (candidate_seq > 0 and re.fullmatch(r"[0-9a-f]{64}", candidate_head))
            )
            if candidate_seq < 0 or not head_shape_valid:
                raise ValueError("audit head has invalid sequence or hash")
            _audit_chain_head = candidate_head
            _audit_chain_seq = candidate_seq
    except Exception as exc:
        head_error = exc

    audit_paths = []
    rotated_path = AUDIT_LOG + ".1"
    for candidate_path in (rotated_path, AUDIT_LOG):
        if os.path.isfile(candidate_path) and os.path.getsize(candidate_path) > 0:
            audit_paths.append(candidate_path)
    if audit_paths:
        try:
            lines = []
            for audit_path in audit_paths:
                with open(audit_path, "rb") as audit_file:
                    lines.extend(candidate for candidate in audit_file if candidate.strip())
            if not lines:
                raise ValueError("audit log has no durable entries")
            prior_hash = ""
            prior_seq = 0
            validated_heads = {(0, "")}
            for index, line in enumerate(lines):
                entry = json.loads(line.decode("utf-8"))
                recorded_hash = str(entry.pop("hash", "") or "")
                calculated_hash = hashlib.sha256(
                    json.dumps(entry, separators=(",", ":"), sort_keys=True).encode("utf-8")
                ).hexdigest()
                seq = int(entry.get("seq", 0) or 0)
                prev = str(entry.get("prev", "") or "")
                if seq < 1 or not hmac.compare_digest(recorded_hash, calculated_hash):
                    raise ValueError(f"audit log entry {index + 1} failed hash validation")
                if prior_seq and (seq != prior_seq + 1 or not hmac.compare_digest(prev, prior_hash)):
                    raise ValueError(f"audit log entry {index + 1} broke chain continuity")
                prior_hash = recorded_hash
                prior_seq = seq
                validated_heads.add((seq, recorded_hash))
            recorded_hash = prior_hash
            last_seq = prior_seq
            if head_error or not os.path.exists(AUDIT_HEAD_PATH):
                _audit_chain_head = recorded_hash
                _audit_chain_seq = last_seq
                _write_boot_log(f"[AUDIT] recovered chain head from audit log after head error: {head_error or 'missing head'}")
            elif (_audit_chain_seq, _audit_chain_head) not in validated_heads:
                raise ValueError("audit head is not a validated prefix of the durable audit log")
            elif _audit_chain_head != recorded_hash or _audit_chain_seq != last_seq:
                _write_boot_log("[AUDIT] advancing stale durable head to the validated audit log tail")
                _audit_chain_head = recorded_hash
                _audit_chain_seq = last_seq
            if head_error or not os.path.exists(AUDIT_HEAD_PATH) or (_audit_chain_seq, _audit_chain_head) == (last_seq, recorded_hash):
                tmp = AUDIT_HEAD_PATH + ".recovery.tmp"
                with open(tmp, "w", encoding="utf-8") as head_file:
                    head_file.write(json.dumps({"head": _audit_chain_head, "seq": _audit_chain_seq}))
                    head_file.flush()
                    os.fsync(head_file.fileno())
                os.replace(tmp, AUDIT_HEAD_PATH)
                os.chmod(AUDIT_HEAD_PATH, 0o600)
        except Exception as exc:
            _write_boot_log(f"[AUDIT] chain recovery failed: {exc}")
            raise RuntimeError("local audit chain continuity could not be verified") from exc
    elif head_error:
        _write_boot_log(f"[AUDIT] audit head is unreadable and no audit log can recover it: {head_error}")
        raise RuntimeError("local audit chain head could not be verified") from head_error
    elif _audit_chain_seq > 0:
        _write_boot_log("[AUDIT] audit log is missing while the durable head records prior events")
        raise RuntimeError("local audit log is missing for the recorded chain head")

def _append_local_audit(event, **fields):
    global _audit_chain_head, _audit_chain_seq
    try:
        with _audit_chain_lock:
            seq = _audit_chain_seq + 1
            safe_fields = {key: _redact_log_value(value, key) for key, value in fields.items()}
            entry = {
                "time": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
                "event": event,
                "agent_id": AGENT_ID,
                "client_id": CLIENT_ID,
                "seq": seq,
                "prev": _audit_chain_head,
                **safe_fields,
            }
            entry_hash = hashlib.sha256(json.dumps(entry, separators=(",", ":"), sort_keys=True).encode("utf-8")).hexdigest()
            line = json.dumps(dict(entry, hash=entry_hash), separators=(",", ":"), sort_keys=True)
            try:
                if os.path.exists(AUDIT_LOG) and os.path.getsize(AUDIT_LOG) > _BOOT_LOG_MAX_BYTES:
                    os.replace(AUDIT_LOG, AUDIT_LOG + ".1")
            except Exception:
                pass
            with open(AUDIT_LOG, "a", encoding="utf-8") as f:
                f.write(line + "\n")
                f.flush()
                try:
                    os.fsync(f.fileno())
                except Exception:
                    pass
            try:
                os.chmod(AUDIT_LOG, 0o600)
            except Exception:
                pass
            _audit_chain_head = entry_hash
            _audit_chain_seq = seq
            head_persisted = True
            try:
                tmp = AUDIT_HEAD_PATH + ".tmp"
                with open(tmp, "w", encoding="utf-8") as f:
                    f.write(json.dumps({"head": _audit_chain_head, "seq": _audit_chain_seq}))
                    f.flush()
                    try:
                        os.fsync(f.fileno())
                    except Exception:
                        pass
                os.replace(tmp, AUDIT_HEAD_PATH)
                os.chmod(AUDIT_HEAD_PATH, 0o600)
            except Exception as exc:
                head_persisted = False
                _write_boot_log(f"[AUDIT] head persistence failed after event {event}: {exc}")
            return head_persisted
    except Exception as exc:
        _write_boot_log(f"[AUDIT] append failed for event {event}: {exc}")
        return False

def ensure_dependencies():
    global RUNTIME_DEPENDENCY_STATUS
    try:
        if not TRUST_CONSOLE_B64 or len(TRUST_CONSOLE_B64) > 2 * 1024 * 1024:
            raise RuntimeError("approved embedded runtime contract is missing")
        source = base64.b64decode(TRUST_CONSOLE_B64.encode("ascii"), validate=True).decode("utf-8")
        manager = types.ModuleType("_infraveil_approved_runtime_manager")
        manager.__file__ = os.path.abspath(__file__)
        exec(compile(source, "<approved embedded Trust Console>", "exec"), manager.__dict__)
        home = str(os.environ.get("INFRAVEIL_MANAGED_RUNTIME_HOME") or "")
        if not home or not manager._current_runtime_matches(home):
            inferred = os.path.dirname(os.path.abspath(sys.prefix))
            home = inferred if manager._current_runtime_matches(inferred) else os.path.join(_agent_root(), "runtime")
        if not manager._current_runtime_matches(home):
            python_path = manager._prepare_runtime(home)
            os.execve(python_path, [python_path, "-I", os.path.abspath(__file__)] + sys.argv[1:], manager._sanitized_runtime_env(home))
            raise RuntimeError("managed runtime restart did not replace the agent process")
        RUNTIME_DEPENDENCY_STATUS = {"dependency_lock_sha256": manager._runtime_lock_identity(), "dependency_versions": dict(requirement.split("==", 1) for requirement, _hashes in manager.LOCKED_WHEEL_HASHES), "dependency_runtime_managed": True}
    except Exception as exc:
        _write_boot_log("[BOOTSTRAP] Hash-locked runtime reconciliation failed: " + type(exc).__name__)
        raise RuntimeError("Hash-locked Trust Console runtime required; missing: verified management environment or matching approved versions") from exc

if __name__ == "__main__":
    ensure_dependencies()
