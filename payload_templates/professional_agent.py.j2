            if command == 'python':
                return quote_executable(self.python_executable())
            if command.startswith('python '):
                return quote_executable(self.python_executable()) + command[len('python'):]
            if command == 'python3':
                return quote_executable(self.python_executable())
            if command.startswith('python3 '):
                return quote_executable(self.python_executable()) + command[len('python3'):]
        if runtime in ('node', 'generic'):
            node_name = 'node.exe' if self.os.name == 'nt' else 'node'
            npm_name = 'npm.cmd' if self.os.name == 'nt' else 'npm'
            node_path = resolve_windows_executable(node_name, ('%ProgramFiles%\\nodejs\\node.exe', '%ProgramFiles(x86)%\\nodejs\\node.exe', '%LocalAppData%\\Programs\\nodejs\\node.exe', '%AppData%\\npm\\node.exe'))
            npm_path = resolve_windows_executable(npm_name, ('%ProgramFiles%\\nodejs\\npm.cmd', '%ProgramFiles(x86)%\\nodejs\\npm.cmd', '%LocalAppData%\\Programs\\nodejs\\npm.cmd', '%AppData%\\npm\\npm.cmd'))
            if command == 'node':
                return quote_executable(node_path)
            if command.startswith('node '):
                return quote_executable(node_path) + command[len('node'):]
            if command == 'npm':
                return quote_executable(npm_path)
            if command.startswith('npm '):
                return quote_executable(npm_path) + command[len('npm'):]
        return command

    def join_arguments(self, parts):
        if self.os.name == 'nt':
            return self.windows_command_line(parts)
        return self.arguments.join(parts)

    def find_unique_workspace_file(self, workspace, filename):
        matches = []
        target = filename.replace('\\', '/').split('/')[-1]
        for root, dirs, files in self.os.walk(workspace):
            dirs[:] = [d for d in dirs if d not in ('node_modules', '__pycache__', '.git', 'venv', '.venv')]
            if target in files:
                matches.append(self.os.path.join(root, target))
                if len(matches) > 1:
                    return None
        return matches[0] if len(matches) == 1 else None

    def resolve_layout(self, svc, workspace, cwd, start, runtime):
        explicit_cwd = bool(str(svc.get('cwd') or '').strip())
        entrypoint = str(svc.get('entrypoint') or '').strip().replace('\\', '/')
        if entrypoint.startswith('./'):
            entrypoint = entrypoint[2:]
        if entrypoint and (not explicit_cwd):
            entry_abs = self.os.path.abspath(self.os.path.join(workspace, entrypoint))
            workspace_abs = self.os.path.abspath(workspace)
            if entry_abs.startswith(workspace_abs + self.os.sep) and self.os.path.exists(entry_abs):
                cwd = self.os.path.dirname(entry_abs)
        runtime_l = str(runtime or '').strip().lower()
        if runtime_l not in ('python', 'node'):
            return (cwd, start)
        if any((token in start for token in ('&&', '||', ';', '|'))):
            return (cwd, start)
        try:
            parts = self.arguments.split(start, posix=self.os.name != 'nt')
        except Exception:
            return (cwd, start)
        if len(parts) < 2:
            return (cwd, start)
        launcher = parts[0].lower().replace('\\', '/').split('/')[-1]
        if runtime_l == 'python' and launcher not in ('python', 'python3', 'python.exe', 'python3.exe'):
            return (cwd, start)
        if runtime_l == 'node' and launcher not in ('node', 'node.exe'):
            return (cwd, start)
        script_idx = 1
        while script_idx < len(parts) and parts[script_idx].startswith('-'):
            script_idx += 1
        if script_idx >= len(parts):
            return (cwd, start)
        script = parts[script_idx].strip('"').strip("'").replace('\\', '/')
        if not script or script.startswith('-') or self.os.path.isabs(script):
            return (cwd, start)
        candidate = self.os.path.abspath(self.os.path.join(cwd, script))
        if self.os.path.exists(candidate):
            return (cwd, start)
        if entrypoint:
            entry_abs = self.os.path.abspath(self.os.path.join(workspace, entrypoint))
            if self.os.path.exists(entry_abs) and self.os.path.basename(entry_abs) == self.os.path.basename(script):
                cwd = self.os.path.dirname(entry_abs)
                parts[script_idx] = self.os.path.basename(entry_abs)
                return (cwd, self.join_arguments(parts))
        found = self.find_unique_workspace_file(workspace, script)
        if found:
            cwd = self.os.path.dirname(found)
            parts[script_idx] = self.os.path.basename(found)
            self.report_log(f"[WARN] Resolved service [{svc.get('name', 'service')}] start target to {self.os.path.relpath(found, workspace)}")
            return (cwd, self.join_arguments(parts))
        return (cwd, start)
"""Kernel-backed workload port reservations owned by one agent instance.

Construction is inert. Allocation retains the existing signed manifest contract,
gateway-first reservation, fixed-port refusal and exact persisted record format.
Only this owner mutates its listeners and allocation record. Consumers receive a
listener by role or a detached allocation snapshot, never the mutable containers.
"""
import copy as _runtime_ports_copy
import errno as _runtime_ports_errno
import json as _runtime_ports_json
import os as _runtime_ports_os
import socket as _runtime_ports_socket


class AgentRuntimePorts:
    def __init__(self, *, state_path, write_json, audit, report_log,
                 filesystem=_runtime_ports_os, sockets=_runtime_ports_socket,
                 errors=_runtime_ports_errno):
        self.state_path = state_path
        self.write_json = write_json
        self.audit = audit
        self.report_log = report_log
        self.os = filesystem
        self.socket = sockets
        self.errno = errors
        self.copy = _runtime_ports_copy
        self.json = _runtime_ports_json
        self._listeners = {}
        self._allocation = {}

    def listener(self, role):
        return self._listeners.get(role)

    def snapshot(self):
        return self.copy.deepcopy(self._allocation)

    def release(self):
        for listener in list(self._listeners.values()):
            listener.close()
        self._listeners.clear()

    def reserve(self, host, preferred, automatic=False):
        'Ask the destination kernel, not workspace metadata or PID visibility.'
        listener = self.socket.socket(self.socket.AF_INET, self.socket.SOCK_STREAM)
        try:
            if self.os.name == 'nt':
                listener.setsockopt(self.socket.SOL_SOCKET, self.socket.SO_EXCLUSIVEADDRUSE, 1)
            else:
                listener.setsockopt(self.socket.SOL_SOCKET, self.socket.SO_REUSEADDR, 1)
            try:
                listener.bind((host, int(preferred)))
            except OSError as exc:
                if not automatic or exc.errno not in {self.errno.EADDRINUSE, 10048}:
                    raise OSError(exc.errno, f'Port {preferred} on {host}: {exc.strerror}') from exc
                listener.bind((host, 0))
            listener.listen(128)
            return listener
        except Exception:
            listener.close()
            raise

    def allocate(self, manifest):
        'Resolve signed automatic port preferences without modifying package bytes.\n\n    Held sockets close the check/start race across launchers, workspaces and\n    unrelated services (including dogfood). Only socket-aware services may move;\n    fixed application/inbound ports never move silently.\n    '
        effective = self.copy.deepcopy(manifest)
        automatic = (effective.get('port_allocation') or {}).get('mode') == 'automatic'
        gateway = effective.get('gateway') or {}
        engine = str(gateway.get('engine') or gateway.get('mode') or 'aiohttp').lower()
        if automatic and (self.os.name == 'nt' or engine in {'caddy', 'managed-caddy'}):
            raise RuntimeError('Automatic ports require POSIX socket activation and the aiohttp gateway; use fixed ports for this runtime.')
        previous = {}
        if automatic and self.os.path.isfile(self.state_path()):
            with open(self.state_path(), encoding='utf-8') as source:
                previous = self.json.load(source)
        rows = {}

        def reserve(role, host, preferred, movable):
            if role in rows:
                raise ValueError(f'Duplicate port role: {role}')
            preferred = int(preferred)
            if not 1 <= preferred <= 65535:
                raise ValueError(f'Invalid port for {role}: {preferred}')
            prior = previous.get(role) or {}
            desired = int(prior.get('assigned') or preferred) if prior.get('preferred') == preferred else preferred
            listener = self.reserve(host, desired, movable)
            actual = listener.getsockname()[1]
            self._listeners[role] = listener
            rows[role] = {'host': host, 'preferred': preferred, 'assigned': actual, 'changed': actual != preferred}
            return actual
        try:
            if gateway.get('enabled', True) is not False and engine not in {'caddy', 'managed-caddy'}:
                gateway['listen'] = reserve('gateway', '0.0.0.0', gateway.get('listen') or effective.get('listen') or 18443, automatic)
                effective['gateway'] = gateway
            for svc in effective.get('services', []):
                if not isinstance(svc, dict) or not svc.get('port'):
                    continue
                if automatic:
                    if svc.get('socket_activation') is not True:
                        raise RuntimeError(f"Service {svc.get('name')} must support INFRAVEIL_LISTEN_FD before automatic ports can be enabled.")
                    svc['port'] = reserve('service:' + str(svc.get('name') or 'service'), '127.0.0.1', svc['port'], True)
                    svc.setdefault('env', {})['PORT'] = str(svc['port'])
            self._allocation = {'mode': 'automatic' if automatic else 'fixed', 'ports': rows}
            if automatic:
                self.write_json(self.state_path(), rows)
            self.audit('runtime_ports_allocated', **self._allocation)
            self.report_log('[PORT_ALLOCATION] ' + self.json.dumps(self._allocation, separators=(',', ':')))
            return effective
        except Exception:
            self.release()
            raise
"""Workload persistence ownership, ready for standalone source assembly.

This candidate is deliberately inert: defining/importing it creates no paths,
mounts, workers or processes. The composition root supplies identity and report
hooks; the domain owns its mount list. Installation still ships one verified
standalone agent, not unchecked imports from neighboring files.
"""
import os as _persistence_os
import shutil as _persistence_shutil


class _AgentPersistence:
    def __init__(self, *, agent_root, agent_slug, report_log, report_error,
                 filesystem=_persistence_os, file_operations=_persistence_shutil):
        self._agent_root = agent_root
        self._agent_slug = agent_slug
        self._report_log = report_log
        self._report_error = report_error
        self.os = filesystem
        self.files = file_operations
        self.mounts = []

    def workspace(self):
        return self.os.path.join(self._agent_root(), f"infraveil_payload_workspace_{self._agent_slug()}")

    def remove_path(self, path):
        if not self.os.path.lexists(path):
            return
        if self.os.path.isdir(path) and not self.os.path.islink(path):
            self.files.rmtree(path, ignore_errors=True)
            if self.os.path.exists(path):
                try: self.os.rmdir(path)
                except Exception: pass
        else:
            try: self.os.remove(path)
            except Exception: self.files.rmtree(path, ignore_errors=True)

    def root(self):
        root = self.os.path.join(self._agent_root(), "infraveil_persistent", self._agent_slug())
        self.os.makedirs(root, exist_ok=True)
        try:
            self.os.chmod(root, 0o700)
        except Exception:
            pass
        return root

    def safe_relative_path(self, path):
        raw = str(path or "").strip()
        if self.os.path.isabs(raw) or raw.startswith(("/", "\\")):
            raise RuntimeError(f"Unsafe persistent path rejected: {path}")
        rel = raw.replace("\\", "/")
        if rel.startswith("./"):
            rel = rel[2:]
        rel = rel.strip("/")
        if "\x00" in rel or ":" in rel:
            raise RuntimeError(f"Unsafe persistent path rejected: {path}")
        if not rel or rel.startswith("../") or "/../" in rel or rel == ".." or self.os.path.isabs(rel):
            raise RuntimeError(f"Unsafe persistent path rejected: {path}")
        return rel

    def seed_data(self, src, dst):
        if not self.os.path.exists(src) or self.os.path.exists(dst):
            return
        if self.os.path.isdir(src):
            self.files.copytree(src, dst)
        else:
            self.os.makedirs(self.os.path.dirname(dst), exist_ok=True)
            self.files.copy2(src, dst)

    def sync(self):
        for mount in list(self.mounts):
            if mount.get("mode") != "copy":
                continue
            src = mount.get("workspace_path")
            dst = mount.get("persist_path")
            kind = mount.get("type")
            try:
                if kind == "file":
                    if self.os.path.exists(src):
                        self.os.makedirs(self.os.path.dirname(dst), exist_ok=True)
                        self.files.copy2(src, dst)
                elif self.os.path.isdir(src):
                    if self.os.path.exists(dst):
                        self.files.rmtree(dst, ignore_errors=True)
                    self.files.copytree(src, dst)
            except Exception as exc:
                self._report_error(f"Persistent sync failed for {mount.get('path')}: {exc}", label="[PERSIST_ERROR]")

    def mount(self, manifest, workspace):
        self.mounts = []
        entries = []
        if isinstance(manifest.get("persistent_paths"), list):
            for p in manifest.get("persistent_paths", []):
                entries.append(p if isinstance(p, dict) else {"path": p})
        if isinstance(manifest.get("volumes"), list):
            entries.extend(v for v in manifest.get("volumes", []) if isinstance(v, dict))
        root = self.root()
        for entry in entries:
            rel = self.safe_relative_path(entry.get("path") if isinstance(entry, dict) else entry)
            kind = str(entry.get("type", "dir") if isinstance(entry, dict) else "dir").lower()
            persist_path = self.os.path.join(root, rel)
            workspace_path = self.os.path.join(workspace, rel)
            self.os.makedirs(self.os.path.dirname(persist_path), exist_ok=True)
            self.os.makedirs(self.os.path.dirname(workspace_path), exist_ok=True)
            self.seed_data(workspace_path, persist_path)
            if self.os.path.lexists(workspace_path):
                if self.os.path.isdir(workspace_path) and not self.os.path.islink(workspace_path):
                    self.files.rmtree(workspace_path, ignore_errors=True)
                else:
                    try: self.os.remove(workspace_path)
                    except Exception: pass
            if kind == "file":
                if not self.os.path.exists(persist_path):
                    open(persist_path, "a", encoding="utf-8").close()
                try:
                    self.os.link(persist_path, workspace_path)
                    self.mounts.append({"path": rel, "type": "file", "mode": "link", "persist_path": persist_path, "workspace_path": workspace_path})
                except (FileExistsError, OSError):
                    try:
                        if self.os.path.samefile(persist_path, workspace_path):
                            self.mounts.append({"path": rel, "type": "file", "mode": "link", "persist_path": persist_path, "workspace_path": workspace_path})
                            continue
                    except Exception:
                        pass
                    self.files.copy2(persist_path, workspace_path)
                    self.mounts.append({"path": rel, "type": "file", "mode": "copy", "persist_path": persist_path, "workspace_path": workspace_path})
            else:
                self.os.makedirs(persist_path, exist_ok=True)
                try:
                    self.os.symlink(persist_path, workspace_path, target_is_directory=True)
                    self.mounts.append({"path": rel, "type": "dir", "mode": "link", "persist_path": persist_path, "workspace_path": workspace_path})
                except Exception:
                    self.files.copytree(persist_path, workspace_path, dirs_exist_ok=True)
                    self.mounts.append({"path": rel, "type": "dir", "mode": "copy", "persist_path": persist_path, "workspace_path": workspace_path})
            self._report_log(f"[INFO] Mounted persistent path: {rel}")
