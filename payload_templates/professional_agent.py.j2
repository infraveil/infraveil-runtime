def _systemd_unit_properties(unit):
    if os.name == "nt" or not shutil.which("systemctl"):
        return {"active_state": "unsupported", "sub_state": "unsupported", "pid": 0, "exit_status": 0}
    try:
        result = subprocess.run(
            [
                "systemctl", "show", unit, "--no-page",
                "--property=ActiveState,SubState,MainPID,ExecMainStatus,MemoryCurrent",
            ],
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=4,
            check=False,
        )
    except Exception as exc:
        return {"active_state": "unknown", "sub_state": str(exc)[:160], "pid": 0, "exit_status": 0}
    values = {}
    for line in (result.stdout or "").splitlines():
        key, separator, value = line.partition("=")
        if separator:
            values[key.strip()] = value.strip()
    try:
        pid = int(values.get("MainPID") or 0)
    except (TypeError, ValueError):
        pid = 0
    try:
        exit_status = int(values.get("ExecMainStatus") or 0)
    except (TypeError, ValueError):
        exit_status = 0
    try:
        memory_current = int(values.get("MemoryCurrent") or 0)
    except (TypeError, ValueError):
        memory_current = 0
    return {
        "active_state": values.get("ActiveState") or ("unknown" if result.returncode else "inactive"),
        "sub_state": values.get("SubState") or "unknown",
        "pid": pid,
        "exit_status": exit_status,
        "memory_current_bytes": max(0, memory_current),
    }

def _external_service_status(spec):
    import psutil

    properties = _systemd_unit_properties(str(spec.get("unit") or ""))
    pid = int(properties.get("pid") or 0)
    result = {
        **properties,
        "alive": properties.get("active_state") == "active",
        "cpu_percent": 0.0,
        "memory_rss_bytes": max(0, int(properties.get("memory_current_bytes") or 0)),
        "memory_percent": 0.0,
    }
    if result["memory_rss_bytes"]:
        try:
            total_memory = int(psutil.virtual_memory().total or 0)
            if total_memory > 0:
                result["memory_percent"] = round((result["memory_rss_bytes"] / total_memory) * 100.0, 3)
        except Exception:
            pass
    if pid > 0:
        try:
            process = psutil.Process(pid)
            result["cpu_percent"] = round(float(process.cpu_percent(interval=None) or 0.0), 2)
            result["memory_rss_bytes"] = int(process.memory_info().rss)
            result["memory_percent"] = round(float(process.memory_percent() or 0.0), 3)
        except Exception:
            pass
    healthy, reason = _service_is_healthy(spec)
    result["healthy"] = bool(result["alive"] and healthy)
    result["health_reason"] = reason
    return result

def _record_delivery_observation(success):
    global _event_delivery_last_success_ts, _event_delivery_last_failure_ts, _event_delivery_consecutive_failures
    with _event_post_drop_lock:
        if success:
            _event_delivery_last_success_ts = time.time()
            _event_delivery_consecutive_failures = 0
        else:
            _event_delivery_last_failure_ts = time.time()
            _event_delivery_consecutive_failures += 1


def _journal_capture_summary(name):
    state = dict(_external_log_health.get(name) or {})
    proc = _external_log_processes.get(name)
    alive = bool(proc and proc.poll() is None)
    pending = float(state.get("pending_since") or 0)
    return {**state, "follower_alive": alive,
            "observation_ts": time.time(),
            "pending_age_seconds": max(0, time.time() - pending) if pending else 0,
            "mode": "journal-ack-cursor-v1", "initial_replay_seconds": 300,
            "initial_replay_max_records": 1000}


def _journal_capture_failure(name):
    state = _external_log_health.setdefault(name, {})
    state["failures_total"] = state.get("failures_total", 0) + 1
    state["last_failure_ts"] = time.time()
    # No captured application text or HTTP response body in diagnostics, and no
    # ingestion of our own diagnostic messages through this journal follower.
    if state["failures_total"] in (1, 10, 100, 1000):
        _write_boot_log("[JOURNAL_CAPTURE] capture/delivery retry required")


