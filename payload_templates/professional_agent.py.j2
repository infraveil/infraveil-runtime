def _runtime_log_level(message, fallback="info"):
    clean = re.sub(r"\x1b\[[0-9;]*m", "", str(message or "")).lstrip()
    try:
        structured = json.loads(clean)
    except (ValueError, TypeError):
        structured = None
    if isinstance(structured, dict):
        value = str(structured.get("level") or structured.get("levelname") or structured.get("severity") or "").lower()
        value = {"warning": "warn", "fatal": "critical"}.get(value, value)
        if value in {"trace", "debug", "info", "warn", "error", "critical"}:
            return value
    # Python's configured formatter emits timestamp first. Only recognize a level
    # at this bounded header position; words in application prose are not levels.
    timestamp = r"^\[?\d{4}-\d\d-\d\d[T ]\d\d:\d\d:\d\d(?:[.,]\d+)?(?:Z|[+-]\d\d:?\d\d)?\]?\s*(?:[-|:]\s*)?"
    timestamped = bool(re.match(timestamp, clean))
    clean = re.sub(timestamp, "", clean)
    if timestamped:
        clean = re.sub(r"^[A-Za-z_][A-Za-z0-9_.-]{0,120}\s+-\s+(?=(?:FATAL|CRITICAL|ERROR|WARNING|WARN|INFO|DEBUG|TRACE)\b)", "", clean, flags=re.IGNORECASE)
    if re.match(r"^Traceback \(most recent call last\):(?:\s|$)", clean):
        return "error"
    match = re.match(r"(?:\[(FATAL|CRITICAL|ERROR|WARNING|WARN|INFO|DEBUG|TRACE)\]|(FATAL|CRITICAL|ERROR|WARNING|WARN|INFO|DEBUG|TRACE)(?=\s|:|$))", clean, re.IGNORECASE)
    if not match:
        return fallback
    return (match.group(1) or match.group(2)).lower().replace("warning", "warn").replace("fatal", "critical")


def _journal_log_level(record, message):
    explicit = _runtime_log_level(message, "")
    if explicit:
        return explicit
    structured = _runtime_log_level(json.dumps({"level": record.get("LOG_LEVEL") or record.get("LEVEL") or ""}), "")
    if structured:
        return structured
    try:
        priority = int(record.get("PRIORITY"))
    except (AttributeError, TypeError, ValueError):
        return _runtime_log_level(message, "info")
    if 0 <= priority <= 2:
        return "critical"
    if priority == 3:
        return "error"
    return {4: "warn", 5: "info", 6: "info", 7: "debug"}.get(priority, "info")


def _stream_process_output(name, stream, prefix):
    try:
        for raw in iter(stream.readline, b""):
            if not raw:
                break
            line = _redact_runtime_log_message(raw.decode("utf-8", errors="replace")).strip()
            if line:
                stream_label = "stderr" if prefix == "[ERROR]" else "stdout"
                level = _runtime_log_level(line, stream_label)
                tail = _service_output_tail.setdefault(name, [])
                tail.append({"stream": stream_label, "level": level, "message": line, "at": time.time()})
                del tail[:-8]

                report_log(f"[PROCESS_EVENT] " + json.dumps({
                    "service": name,
                    "runtime": str((_service_specs.get(name) or {}).get("runtime") or "generic"),
                    "stream": stream_label,
                    "level": level,
                    "message": line,
                    "phase": "runtime"
                }, separators=(",", ":")))
    except Exception:
        pass

