def _spawn_from_cached_payload(agent_id, name):
    meta = _runtime_meta(agent_id)
    enc = ""
    try:
        cp = _payload_cache_path(agent_id)
        if os.path.isfile(cp):
            with open(cp, "r", encoding="utf-8") as f:
                enc = f.read()
    except Exception:
        enc = ""
    if not enc:
        enc = meta.get("last_payload_encrypted") or ""
    payload = _decrypt_runtime_cache_text(enc)
    if not payload:
        return False
    try:
        _require_agent_source_security_epoch(payload)
        spawn_agent(
            agent_id,
            payload,
            name=name,
            payload_hash=meta.get("last_payload_hash"),
            stage_candidate=False,
            persist_state=not _progress.active,
        )
        log_agent("FALLBACK", agent_id, name, "using last known good payload", level="WARN")
        return True
    except Exception as exc:
        log_agent("SPAWN ERROR", agent_id, name, str(exc)[:80], level="ERR")
        return False
_print_lock = threading.Lock()

def _emit_line(text):
    if _progress.active and _progress.tty:
        _progress.print_line(text)
    else:
        with _print_lock:
            print(text, flush=True)

def log(msg, level="INFO"):
    ts = datetime.now().strftime('%H:%M:%S')
    colors = {"INFO": "\x1b[94m", "OK": "\x1b[92m", "WARN": "\x1b[93m", "ERR": "\x1b[91m"}
    col = colors.get(level, "\x1b[94m")
    _emit_line(f"{c(ANSI_GREY)}{ts}{c(ANSI_RESET)}  {c(col)}[INFRAVEIL]{c(ANSI_RESET)}  {msg}")

def log_agent(label, agent_id, name, extra="", level="INFO"):
    short = agent_id[:8]
    colors = {"INFO": "\x1b[94m", "OK": "\x1b[92m", "WARN": "\x1b[93m", "ERR": "\x1b[91m"}
    col = colors.get(level, "\x1b[94m")
    tag = f"{c(ANSI_GREY)}[{short}]{c(ANSI_RESET)}"
    nm  = f"{c(ANSI_WHITE)}{name}{c(ANSI_RESET)}"
    ex  = f"  {c(ANSI_GREY)}{extra}{c(ANSI_RESET)}" if extra else ""
    ts  = datetime.now().strftime('%H:%M:%S')
    _emit_line(f"{c(ANSI_GREY)}{ts}{c(ANSI_RESET)}  {c(col)}{label:<14}{c(ANSI_RESET)}  {tag} {nm}{ex}")

class _Progress:
    _PHASES = (("fetch", "Fetch"), ("decrypt", "Decrypt"), ("start", "Start"))

    def __init__(self):
        self._lock = threading.Lock()
        self.active = False
        self.tty = False
        self.total = 0
        self.counts = {"fetch": 0, "decrypt": 0, "start": 0}
        self.failed = 0
        self._height = 0
        self._t0 = 0.0
        self._stop = False
        self._thread = None
        self._ms = {"fetch": 0, "decrypt": 0, "start": 0}

    def begin(self, total, verb="Deploying"):
        with self._lock:
            if self.active:
                return
            self.total = max(1, int(total))
            self.counts = {"fetch": 0, "decrypt": 0, "start": 0}
            self.failed = 0
            self._height = 0
            self._t0 = time.time()
            self._stop = False
            self._ms = {"fetch": 0, "decrypt": 0, "start": 0}
            self.tty = bool(ANSI_ENABLED and sys.stdout and sys.stdout.isatty())
            self.active = True
        log(f"{verb} {self.total} workload" + ("s" if self.total != 1 else "") + "...", level="INFO")
        if self.tty:
            self._thread = threading.Thread(target=self._loop, daemon=True)
            self._thread.start()

    def tick(self, key, n=1):
        due = []
        with self._lock:
            if not self.active:
                return
            if key == "fail":
                self.failed += n
            elif key in self.counts:
                self.counts[key] += n
            if not self.tty:
                due = self._milestones_locked()
        for line in due:
            log(line, level="INFO")

    def _milestones_locked(self):
        out = []
        step = max(1, self.total // 4)
        for k, label in self._PHASES:
            done = self.counts[k]
            target = done - (done % step) if done < self.total else self.total
            if target > self._ms[k]:
                self._ms[k] = target
                out.append(f"{label}: {target}/{self.total}")
        return out

    def _bar(self, done, width=22):
        f = int(width * min(done, self.total) / self.total)
        return c("\x1b[92m") + "█" * f + c(ANSI_GREY) + "░" * (width - f) + c(ANSI_RESET)

    def _frame(self):
        lines = ["", "  " + c(ANSI_WHITE) + "INFRAVEIL" + c(ANSI_RESET) + c(ANSI_GREY) + f"   {self.total} workloads" + c(ANSI_RESET), ""]
        for k, label in self._PHASES:
            done = self.counts[k]
            lines.append("   " + c(ANSI_GREY) + f"{label:<8}" + c(ANSI_RESET) + " " + self._bar(done) + c(ANSI_GREY) + f"  {done:>4}/{self.total}" + c(ANSI_RESET))
        elapsed = time.time() - self._t0
        tail = "   " + c("\x1b[92m") + f"{self.counts['start']} online" + c(ANSI_RESET)
        if self.failed:
            tail += c(ANSI_GREY) + "  -  " + c("\x1b[91m") + f"{self.failed} failed" + c(ANSI_RESET)
        tail += c(ANSI_GREY) + f"  -  {elapsed:.0f}s" + c(ANSI_RESET)
        lines.append(tail)
        return lines

    def _draw(self):
        lines = self._frame()
        with _print_lock:
            buf = (f"\033[{self._height}A" if self._height else "") + "\033[J" + "\n".join(lines) + "\n"
            sys.stdout.write(buf)
            sys.stdout.flush()
            self._height = len(lines)

    def _loop(self):
        while True:
            with self._lock:
                if self._stop:
                    break
            try:
                self._draw()
            except Exception:
                pass
            time.sleep(0.12)

    def print_line(self, text):
        with _print_lock:
            buf = ""
            if self.active and self.tty and self._height:
                buf += f"\033[{self._height}A\033[J"
                self._height = 0
            sys.stdout.write(buf + text + "\n")
            sys.stdout.flush()

    def end(self):
        with self._lock:
            if not self.active:
                return
            self._stop = True
            self.active = False
            elapsed = time.time() - self._t0
            online = self.counts["start"]
            total = self.total
            failed = self.failed
        if self._thread:
            self._thread.join(timeout=0.4)
        if self.tty:
            try:
                self._draw()
            except Exception:
                pass
        msg = f"{online}/{total} workloads online in {elapsed:.0f}s"
        if failed:
            msg += f"  ({failed} failed)"
        log(msg, level="OK" if not failed else "WARN")

