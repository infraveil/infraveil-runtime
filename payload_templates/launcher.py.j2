def _shell_single_quote(value):
    return "'" + str(value).replace("'", "'\"'\"'") + "'"

def _macos_supervisor_source(python_cmd, script_path):
    source = r"""#!/bin/sh
umask 077

PYTHON_CMD=__PYTHON_CMD__
SCRIPT_PATH=__SCRIPT_PATH__
STATE_DIR=__STATE_DIR__
STATE_PATH="$STATE_DIR/launcher_start_budget.macos"
LOCK_PATH="$STATE_DIR/launcher_start_budget.macos.lock"
TEMP_PATH=""
LOCK_ACQUIRED=0

cleanup() {
    if [ -n "$TEMP_PATH" ]; then
        /bin/rm -f "$TEMP_PATH" 2>/dev/null || true
    fi
    if [ "$LOCK_ACQUIRED" -eq 1 ]; then
        /bin/rmdir "$LOCK_PATH" 2>/dev/null || true
    fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

fail_closed() {
    detail=$1
    /bin/echo "[INFRAVEIL]  Supervised launcher start blocked because the restart guard state could not be safely read or updated ($detail). The service will stop retrying. Review $STATE_PATH, fix its ownership/permissions or malformed contents, then start the service again. Manual launcher runs remain available without INFRAVEIL_NONINTERACTIVE=1."
    exit 0
}

if [ -L "$STATE_DIR" ] || { [ -e "$STATE_DIR" ] && [ ! -d "$STATE_DIR" ]; }; then
    fail_closed "restart guard directory is not a regular directory"
fi
/bin/mkdir -p "$STATE_DIR" 2>/dev/null || fail_closed "restart guard directory is not writable"
/bin/chmod 700 "$STATE_DIR" 2>/dev/null || fail_closed "restart guard directory permissions could not be secured"

attempt=0
while ! /bin/mkdir "$LOCK_PATH" 2>/dev/null; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 50 ]; then
        fail_closed "restart guard lock remained busy"
    fi
    /bin/sleep 0.1
done
LOCK_ACQUIRED=1

if [ -L "$STATE_PATH" ] || { [ -e "$STATE_PATH" ] && [ ! -f "$STATE_PATH" ]; }; then
    fail_closed "restart guard state is not a regular file"
fi
if [ -e "$STATE_PATH" ]; then
    /bin/chmod 600 "$STATE_PATH" 2>/dev/null || fail_closed "restart guard state permissions could not be secured"
fi

NOW=$(/bin/date +%s 2>/dev/null) || fail_closed "system clock could not be read"
case "$NOW" in
    ""|*[!0-9]*) fail_closed "system clock is invalid" ;;
esac
NOW_LENGTH=$(printf '%s' "$NOW" | /usr/bin/wc -c) || fail_closed "system clock is invalid"
if [ "$NOW_LENGTH" -gt 18 ]; then
    fail_closed "system clock is invalid"
fi
CUTOFF=$((NOW - 300))
TEMP_PATH="$STATE_PATH.tmp.$$"
if [ -e "$TEMP_PATH" ] || [ -L "$TEMP_PATH" ]; then
    fail_closed "restart guard temporary state already exists"
fi
(umask 077 && : > "$TEMP_PATH") 2>/dev/null || fail_closed "restart guard state is not writable"

COUNT=0
if [ -e "$STATE_PATH" ]; then
    SAW_STATE_LINE=0
    while IFS= read -r stamp || [ -n "$stamp" ]; do
        SAW_STATE_LINE=1
        case "$stamp" in
            ""|*[!0-9]*) fail_closed "restart guard start history is malformed" ;;
            0) ;;
            0*) fail_closed "restart guard start history is malformed" ;;
        esac
        STAMP_LENGTH=$(printf '%s' "$stamp" | /usr/bin/wc -c) || fail_closed "restart guard start history is malformed"
        if [ "$STAMP_LENGTH" -gt 18 ]; then
            fail_closed "restart guard start history is malformed"
        fi
        if [ "$stamp" -gt "$NOW" ]; then
            stamp=$NOW
        fi
        if [ "$stamp" -gt "$CUTOFF" ]; then
            printf '%s\n' "$stamp" >> "$TEMP_PATH" || fail_closed "restart guard state is not writable"
            COUNT=$((COUNT + 1))
        fi
    done < "$STATE_PATH"
    if [ "$SAW_STATE_LINE" -eq 0 ]; then
        fail_closed "restart guard start history is malformed"
    fi
fi

if [ "$COUNT" -ge 5 ]; then
    /bin/echo "[INFRAVEIL]  Supervised launcher restart budget exhausted: 5 starts were admitted within 300 seconds. The service will stop retrying. Review the launcher logs and configuration, then start the service again after the window expires. Manual launcher runs remain available without INFRAVEIL_NONINTERACTIVE=1."
    exit 0
fi

printf '%s\n' "$NOW" >> "$TEMP_PATH" || fail_closed "restart guard state is not writable"
/bin/chmod 600 "$TEMP_PATH" 2>/dev/null || fail_closed "restart guard state permissions could not be secured"
/bin/mv -f "$TEMP_PATH" "$STATE_PATH" 2>/dev/null || fail_closed "restart guard state could not be committed"
TEMP_PATH=""
if ! /bin/rmdir "$LOCK_PATH" 2>/dev/null; then
    fail_closed "restart guard lock could not be released"
fi
LOCK_ACQUIRED=0

if [ ! -x "$PYTHON_CMD" ]; then
    /bin/echo "[INFRAVEIL]  Configured launcher Python is missing or not executable: $PYTHON_CMD"
    exit 1
fi

INFRAVEIL_START_GUARD_ADMITTED=1
export INFRAVEIL_START_GUARD_ADMITTED
exec "$PYTHON_CMD" -I -u "$SCRIPT_PATH" --noninteractive
/bin/echo "[INFRAVEIL]  Could not execute the supervised launcher."
exit 1
"""
    return (
        source.replace("__PYTHON_CMD__", _shell_single_quote(python_cmd))
        .replace("__SCRIPT_PATH__", _shell_single_quote(script_path))
        .replace("__STATE_DIR__", _shell_single_quote(_DATA_DIR))
    )

def _systemd_path_argument(value, executable=False):
    value = str(value)
    if not value or any(character in value for character in ("\x00", "\n", "\r")):
        raise ValueError("Invalid systemd executable or directory path")
    value = value.replace("\\", "\\\\").replace('"', '\\"').replace("%", "%%")
    if executable:
        value = value.replace("$", "$$")
    return '"' + value + '"'


def _systemd_working_directory_argument(value):
    value = str(value)
    if not value.startswith("/") or any(
        ord(character) < 0x20 or 0x7f <= ord(character) <= 0x9f
        for character in value
    ):
        raise ValueError("Invalid absolute systemd working directory path")
    # WorkingDirectory consumes a raw path, unlike the quoted ExecStart words.
    # Keep trailing spaces and backslashes inside the value, away from line ends.
    return (value.rstrip("/") + "/.").replace("%", "%%")


def _launcher_systemd_state():
    result = subprocess.run(
        ["systemctl", "show", "--no-pager",
         "--property=LoadState,FragmentPath,UnitFileState,DropInPaths", "infraveil-launcher.service"],
        capture_output=True, text=True, check=False, timeout=20,
    )
    if result.returncode not in (0, 1):
        raise RuntimeError("Could not inspect the existing systemd launcher")
    properties = {}
    for line in result.stdout.splitlines():
        key, separator, value = line.partition("=")
        if not separator or key in properties:
            raise RuntimeError("Ambiguous systemd launcher properties")
        properties[key] = value
    if set(properties) != {"LoadState", "FragmentPath", "UnitFileState", "DropInPaths"}:
        raise RuntimeError("Incomplete systemd launcher properties")
    if result.returncode and properties["LoadState"] != "not-found":
        raise RuntimeError("Could not inspect the existing systemd launcher")
    return properties


def _check_launcher_unit_owner(unit_path, unit, legacy_unit):
    """Only our exact same-install unit may be retained or repaired.

    A different installation, drop-in, mask, or customized unit needs explicit
    operator review; enrollment is not authority to replace another service.
    """
    if not os.path.lexists(unit_path):
        return False
    if os.path.islink(unit_path) or not os.path.isfile(unit_path):
        raise RuntimeError("Existing launcher unit is linked or not a regular file")
    info = os.stat(unit_path)
    if info.st_uid != 0 or info.st_nlink != 1 or info.st_mode & 0o022:
        raise RuntimeError("Existing launcher unit has unexpected ownership or permissions")
    with open(unit_path, "r", encoding="utf-8") as stream:
        existing = stream.read(65537)
    if len(existing) > 65536 or existing not in (unit, legacy_unit):
        raise RuntimeError("Existing launcher belongs to another installation or was customized")
    return True


def _register_boot_service(python_cmd, script_path):
    script_dir = os.path.dirname(os.path.realpath(__file__))
    try:
        if os.name == "nt":
            startup = os.path.join(os.environ.get("APPDATA", ""), "Microsoft", "Windows", "Start Menu", "Programs", "Startup")
            if not os.path.isdir(startup):
                return False, "Could not find the Windows Startup folder; set autostart up later. The launcher still runs now.", False
            run_cmd = python_cmd
            if python_cmd.lower().endswith("python.exe"):
                pyw = python_cmd[:-len("python.exe")] + "pythonw.exe"
                if os.path.isfile(pyw):
                    run_cmd = pyw
            cmd_path = os.path.join(startup, "InfraveilLauncher.cmd")
            content = '@echo off\ncd /d "%s"\nstart "" "%s" "%s"\n' % (script_dir, run_cmd, script_path)
            _atomic_write_text(cmd_path, content)
            return True, 'Registered autostart at logon (Startup folder \\ InfraveilLauncher.cmd). Delete that file to disable.', False
        if platform.system().lower() == "darwin":
            label_suffix = re.sub(r"[^A-Za-z0-9.-]+", "-", LAUNCHER_HOST_ID or CLIENT_ID).strip(".-") or "default"
            label = "com.infraveil.launcher." + label_suffix
            launch_agents_dir = os.path.join(os.path.expanduser("~"), "Library", "LaunchAgents")
            os.makedirs(launch_agents_dir, mode=0o700, exist_ok=True)
            plist_path = os.path.join(launch_agents_dir, label + ".plist")
            log_dir = os.path.join(_DATA_DIR, "logs")
            os.makedirs(log_dir, mode=0o700, exist_ok=True)
            supervisor_path = os.path.join(_DATA_DIR, "launcher_supervisor.sh")
            _atomic_write_text(supervisor_path, _macos_supervisor_source(python_cmd, script_path))
            os.chmod(supervisor_path, 0o700)
            service_path = ":".join([
                os.path.join(os.path.expanduser("~"), ".local", "bin"),
                "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin", "/bin", "/usr/sbin", "/sbin",
            ])
            plist = {
                "Label": label,
                "ProgramArguments": ["/bin/sh", supervisor_path],
                "WorkingDirectory": script_dir,
                "EnvironmentVariables": {
                    "INFRAVEIL_NONINTERACTIVE": "1",
                    "INFRAVEIL_TRUST_CONSOLE_RUNTIME": "1",
                    "PATH": service_path,
                },
                "RunAtLoad": True,
                "KeepAlive": {"SuccessfulExit": False},
                "ThrottleInterval": 10,
                "ProcessType": "Background",
                "Umask": 0o077,
                "StandardOutPath": os.path.join(log_dir, "launcher.stdout.log"),
                "StandardErrorPath": os.path.join(log_dir, "launcher.stderr.log"),
            }
            _atomic_write_text(plist_path, plistlib.dumps(plist, fmt=plistlib.FMT_XML, sort_keys=True).decode("utf-8"))
            os.chmod(plist_path, 0o600)
            domain = "gui/" + str(os.getuid())
            service = domain + "/" + label
            loaded = subprocess.call(
                ["launchctl", "print", service],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            ) == 0
            if not loaded:
                subprocess.check_call(["launchctl", "bootstrap", domain, plist_path], timeout=20)
            subprocess.check_call(["launchctl", "enable", service], timeout=20)
            return True, "Registered macOS LaunchAgent " + label + " (starts at login with bounded failure restarts).", True
        uid, gid = os.getuid(), os.getgid()
        if uid == 0 or gid == 0:
            return False, "Automatic Linux service setup requires a non-root account. Run setup as the intended service user, or provision a reviewed privileged service with root-owned executable paths.", False
        unit = "\n".join([
            "[Unit]", "Description=Infraveil Launcher",
            "After=network-online.target", "Wants=network-online.target",
            "StartLimitIntervalSec=300", "StartLimitBurst=5", "",
            "[Service]", "Type=simple", "User=" + str(uid), "Group=" + str(gid),
            "UMask=0077", "NoNewPrivileges=true", "KillMode=control-group",
            "WorkingDirectory=" + _systemd_working_directory_argument(script_dir),
            "ExecStart=" + _systemd_path_argument(python_cmd, executable=True) + " -I " + _systemd_path_argument(script_path, executable=True),
            "Restart=on-failure", "RestartSec=10", "Environment=INFRAVEIL_NONINTERACTIVE=1", "",
            "[Install]", "WantedBy=multi-user.target", ""])
        unit_path = "/etc/systemd/system/infraveil-launcher.service"
        legacy_unit = unit.replace(
            "WorkingDirectory=" + _systemd_working_directory_argument(script_dir),
            "WorkingDirectory=" + _systemd_path_argument(script_dir), 1,
        )
        existing = _check_launcher_unit_owner(unit_path, unit, legacy_unit)
        before = _launcher_systemd_state()
        if (before["FragmentPath"] not in ("", unit_path)
                or before["LoadState"] == "masked" or before["DropInPaths"]):
            raise RuntimeError("A different or masked launcher service requires operator review")
        if not existing and (before["FragmentPath"] or before["LoadState"] != "not-found"):
            raise RuntimeError("Existing launcher state does not match the selected installation")
        tmp = os.path.join(script_dir, ".infraveil-launcher.service")
        try:
            _atomic_write_text(tmp, unit)
            checked = subprocess.run(
                ["systemd-analyze", "verify", "--man=no", "--no-pager", tmp],
                capture_output=True, text=True, check=False, timeout=20,
            )
            if checked.returncode != 0:
                raise RuntimeError("systemd rejected the generated launcher unit; no unit was installed")
            # The system directory is root-owned. Recheck our exact expected
            # predecessor immediately before invoking the normal sudo prompt.
            if _check_launcher_unit_owner(unit_path, unit, legacy_unit) != existing:
                raise RuntimeError("Launcher service changed during registration")
            subprocess.check_call(["sudo", "-n", "cp", tmp, unit_path], timeout=20)
            _check_launcher_unit_owner(unit_path, unit, unit)
            subprocess.check_call(["sudo", "-n", "systemctl", "daemon-reload"], timeout=20)
            loaded = _launcher_systemd_state()
            if (loaded["LoadState"] != "loaded" or loaded["FragmentPath"] != unit_path
                    or loaded["DropInPaths"]):
                raise RuntimeError("Installed launcher unit did not load; autostart is not verified")
            subprocess.check_call(["sudo", "-n", "systemctl", "enable", "infraveil-launcher.service"], timeout=20)
            enabled = _launcher_systemd_state()
            if (enabled["LoadState"] != "loaded" or enabled["FragmentPath"] != unit_path
                    or enabled["UnitFileState"] != "enabled" or enabled["DropInPaths"]):
                raise RuntimeError("Launcher unit is not persistently enabled; autostart is not verified")
        finally:
            try:
                os.remove(tmp)
            except OSError:
                pass
        return True, "Launcher unit loaded and enabled for boot. Runtime startup is not yet verified. Check: systemctl status infraveil-launcher", False
    except Exception as exc:
        return False, "Could not auto-register a boot service (" + str(exc)[:160] + "). Automatic startup is not verified; review the existing service or continue manually.", False

