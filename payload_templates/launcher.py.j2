def init_console():
    global ANSI_ENABLED
    for _stream in (sys.stdout, sys.stderr):
        try:
            _stream.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass
    if os.name != "nt":
        ANSI_ENABLED = sys.stdout.isatty()
        return
    try:
        kernel32 = ctypes.windll.kernel32
        handle = kernel32.GetStdHandle(-11)
        mode = ctypes.c_uint32()
        if kernel32.GetConsoleMode(handle, ctypes.byref(mode)):
            ANSI_ENABLED = bool(kernel32.SetConsoleMode(handle, mode.value | 0x0004))
    except Exception:
        ANSI_ENABLED = False

def c(code):
    return code if ANSI_ENABLED else ""

def _signed_headers(method, path, params=None, body_bytes=b""):
    timestamp = str(int(time.time()))
    nonce = uuid.uuid4().hex
    params = params or {}
    pairs = []
    for key in sorted(params.keys()):
        value = params.get(key)
        if isinstance(value, (list, tuple)):
            for item in value:
                pairs.append((key, str(item)))
        else:
            pairs.append((key, str(value)))
    query = urllib.parse.urlencode(pairs, doseq=True)
    body_hash = hashlib.sha256(body_bytes or b"").hexdigest()
    canonical = "\n".join([
        "REQUEST",
        method.upper(),
        path,
        timestamp,
        nonce,
        query,
        body_hash,
    ])
    signature = hmac.new(LAUNCHER_TOKEN.encode("utf-8"), canonical.encode("utf-8"), hashlib.sha256).hexdigest()
    return {
        "Authorization": f"Bearer {LAUNCHER_TOKEN}",
        "X-Infraveil-Signature-Version": "2",
        "X-Infraveil-Timestamp": timestamp,
        "X-Infraveil-Nonce": nonce,
        "X-Infraveil-Signature": signature,
    }

def _signed_post_json(path, payload, timeout=15):
    body = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode("utf-8")
    headers = _signed_headers("POST", path, body_bytes=body)
    headers["Content-Type"] = "application/json"
    request_nonce = headers["X-Infraveil-Nonce"]
    resolved_timeout = timeout if isinstance(timeout, tuple) else (HTTP_CONNECT_TIMEOUT, timeout)
    response = HTTP.post(f"{BASE_URL}{path}", headers=headers, data=body, timeout=resolved_timeout)
    _verify_response_signature(response, request_nonce, path)
    return response

def _verify_response_signature(response, request_nonce, request_path):
    request_nonce = str(request_nonce or "").strip()
    request_path = str(request_path or "").strip()
    if not request_nonce or not request_path:
        raise RuntimeError("Control-plane response signature binding missing")
    version = str(response.headers.get("X-Infraveil-Response-Signature-Version") or "").strip()
    if version != "2":
        status_code = int(getattr(response, "status_code", 0) or 0)
        if status_code >= 500:
            raise RuntimeError(f"Control plane returned unsigned HTTP {status_code}; response rejected")
        raise RuntimeError("Control-plane response signature version invalid")
    timestamp = str(response.headers.get("X-Infraveil-Response-Timestamp") or "").strip()
    signature = str(response.headers.get("X-Infraveil-Response-Signature") or "").strip()
    if not timestamp or not signature:
        raise RuntimeError("Control-plane response missing signature")
    try:
        ts = int(timestamp)
    except Exception:
        raise RuntimeError("Control-plane response has invalid signature timestamp")
    if abs(int(time.time()) - ts) > 300:
        raise RuntimeError("Control-plane response signature expired")
    try:
        status = str(int(response.status_code))
    except Exception:
        raise RuntimeError("Control-plane response has invalid status binding")
    body_hash = hashlib.sha256(response.content or b"").hexdigest()
    canonical = "\n".join([
        "RESPONSE",
        timestamp,
        request_nonce,
        request_path,
        status,
        body_hash,
    ])
    expected = hmac.new(LAUNCHER_TOKEN.encode("utf-8"), canonical.encode("utf-8"), hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected, signature):
        raise RuntimeError("Control-plane response signature invalid")


def _runtime_cache_key():
    return hashlib.sha256((LAUNCHER_TOKEN + "|" + CLIENT_ID + "|" + LAUNCHER_HOST_ID).encode("utf-8")).digest()

def _encrypt_runtime_cache_text(text):
    if not text:
        return ""
    aes = AESGCM(_runtime_cache_key())
    nonce = os.urandom(12)
    encrypted = aes.encrypt(nonce, text.encode("utf-8"), None)
    return RUNTIME_CACHE_MAGIC + base64.b64encode(nonce + encrypted).decode("ascii")

def _decrypt_runtime_cache_text(value):
    if not value:
        return ""
    if not isinstance(value, str):
        return ""
    if not value.startswith(RUNTIME_CACHE_MAGIC):
        return ""
    try:
        raw = base64.b64decode(value[len(RUNTIME_CACHE_MAGIC):].encode("ascii"))
        if len(raw) <= 12:
            return ""
        aes = AESGCM(_runtime_cache_key())
        return aes.decrypt(raw[:12], raw[12:], None).decode("utf-8")
    except Exception:
        return ""

"""Launcher command-receipt coordination with explicit state and effect hooks.

This importable source module is not yet part of the active runtime assembly.
Its eventual build-time inline form needs no neighboring customer-side imports.
It owns receipt admission, acknowledgement replay and terminal tombstones, not
process execution, caller authorization, state-file locations or signed delivery.
"""


class LauncherCommandState:
    """Borrow current caller-owned containers; never copy or replace them.

    Create a view after loading persistent state, or at each adapter invocation:
    legacy state loading can rebind the caller's pending/completed dictionaries.
    """

    def __init__(self, pending_results, completed_results, held_commands,
                 protocol, tombstone_limit):
        self.pending_results = pending_results
        self.completed_results = completed_results
        self.held_commands = held_commands
        self.protocol = protocol
        self.tombstone_limit = tombstone_limit


class LauncherCommandHooks:
    """Caller-owned effects, retaining their original ordering and exceptions."""

    def __init__(self, persist, audit, log, now):
        self.persist = persist
        self.audit = audit
        self.log = log
        self.now = now


def command_receipt_id(receipt):
    if not isinstance(receipt, dict):
        return ""
    value = receipt.get("command_id")
    return value.strip() if isinstance(value, str) else ""


def command_result_pending(state, receipt):
    command_id = command_receipt_id(receipt)
    return bool(command_id and command_id in state.pending_results)


def command_result_seen(state, receipt):
    command_id = command_receipt_id(receipt)
    return bool(
        command_id
        and (command_id in state.pending_results or command_id in state.completed_results)
    )


def command_requires_receipt(state, command):
    return state.protocol >= 2 and command in {"restart", "update", "clear-workspace"}


def begin_command_result(state, hooks, receipt, target_type, target_id, command):
    command_id = command_receipt_id(receipt)
    if not command_id:
        if command_requires_receipt(state, command):
            held = (str(target_type), str(target_id), str(command))
            if held not in state.held_commands:
                state.held_commands.add(held)
                hooks.log("Held " + str(target_type) + " " + str(command) + " without an exact command receipt; current runtime is unchanged.", level="WARN")
                hooks.audit("command_held_without_receipt", target_type=target_type, target_id=target_id, command=command)
            return False
        return True
    state.held_commands.discard((str(target_type), str(target_id), str(command)))
    if command_id in state.pending_results:
        return False
    completed = state.completed_results.get(command_id)
    if isinstance(completed, dict):
        state.pending_results[command_id] = dict(completed)
        if not hooks.persist():
            state.pending_results.pop(command_id, None)
            raise RuntimeError("Completed command acknowledgement could not be re-queued")
        return False
    queue_command_result(state, hooks, receipt, target_type, target_id, command, "accepted")
    return True


def queue_command_result(state, hooks, receipt, target_type, target_id, command, result_state, error=""):
    command_id = command_receipt_id(receipt)
    if not command_id:
        return False
    result = {
        "command_id": command_id,
        "target_type": str(target_type or ""),
        "target_id": str(target_id or ""),
        "command": str(command or "").strip().lower(),
        "state": str(result_state or "").strip().lower(),
        "error": str(error or "")[:300],
        "recorded_at": hooks.now(),
    }
    previous = state.pending_results.get(command_id)
    state.pending_results[command_id] = result
    if not hooks.persist():
        if previous is None:
            state.pending_results.pop(command_id, None)
        else:
            state.pending_results[command_id] = previous
        raise RuntimeError("Command acknowledgement could not be persisted")
    hooks.audit(
        "command_result_queued",
        command_id=command_id,
        target_type=result["target_type"],
        target_id=result["target_id"],
        command=result["command"],
        state=result["state"],
    )
    return True


def clear_delivered_command_results(state, hooks, sent_results, accepted_command_ids):
    accepted = {
        str(command_id)
        for command_id in (accepted_command_ids or [])
        if isinstance(command_id, str) and command_id
    }
    changed = False
    for sent in sent_results or []:
        command_id = str((sent or {}).get("command_id") or "")
        current = state.pending_results.get(command_id)
        if command_id in accepted and current == sent and current.get("state") in ("succeeded", "failed"):
            state.pending_results.pop(command_id, None)
            state.completed_results[command_id] = dict(current)
            changed = True
    if len(state.completed_results) > state.tombstone_limit:
        ordered = sorted(
            state.completed_results.items(),
            key=lambda item: float((item[1] or {}).get("recorded_at", 0) or 0),
        )
        for command_id, _result in ordered[:-state.tombstone_limit]:
            state.completed_results.pop(command_id, None)
            changed = True
    if changed and not hooks.persist():
        raise RuntimeError("Delivered command acknowledgement could not be cleared")
def _append_local_audit(event, **fields):
    try:
        try:
            if os.path.isfile(AUDIT_PATH) and os.path.getsize(AUDIT_PATH) > AUDIT_MAX_BYTES:
                os.replace(AUDIT_PATH, AUDIT_PATH + ".1")
        except Exception:
            pass
        entry = {
            "time": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
            "event": event,
            "launcher_host_id": LAUNCHER_HOST_ID,
            "client_id": CLIENT_ID,
            **fields,
        }
        with open(AUDIT_PATH, "a", encoding="utf-8") as f:
            f.write(json.dumps(entry, separators=(",", ":"), sort_keys=True) + "\n")
        try:
            os.chmod(AUDIT_PATH, 0o600)
        except Exception:
            pass
    except Exception:
        pass

def _read_local_audit_tail(limit=25):
    try:
        if not os.path.isfile(AUDIT_PATH):
            return []
        with open(AUDIT_PATH, "r", encoding="utf-8", errors="replace") as f:
            lines = f.readlines()[-limit:]
        entries = []
        for line in lines:
            try:
                item = json.loads(line)
                if isinstance(item, dict):
                    entries.append(item)
            except Exception:
                pass
        return entries
    except Exception:
        return []

def _load_runtime_state():
    global agent_runtime_meta, _pending_cache_purge_ack, _pending_agent_cache_purge_acks
    global _completed_cache_purge_request_id, _completed_agent_cache_purge_request_ids
    global _pending_command_results, _completed_command_results
    try:
        if os.path.isfile(STATE_PATH):
            with open(STATE_PATH, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                agent_runtime_meta = data.get("agents", {}) if isinstance(data.get("agents"), dict) else {}
                raw_ack = data.get("pending_cache_purge_ack")
                if (
                    isinstance(raw_ack, dict)
                    and isinstance(raw_ack.get("request_id"), str)
                    and raw_ack.get("request_id").strip()
                    and raw_ack.get("status") == "succeeded"
                ):
                    _pending_cache_purge_ack = {
                        "request_id": raw_ack["request_id"].strip(),
                        "status": "succeeded",
                    }
                raw_agent_acks = data.get("pending_agent_cache_purge_acks")
                if isinstance(raw_agent_acks, dict):
                    _pending_agent_cache_purge_acks = {
                        str(agent_id): {
                            "request_id": ack["request_id"].strip(),
                            "success": True,
                        }
                        for agent_id, ack in raw_agent_acks.items()
                        if (
                            isinstance(agent_id, str)
                            and agent_id
                            and isinstance(ack, dict)
                            and isinstance(ack.get("request_id"), str)
                            and ack.get("request_id").strip()
                            and ack.get("success") is True
                        )
                    }
                completed_id = data.get("completed_cache_purge_request_id")
                if isinstance(completed_id, str):
                    _completed_cache_purge_request_id = completed_id.strip()
                completed_agent_ids = data.get("completed_agent_cache_purge_request_ids")
                if isinstance(completed_agent_ids, dict):
                    _completed_agent_cache_purge_request_ids = {
                        str(agent_id): request_id.strip()
                        for agent_id, request_id in completed_agent_ids.items()
                        if isinstance(agent_id, str) and agent_id and isinstance(request_id, str) and request_id.strip()
                    }
                raw_command_results = data.get("pending_command_results")
                if isinstance(raw_command_results, dict):
                    _pending_command_results = {
                        str(command_id): dict(result)
                        for command_id, result in raw_command_results.items()
                        if (
                            isinstance(command_id, str)
                            and command_id.strip()
                            and isinstance(result, dict)
                            and result.get("state") in ("accepted", "succeeded", "failed")
                        )
                    }
                    for command_id, result in list(_pending_command_results.items()):
                        if result.get("state") != "accepted":
                            continue
                        if result.get("target_type") == "launcher" and result.get("command") == "restart":
                            result["state"] = "succeeded"
                            result["completed_at"] = time.time()
                        else:
                            result["state"] = "failed"
                            result["error"] = "Launcher restarted before it could verify command completion"
                            result["completed_at"] = time.time()
                raw_completed_results = data.get("completed_command_results")
                if isinstance(raw_completed_results, dict):
                    _completed_command_results = {
                        str(command_id): dict(result)
                        for command_id, result in raw_completed_results.items()
                        if (
                            isinstance(command_id, str)
                            and command_id.strip()
                            and isinstance(result, dict)
                            and result.get("state") in ("succeeded", "failed")
                        )
                    }
                changed = False
                for aid, meta in agent_runtime_meta.items():
                    if not isinstance(meta, dict):
                        continue
                    if meta.get("last_payload"):
                        meta["last_payload"] = ""
                        changed = True
                    if meta.get("last_payload_encrypted"):
                        try:
                            _atomic_write_text(_payload_cache_path(aid), meta["last_payload_encrypted"])
                        except Exception:
                            pass
                        meta.pop("last_payload_encrypted", None)
                        changed = True
                if changed:
                    _persist_runtime_state()
                elif raw_command_results is not None:
                    _persist_runtime_state()
    except Exception:
        agent_runtime_meta = {}
        _pending_cache_purge_ack = {}
        _pending_agent_cache_purge_acks = {}
        _completed_cache_purge_request_id = ""
        _completed_agent_cache_purge_request_ids = {}
        _pending_command_results = {}
        _completed_command_results = {}

def _persist_runtime_state():
    try:
        payload = {
            "agents": agent_runtime_meta,
            "pending_cache_purge_ack": _pending_cache_purge_ack,
            "pending_agent_cache_purge_acks": _pending_agent_cache_purge_acks,
            "completed_cache_purge_request_id": _completed_cache_purge_request_id,
            "completed_agent_cache_purge_request_ids": _completed_agent_cache_purge_request_ids,
            "pending_command_results": _pending_command_results,
            "completed_command_results": _completed_command_results,
            "updated_at": time.time(),
        }
        tmp_path = f"{STATE_PATH}.tmp"
        with open(tmp_path, "w", encoding="utf-8") as f:
            json.dump(payload, f, separators=(",", ":"), sort_keys=True)
            f.flush()
            try:
                os.fsync(f.fileno())
            except Exception:
                pass
        os.replace(tmp_path, STATE_PATH)
        try:
            os.chmod(STATE_PATH, 0o600)
        except Exception:
            pass
        return True
    except Exception:
        return False

def _request_with_retries(path, payload, timeout=15, attempts=3, backoff=1.25):
    last_exc = None
    for attempt in range(max(1, attempts)):
        try:
            return _signed_post_json(path, payload, timeout=timeout)
        except Exception as exc:
            last_exc = exc
            if attempt >= attempts - 1:
                break
            time.sleep(min(5, backoff * (attempt + 1)))
    raise last_exc

def _runtime_meta(agent_id):
    return agent_runtime_meta.setdefault(agent_id, {
        "crash_times": [],
        "last_start_at": 0.0,
        "last_payload": "",
        "last_payload_encrypted": "",
        "last_payload_hash": "",
        "suspended_until": 0.0,
        "suspension_reason": "",
        "last_fetch_failure_at": 0.0,
    })

def _launcher_source_hash():
    try:
        with open(os.path.realpath(__file__), "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except Exception:
        return ""

def _host_fingerprint():
    try:
        raw = "|".join([
            socket.gethostname(),
            platform.system(),
            platform.release(),
            platform.machine(),
            os.path.dirname(os.path.realpath(__file__)),
        ])
        return hashlib.sha256(raw.encode("utf-8", errors="ignore")).hexdigest()
    except Exception:
        return ""

def _payload_cache_path(agent_id, slot="current"):
    suffix = "" if slot == "current" else "_" + _safe_agent_slug(slot)
    return os.path.join(_DATA_DIR, "launcher_payload_" + _safe_agent_slug(agent_id) + suffix + ".cache")

def _record_spawn(agent_id, payload, payload_hash, candidate_version="", persist_state=True):
    meta = _runtime_meta(agent_id)
    meta_before = dict(meta)
    meta["last_start_at"] = time.time()
    meta["last_payload"] = ""
    meta.pop("last_payload_encrypted", None)
    _atomic_write_text(
        _payload_cache_path(agent_id, "candidate"),
        _encrypt_runtime_cache_text(payload or ""),
    )
    meta["candidate_payload_hash"] = hashlib.sha256((payload or "").encode("utf-8")).hexdigest()
    meta["candidate_contract_hash"] = payload_hash or ""
    meta["candidate_version"] = candidate_version or LAUNCHER_VERSION
    meta["candidate_started_at"] = time.time()
    meta["candidate_health_ok"] = False
    meta["candidate_health_observed_at"] = 0.0
    meta["suspended_until"] = 0.0
    meta["suspension_reason"] = ""
    if persist_state and not _persist_runtime_state():
        meta.clear()
        meta.update(meta_before)
        try:
            os.remove(_payload_cache_path(agent_id, "candidate"))
        except FileNotFoundError:
            pass
        raise RuntimeError("candidate runtime state could not be persisted")
    _append_local_audit("agent_candidate_started", agent_id=agent_id, version=meta["candidate_version"], source_hash=meta["candidate_payload_hash"])

def _promote_candidate(agent_id):
    meta = _runtime_meta(agent_id)
    meta_before = dict(meta)
    candidate = _payload_cache_path(agent_id, "candidate")
    current = _payload_cache_path(agent_id)
    previous = _payload_cache_path(agent_id, "previous")
    if not os.path.isfile(candidate):
        return False
    try:
        if os.path.isfile(current):
            shutil.copy2(current, previous)
        os.replace(candidate, current)
        meta["last_payload_hash"] = meta.get("candidate_contract_hash", "")
        promoted_version = meta.get("candidate_version", "")
        promoted_hash = meta.get("candidate_payload_hash", "")
        for key in ("candidate_payload_hash", "candidate_contract_hash", "candidate_version", "candidate_started_at", "candidate_health_ok", "candidate_health_observed_at"):
            meta.pop(key, None)
        meta["active_runtime_version"] = promoted_version
        meta["active_source_hash"] = promoted_hash
        meta["blocked_runtime_version"] = ""
        meta["last_promoted_at"] = time.time()
        if not _persist_runtime_state():
            meta.clear()
            meta.update(meta_before)
            raise RuntimeError("promoted runtime state could not be persisted")
        _append_local_audit("agent_candidate_promoted", agent_id=agent_id, version=promoted_version, source_hash=promoted_hash)
        return True
    except Exception as exc:
        _append_local_audit("agent_candidate_promotion_failed", agent_id=agent_id, error=str(exc)[:200])
        return False

def _rollback_candidate(agent_id, name):
    meta = _runtime_meta(agent_id)
    failed_version = str(meta.get("candidate_version") or "")
    failed_hash = str(meta.get("candidate_payload_hash") or "")
    meta["candidate_command_outcome"] = "failed"
    candidate = _payload_cache_path(agent_id, "candidate")
    previous = _payload_cache_path(agent_id, "previous")
    current = _payload_cache_path(agent_id)
    try:
        if os.path.isfile(candidate):
            os.remove(candidate)
        else:
            current_payload = None
            if os.path.isfile(current):
                try:
                    with open(current, "r", encoding="utf-8") as cache_file:
                        current_payload = _decrypt_runtime_cache_text(cache_file.read())
                except Exception:
                    current_payload = None
            current_hash = hashlib.sha256((current_payload or "").encode("utf-8")).hexdigest() if current_payload is not None else ""
            if current_hash and failed_hash and hmac.compare_digest(current_hash, failed_hash):
                if not os.path.isfile(previous):
                    raise RuntimeError("last-known-good cache is missing after partial promotion")
                os.replace(previous, current)
        with open(current, "r", encoding="utf-8") as cache_file:
            restored_payload = _decrypt_runtime_cache_text(cache_file.read())
        restored_hash = hashlib.sha256((restored_payload or "").encode("utf-8")).hexdigest() if restored_payload is not None else ""
        if not restored_payload or (failed_hash and hmac.compare_digest(restored_hash, failed_hash)):
            raise RuntimeError("rollback cache still contains the blocked candidate")
    except Exception as exc:
        _append_local_audit(
            "agent_candidate_rollback_failed",
            agent_id=agent_id,
            version=failed_version,
            error=str(exc)[:200],
        )
        return False
    for key in ("candidate_payload_hash", "candidate_contract_hash", "candidate_version", "candidate_started_at", "candidate_health_ok", "candidate_health_observed_at"):
        meta.pop(key, None)
    meta["blocked_runtime_version"] = failed_version
    meta["last_rollback_at"] = time.time()
    meta["rollback_count"] = int(meta.get("rollback_count", 0) or 0) + 1
    if not _persist_runtime_state():
        _append_local_audit("agent_candidate_rollback_failed", agent_id=agent_id, version=failed_version, error="rollback state persistence failed")
        return False
    restored = _spawn_from_cached_payload(agent_id, name)
    _append_local_audit("agent_candidate_rolled_back", agent_id=agent_id, version=failed_version, restored=restored)
    if restored:
        log_agent("ROLLED BACK", agent_id, name, f"candidate {failed_version} failed health gate; restored last known good", level="WARN")
    return restored

def _reject_agent_candidate(agent_id, name, reason):
    meta = _runtime_meta(agent_id)
    failed_version = str(meta.get("candidate_version") or "")
    if not kill_agent(agent_id, name, reason=reason, wait_for_ports=True):
        _append_local_audit("agent_candidate_containment_failed", agent_id=agent_id, reason=reason)
        return False
    recovered = _rollback_candidate(agent_id, name)
    if not recovered:
        # A first install has no known-good cache. Do not keep a dead candidate
        # pending forever, or retry a failing start without the normal budget.
        for key in ("candidate_payload_hash", "candidate_contract_hash", "candidate_version", "candidate_started_at", "candidate_health_ok", "candidate_health_observed_at"):
            meta.pop(key, None)
        meta["blocked_runtime_version"] = failed_version
        _record_crash(agent_id)
    receipt = meta.get("candidate_command_receipt")
    if isinstance(receipt, dict):
        _queue_command_result(receipt, "agent", agent_id, str(receipt.get("command") or "restart"), "failed",
                              "Candidate failed verification; previous verified cache restored" if recovered else "Candidate failed verification; no previous runtime could be restored")
        meta.pop("candidate_command_receipt", None)
        meta.pop("candidate_command_outcome", None)
    _persist_runtime_state()
    return recovered


def _promote_healthy_candidates():
    now = time.time()
    for agent_id, meta in list(agent_runtime_meta.items()):
        proc = agents.get(agent_id)
        meta = _runtime_meta(agent_id)
        receipt = meta.get("candidate_command_receipt")
        if isinstance(receipt, dict) and meta.get("candidate_command_outcome") and (meta.get("candidate_command_outcome") == "failed" or meta.get("command_runtime_ready") is True):
            outcome = str(meta.get("candidate_command_outcome"))
            try:
                _queue_command_result(receipt, "agent", agent_id, str(receipt.get("command") or "restart"), outcome,
                                      "Candidate failed verification; recovery to the previous cache was attempted" if outcome == "failed" else "")
                meta.pop("candidate_command_receipt", None)
                meta.pop("candidate_command_outcome", None)
                _persist_runtime_state()
            except Exception as exc:
                _append_local_audit("candidate_command_result_deferred", agent_id=agent_id, error=str(exc)[:200])
        started = float(meta.get("candidate_started_at", 0) or 0)
        if not (meta.get("candidate_version") and started):
            continue
        if proc is None or proc.poll() is not None:
            _reject_agent_candidate(agent_id, agent_names.get(agent_id, agent_id), "candidate-exited")
            continue
        observed_at = float(meta.get("candidate_health_observed_at", 0) or 0)
        if now - started >= AGENT_CANDIDATE_HEALTH_SECONDS and meta.get("candidate_health_ok") is True and observed_at >= started and now - observed_at < 60:
            if _promote_candidate(agent_id):
                if isinstance(meta.get("candidate_command_receipt"), dict):
                    meta["candidate_command_outcome"] = "succeeded"
                    _persist_runtime_state()
            else:
                name = agent_names.get(agent_id, agent_id)
                _reject_agent_candidate(agent_id, name, "candidate-promotion-failed")
        elif now - started >= AGENT_CANDIDATE_HEALTH_SECONDS + 60:
            name = agent_names.get(agent_id, agent_id)
            _reject_agent_candidate(agent_id, name, "candidate-health-failed")

def _record_crash(agent_id):
    meta = _runtime_meta(agent_id)
    now = time.time()
    kept = [ts for ts in meta.get("crash_times", []) if now - ts < AGENT_RESPAWN_WINDOW_SECONDS]
    kept.append(now)
    meta["crash_times"] = kept
    if len(kept) >= AGENT_RESPAWN_MAX_ATTEMPTS:
        meta["suspended_until"] = now + AGENT_RESPAWN_WINDOW_SECONDS
        meta["suspension_reason"] = f"crash-loop:{len(kept)}"
        _persist_runtime_state()
        _append_local_audit("agent_crash_loop_suspended", agent_id=agent_id, crash_count=len(kept), suspended_until=meta["suspended_until"])
        return False
    _persist_runtime_state()
    return True

def _can_attempt_start(agent_id):
    meta = _runtime_meta(agent_id)
    suspended_until = float(meta.get("suspended_until", 0) or 0)
    if suspended_until and time.time() < suspended_until:
        return False, int(max(1, suspended_until - time.time())), meta.get("suspension_reason", "suspended")
    if suspended_until and time.time() >= suspended_until:
        meta["suspended_until"] = 0.0
        meta["suspension_reason"] = ""
        meta["crash_times"] = []
        _persist_runtime_state()
    return True, 0, ""

def _clear_runtime_meta(agent_id):
    meta = _runtime_meta(agent_id)
    meta["crash_times"] = []
    meta["suspended_until"] = 0.0
    meta["suspension_reason"] = ""
    _persist_runtime_state()

def _purge_agent_runtime_cache(agent_id, name="unnamed"):
    try:
        if agent_id in agents:
            if not kill_agent(agent_id, name=name, reason="cache-purge"):
                return False
        cache_paths = [_payload_cache_path(agent_id, slot) for slot in ("current", "candidate", "previous")]
        cache_paths.append(get_agent_filepath(agent_id))
        for cache_path in cache_paths:
            if os.path.isfile(cache_path):
                os.remove(cache_path)
        if any(os.path.exists(cache_path) for cache_path in cache_paths) or agent_id in agents:
            return False
        agent_runtime_meta.pop(agent_id, None)
        _append_local_audit("agent_runtime_cache_purged", agent_id=agent_id, name=name)
        return True
    except Exception as exc:
        _append_local_audit("agent_runtime_cache_purge_failed", agent_id=agent_id, name=name, error=str(exc)[:200])
        return False

def _purge_launcher_runtime_cache():
    try:
        if not shutdown_all_agents(reason="cache-purge"):
            return False
        if not cleanup_orphaned_runtime_processes():
            return False
        cleanup_agent_artifacts()
        for filename in os.listdir(_DATA_DIR):
            if filename.startswith("launcher_payload_") and filename.endswith(".cache"):
                os.remove(os.path.join(_DATA_DIR, filename))
        remaining = [
            filename
            for filename in os.listdir(_DATA_DIR)
            if filename.startswith("launcher_payload_") and filename.endswith(".cache")
        ]
        if agents or remaining:
            return False
        agent_runtime_meta.clear()
        _append_local_audit("launcher_runtime_cache_purged")
        return True
    except Exception as exc:
        _append_local_audit("launcher_runtime_cache_purge_failed", error=str(exc)[:200])
        return False

def _clear_delivered_cache_purge_acks(sent_cache_ack, sent_agent_acks):
    global _pending_cache_purge_ack, _pending_agent_cache_purge_acks
    changed = False
    if sent_cache_ack and _pending_cache_purge_ack == sent_cache_ack:
        _pending_cache_purge_ack = {}
        changed = True
    for agent_id, sent_ack in (sent_agent_acks or {}).items():
        if _pending_agent_cache_purge_acks.get(agent_id) == sent_ack:
            _pending_agent_cache_purge_acks.pop(agent_id, None)
