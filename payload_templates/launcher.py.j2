"""Launcher orphan-process cleanup with explicit, late-bound effect ports.

This source is inert and importable for synthetic fixtures. The verified runtime
assembler also inlines it into the one complete customer launcher; customers do
not need a neighboring package. It owns the existing bounded scan/stop/recheck
algorithm, not enrollment, startup, signatures, process spawning or permission.
"""


class LauncherOrphanProcessPorts:
    """Only the named effects and current identities needed by this domain.

    Identity/path providers and effect callbacks remain late-bound so existing
    launcher composition, test substitution and exception ordering are retained.
    Constructing this object performs no I/O or process inspection.
    """

    def __init__(self, *, data_directory, client_id, launcher_host_id,
                 current_pid, process_iter, wait_processes, now, sleep,
                 list_directory, join_path, path_exists, absolute_path,
                 normalize_case, audit, access_denied, no_such_process):
        self.data_directory = data_directory
        self.client_id = client_id
        self.launcher_host_id = launcher_host_id
        self.current_pid = current_pid
        self.process_iter = process_iter
        self.wait_processes = wait_processes
        self.now = now
        self.sleep = sleep
        self.list_directory = list_directory
        self.join_path = join_path
        self.path_exists = path_exists
        self.absolute_path = absolute_path
        self.normalize_case = normalize_case
        self.audit = audit
        self.access_denied = access_denied
        self.no_such_process = no_such_process


class LauncherOrphanProcesses:
    """Own the existing environment/path evidence and bounded orphan cleanup.

    No process/state namespace is injected. Process objects cross the explicit
    process-iterator port; tests supply synthetic objects, never host processes.
    """

    def __init__(self, ports):
        self._ports = ports

    def _process_environ_matches(self, proc, expected):
        try:
            env = proc.environ()
        except Exception:
            return False
        for key, value in expected.items():
            if env.get(key) != value:
                return False
        return True

    def _runtime_path_marker_matches(self, haystack, marker):
        if not marker:
            return False
        try:
            hay = self._ports.normalize_case(self._ports.absolute_path(haystack)) if self._ports.path_exists(haystack) else self._ports.normalize_case(str(haystack))
            needle = self._ports.normalize_case(str(marker))
            return needle in hay
        except Exception:
            return str(marker) in str(haystack)

    def _known_agent_script_paths(self, script_dir):
        paths = set()
        try:
            for name in self._ports.list_directory(script_dir):
                if name.startswith("agent_") and name.endswith(".py"):
                    paths.add(self._ports.join_path(script_dir, name))
        except Exception:
            pass
        return paths

    def cleanup_orphaned_runtime_processes(self):
        script_dir = self._ports.data_directory()
        workspace_marker = self._ports.join_path(script_dir, "infraveil_payload_workspace_")
        agent_scripts = self._known_agent_script_paths(script_dir)
        expected_env = {
            "INFRAVEIL_CLIENT_ID": self._ports.client_id(),
            "INFRAVEIL_LAUNCHER_HOST_ID": self._ports.launcher_host_id(),
        }
        victims = []
        scan_complete = True

        def owned_processes():
            owned = []
            nonlocal scan_complete
            current_pid = self._ports.current_pid()
            deadline = self._ports.now() + 2.5
            for proc in self._ports.process_iter(['pid', 'name', 'cmdline', 'cwd']):
                if self._ports.now() >= deadline:
                    scan_complete = False
                    break
                try:
                    if proc.info["pid"] == current_pid:
                        continue
                    cmdline = " ".join(proc.info.get("cmdline") or [])
                    cwd = proc.info.get("cwd") or ""
                    haystack = f"{cmdline} {cwd}"
                    if (
                        self._process_environ_matches(proc, expected_env)
                        or any(self._runtime_path_marker_matches(haystack, path) for path in agent_scripts)
                        or self._runtime_path_marker_matches(haystack, workspace_marker)
                    ):
                        owned.append(proc)
                except self._ports.access_denied:
                    scan_complete = False
                except (self._ports.no_such_process, KeyError):
                    continue
                except Exception:
                    scan_complete = False
            return owned

        try:
            victims = owned_processes()
            for proc in victims:
                try:
                    proc.terminate()
                except Exception:
                    pass
            _, alive = self._ports.wait_processes(victims, timeout=2)
            for proc in alive:
                try:
                    proc.kill()
                except Exception:
                    pass
            if victims:
                self._ports.sleep(0.5)
            survivors = owned_processes()
            if survivors or not scan_complete:
                self._ports.audit(
                    "orphan_runtime_cleanup_failed",
                    surviving_pids=[proc.pid for proc in survivors],
                    scan_complete=scan_complete,
                )
                return False
            return True
        except Exception as exc:
            self._ports.audit("orphan_runtime_cleanup_failed", error=str(exc)[:200])
            return False
def _safe_agent_slug(agent_id):
    raw = str(agent_id or "agent")
    cleaned = re.sub(r"[^A-Za-z0-9_.-]+", "_", raw).strip("._-") or "agent"
    digest = hashlib.sha256(raw.encode("utf-8", errors="ignore")).hexdigest()[:12]
    return f"{cleaned[:48]}_{digest}"

def get_agent_filepath(agent_id):
    return os.path.join(_DATA_DIR, f"agent_{_safe_agent_slug(agent_id)}.py")

