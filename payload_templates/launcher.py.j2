def _restrict_private_windows_path(path, directory=False):
    system32 = os.path.join(os.environ.get("SystemRoot", "C:\\Windows"), "System32")
    identity = subprocess.run(
        [os.path.join(system32, "whoami.exe"), "/user", "/fo", "csv", "/nh"],
        capture_output=True, text=True, check=True, timeout=15,
    )
    rows = list(csv.reader(identity.stdout.splitlines()))
    if len(rows) != 1 or len(rows[0]) != 2 or not re.fullmatch(r"S-\d+(?:-\d+)+", rows[0][1]):
        raise RuntimeError("Could not identify the Windows account for private runtime files")
    permission = "*" + rows[0][1] + (":(OI)(CI)F" if directory else ":F")
    subprocess.run(
        [os.path.join(system32, "icacls.exe"), os.path.abspath(path), "/inheritance:r", "/grant:r", permission],
        stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, check=True, timeout=15,
    )

def _atomic_write_bytes(path, data):
    """Keep exact signed bytes private before writing and across replacement."""
    if not isinstance(data, bytes):
        raise TypeError("Private runtime writes require bytes")
    target = os.path.abspath(path)
    parent = os.path.dirname(target)
    # A private staging directory protects creation-time ACLs without changing
    # permissions on a caller's Downloads, Startup or LaunchAgents directory.
    staging = tempfile.mkdtemp(prefix=".infraveil-write-", dir=parent)
    temporary = os.path.join(staging, "payload")
    descriptor = None
    try:
        if os.name == "nt":
            _restrict_private_windows_path(staging, directory=True)
        else:
            os.chmod(staging, 0o700)
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_BINARY", 0), 0o600)
        if os.name == "nt":
            _restrict_private_windows_path(temporary)
        with os.fdopen(descriptor, "wb") as handle:
            descriptor = None
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, target)
    finally:
        if descriptor is not None:
            os.close(descriptor)
        shutil.rmtree(staging)

def _atomic_write_text(path, text):
    _atomic_write_bytes(path, text.encode("utf-8"))

def _validate_launcher_source_context(source, expected_version):
    """The already-verified source signature also signs these generated fields."""
    tree = ast.parse(source)
    names = {"CLIENT_ID", "LAUNCHER_HOST_ID", "LAUNCHER_VERSION"}
    definitions = {}
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets) == 1:
            target = node.targets[0]
            if isinstance(target, ast.Name) and target.id in names:
                if target.id in definitions:
                    raise ValueError("Ambiguous launcher deployment identity")
                definitions[target.id] = node.value
    # Reject annotated, tuple, augmented, nested and other duplicate bindings.
    for name in names:
        stores = [node for node in ast.walk(tree) if isinstance(node, ast.Name) and node.id == name and isinstance(node.ctx, (ast.Store, ast.Del))]
        if len(stores) != 1 or name not in definitions:
            raise ValueError("Missing or ambiguous launcher deployment identity: " + name)

    def literal(node):
        if not isinstance(node, ast.Constant) or not isinstance(node.value, str):
            raise ValueError("Launcher deployment identity must be a string literal")
        return node.value

    client_id = literal(definitions["CLIENT_ID"])
    host_id = literal(definitions["LAUNCHER_HOST_ID"])
    version_node = definitions["LAUNCHER_VERSION"]
    if isinstance(version_node, ast.Constant):
        version = literal(version_node)
    elif isinstance(version_node, ast.BoolOp) and isinstance(version_node.op, ast.Or) and len(version_node.values) == 2:
        call, fallback = version_node.values
        if not (isinstance(call, ast.Call) and isinstance(call.func, ast.Attribute) and call.func.attr == "strip" and not call.args and not call.keywords):
            raise ValueError("Unsupported launcher version declaration")
        version = literal(call.func.value).strip() or literal(fallback)
        literal(fallback)
    else:
        raise ValueError("Unsupported launcher version declaration")
    if client_id != CLIENT_ID or host_id != LAUNCHER_HOST_ID:
        raise ValueError("Signed launcher belongs to a different client or host")
    if not isinstance(expected_version, str) or not expected_version.strip() or version != expected_version.strip():
        raise ValueError("Signed launcher version does not match the requested update")


def _recover_unhealthy_launcher_update():
    if not os.path.isfile(LAUNCHER_UPDATE_MARKER):
        return
    try:
        with open(LAUNCHER_UPDATE_MARKER, "r", encoding="utf-8") as f:
            marker = json.load(f)
        attempts = int(marker.get("boot_attempts", 0) or 0)
        if attempts >= 1 and os.path.isfile(LAUNCHER_PREVIOUS_PATH):
            target = os.path.abspath(__file__)
            with open(LAUNCHER_PREVIOUS_PATH, "rb") as previous:
                previous_source = previous.read()
            _validate_launcher_source_context(previous_source.decode("utf-8"), marker.get("from_version"))
            compile(previous_source, target, "exec")
            _atomic_write_bytes(target, previous_source)
            os.remove(LAUNCHER_UPDATE_MARKER)
            print("[INFRAVEIL]  Launcher update did not reach a healthy sync; restored the previous signed launcher.", flush=True)
            os.execl(sys.executable, sys.executable, *sys.argv)
        marker["boot_attempts"] = attempts + 1
        _atomic_write_text(LAUNCHER_UPDATE_MARKER, json.dumps(marker, separators=(",", ":"), sort_keys=True))
    except Exception as exc:
        print("[INFRAVEIL]  Launcher update recovery check failed: " + str(exc)[:120], flush=True)

