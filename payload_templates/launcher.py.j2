def _runtime_manager(encoded):
    if not encoded or len(encoded) > 2 * 1024 * 1024:
        raise RuntimeError("Approved embedded Trust Console runtime contract is missing")
    identity = hashlib.sha256(encoded.encode("ascii")).hexdigest()
    cached = _RUNTIME_MANAGER_CACHE.get(identity)
    if cached is not None:
        return cached
    source = base64.b64decode(encoded.encode("ascii"), validate=True).decode("utf-8")
    manager = types.ModuleType("_infraveil_approved_runtime_manager")
    manager.__file__ = os.path.abspath(__file__)
    exec(compile(source, "<approved embedded Trust Console>", "exec"), manager.__dict__)
    if len(_RUNTIME_MANAGER_CACHE) >= 8:
        _RUNTIME_MANAGER_CACHE.clear()
    _RUNTIME_MANAGER_CACHE[identity] = manager
    return manager

def _select_managed_runtime(manager):
    inherited = str(os.environ.get("INFRAVEIL_MANAGED_RUNTIME_HOME") or "")
    if inherited and manager._current_runtime_matches(inherited):
        return sys.executable, os.path.abspath(inherited)
    inferred = os.path.dirname(os.path.abspath(sys.prefix))
    if manager._current_runtime_matches(inferred):
        return sys.executable, inferred
    home = os.path.join(os.path.dirname(os.path.realpath(__file__)), ".infraveil", "runtime")
    if manager._current_runtime_matches(home):
        return sys.executable, home
    return manager._prepare_runtime(home), home

def _ensure_launcher_dependencies():
    global RUNTIME_DEPENDENCY_STATUS
    manager = _runtime_manager(TRUST_CONSOLE_B64)
    python_path, home = _select_managed_runtime(manager)
    if not manager._current_runtime_matches(home):
        env = manager._sanitized_runtime_env(home)
        if os.environ.get("INFRAVEIL_NONINTERACTIVE") == "1":
            env["INFRAVEIL_START_GUARD_ADMITTED"] = "1"
        os.execve(python_path, [python_path, "-I", os.path.abspath(__file__)] + sys.argv[1:], env)
        raise RuntimeError("Managed runtime restart did not replace the launcher process")
    RUNTIME_DEPENDENCY_STATUS = {"dependency_lock_sha256": manager._runtime_lock_identity(), "dependency_versions": dict(requirement.split("==", 1) for requirement, _hashes in manager.LOCKED_WHEEL_HASHES), "dependency_runtime_managed": True}
    return python_path

def _runtime_python_for_source(source):
    tree = ast.parse(source)
    values = [node.value for node in tree.body if isinstance(node, ast.Assign) and any(isinstance(target, ast.Name) and target.id == "TRUST_CONSOLE_B64" for target in node.targets)]
    if not values:
        _ensure_launcher_dependencies()
        return sys.executable, dict(os.environ)
    if len(values) != 1:
        raise RuntimeError("Runtime source has ambiguous dependency contracts")
    encoded = ast.literal_eval(values[0])
    if not isinstance(encoded, str):
        raise RuntimeError("Runtime source dependency contract is not a quoted approved value")
    manager = _runtime_manager(encoded)
    python_path, home = _select_managed_runtime(manager)
    return python_path, manager._sanitized_runtime_env(home)

def _require_agent_source_security_epoch(source):
    """Reject cached or fetched agent source from before a security boundary."""
    try:
        tree = ast.parse(source)
    except (SyntaxError, TypeError, ValueError) as exc:
        raise RuntimeError("Agent source security epoch is missing or invalid") from exc
    values = [
        node.value
        for node in tree.body
        if isinstance(node, ast.Assign)
        and any(
            isinstance(target, ast.Name) and target.id == _AGENT_SOURCE_SECURITY_EPOCH_NAME
            for target in node.targets
        )
    ]
    if len(values) != 1:
        raise RuntimeError("Agent source security epoch is missing or ambiguous")
    try:
        epoch = ast.literal_eval(values[0])
    except (ValueError, TypeError) as exc:
        raise RuntimeError("Agent source security epoch is not a literal integer") from exc
    if isinstance(epoch, bool) or not isinstance(epoch, int):
        raise RuntimeError("Agent source security epoch is not a literal integer")
    if epoch < MINIMUM_AGENT_SOURCE_SECURITY_EPOCH:
        raise RuntimeError("Agent source is below the minimum security epoch")
    return epoch

LAUNCHER_START_WINDOW_SECONDS = 300
LAUNCHER_START_MAX_ADMISSIONS = 5
LAUNCHER_START_LOCK_WAIT_SECONDS = 5
LAUNCHER_START_LOCK_STALE_SECONDS = 30

def _launcher_start_guard_error(state_path, exc):
    detail = str(exc).strip()[:120] or exc.__class__.__name__
    return (
        "[INFRAVEIL]  Supervised launcher start blocked because the restart guard state "
        "could not be safely read or updated (" + detail + "). The service will stop retrying. "
        "Review " + state_path + ", fix its ownership/permissions or malformed contents, then "
        "start the service again. Manual launcher runs remain available without "
        "INFRAVEIL_NONINTERACTIVE=1."
    )

def _acquire_launcher_start_lock(state_dir, now):
    lock_path = os.path.join(state_dir, "launcher_start_budget.lock")
    deadline = time.monotonic() + LAUNCHER_START_LOCK_WAIT_SECONDS
    while True:
        try:
            os.mkdir(lock_path, 0o700)
            return lock_path
        except FileExistsError:
            try:
                stat_result = os.stat(lock_path, follow_symlinks=False)
                age = now - float(stat_result.st_mtime)
                if (
                    age > LAUNCHER_START_LOCK_STALE_SECONDS
                    and os.path.isdir(lock_path)
                    and not os.path.islink(lock_path)
                ):
                    os.rmdir(lock_path)
                    continue
            except FileNotFoundError:
                continue
            except OSError:
                pass
            if time.monotonic() >= deadline:
                raise RuntimeError("restart guard lock remained busy")
            time.sleep(0.05)

def _read_launcher_start_state(state_path):
    if not os.path.lexists(state_path):
        return []
    if os.path.islink(state_path) or not os.path.isfile(state_path):
        raise ValueError("restart guard state is not a regular file")
    if os.path.getsize(state_path) > 65536:
        raise ValueError("restart guard state is unexpectedly large")
    os.chmod(state_path, 0o600)
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(state_path, flags)
    with os.fdopen(descriptor, "r", encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, dict) or value.get("version") != 1:
        raise ValueError("restart guard state has an unsupported format")
    starts = value.get("starts")
    if not isinstance(starts, list) or len(starts) > 1000:
        raise ValueError("restart guard start history is invalid")
    validated = []
    for item in starts:
        if isinstance(item, bool) or not isinstance(item, (int, float)):
            raise ValueError("restart guard start history contains a non-number")
        stamp = float(item)
        if stamp < 0 or stamp != stamp or stamp == float("inf"):
            raise ValueError("restart guard start history contains an invalid time")
        validated.append(stamp)
    return validated

def _write_launcher_start_state(state_dir, state_path, starts):
    descriptor, temp_path = tempfile.mkstemp(
        prefix=".launcher_start_budget.", suffix=".tmp", dir=state_dir
    )
    try:
        os.chmod(temp_path, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            descriptor = None
            json.dump({"version": 1, "starts": starts}, handle, separators=(",", ":"), sort_keys=True)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temp_path, state_path)
        os.chmod(state_path, 0o600)
        try:
            directory_fd = os.open(state_dir, os.O_RDONLY)
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        except OSError:
            pass
    finally:
        if descriptor is not None:
            os.close(descriptor)
        try:
            os.remove(temp_path)
        except FileNotFoundError:
            pass

def _admit_supervised_launcher_start(now=None, state_dir=None):
    if (
        os.environ.get("INFRAVEIL_NONINTERACTIVE") != "1"
        or os.environ.get("INFRAVEIL_START_GUARD_ADMITTED") == "1"
    ):
        return True, ""
    now = time.time() if now is None else float(now)
    state_dir = state_dir or os.path.join(os.path.dirname(os.path.realpath(__file__)), ".infraveil")
    state_path = os.path.join(state_dir, "launcher_start_budget.json")
    lock_path = None
    result = None
    try:
        if now < 0 or now != now or now == float("inf"):
            raise ValueError("system clock is invalid")
        if os.path.lexists(state_dir):
            if os.path.islink(state_dir) or not os.path.isdir(state_dir):
                raise ValueError("restart guard directory is not a regular directory")
        else:
            os.makedirs(state_dir, mode=0o700)
        os.chmod(state_dir, 0o700)
        lock_path = _acquire_launcher_start_lock(state_dir, now)
        starts = _read_launcher_start_state(state_path)
        window_start = now - LAUNCHER_START_WINDOW_SECONDS
        starts = [now if stamp > now else stamp for stamp in starts if stamp > window_start]
        if len(starts) >= LAUNCHER_START_MAX_ADMISSIONS:
            result = (False, (
                "[INFRAVEIL]  Supervised launcher restart budget exhausted: "
                + str(LAUNCHER_START_MAX_ADMISSIONS) + " starts were admitted within "
                + str(LAUNCHER_START_WINDOW_SECONDS) + " seconds. The service will stop retrying. "
                "Review the launcher logs and configuration, then start the service again after the "
                "window expires. Manual launcher runs remain available without "
                "INFRAVEIL_NONINTERACTIVE=1."
            ))
        else:
            starts.append(now)
            _write_launcher_start_state(state_dir, state_path, starts)
            result = (True, "")
    except Exception as exc:
        result = (False, _launcher_start_guard_error(state_path, exc))
    finally:
        if lock_path is not None:
            try:
                os.rmdir(lock_path)
            except Exception as exc:
                if result is None or result[0]:
                    result = (False, _launcher_start_guard_error(state_path, exc))
    return result

def _enforce_supervised_launcher_start_budget():
    admitted, message = _admit_supervised_launcher_start()
    if admitted:
        return
    print(message, flush=True)
    raise SystemExit(0)

if __name__ == "__main__":
    _enforce_supervised_launcher_start_budget()

