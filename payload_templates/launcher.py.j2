def _bytes_mb(value):
    try:
        return round(float(value or 0) / (1024 * 1024), 1)
    except Exception:
        return 0.0

def _agent_process_rss_mb(proc):
    total = 0
    try:
        root = psutil.Process(proc.pid)
        procs = [root] + root.children(recursive=True)
        for item in procs:
            try:
                total += item.memory_info().rss
            except Exception:
                pass
    except Exception:
        pass
    return _bytes_mb(total)

def _capacity_resource_budget():
    """Respect the process's CPU affinity and effective Linux cgroup ceilings."""
    vm = psutil.virtual_memory()
    host_cores = psutil.cpu_count(logical=True) or 1
    cores = float(host_cores)
    try:
        cores = min(cores, float(len(os.sched_getaffinity(0))))
    except (AttributeError, OSError):
        try:
            cores = min(cores, float(len(psutil.Process().cpu_affinity())))
        except Exception:
            pass
    result = {"cpu_cores": max(.01, cores), "host_cpu_cores": host_cores,
              "memory_total": int(vm.total), "memory_available": int(vm.available),
              "memory_percent": float(vm.percent), "limited": False, "cpu_usage_seconds": None}
    if sys.platform != "linux":
        return result

    def read(path):
        try:
            with open(path, encoding="ascii") as stream:
                return stream.read(4096).strip()
        except (OSError, UnicodeError):
            return ""

    roots = {"/sys/fs/cgroup"}
    for line in read("/proc/self/cgroup").splitlines():
        parts = line.split(":", 2)
        if len(parts) != 3:
            continue
        relative = parts[2].lstrip("/")
        if ".." in relative.split("/"):
            continue
        controllers = parts[1].split(",") if parts[1] else [""]
        for controller in set(controllers + [parts[1]]):
            if controller not in {"", "cpu", "cpuacct", "cpu,cpuacct", "cpuset", "memory"}:
                continue
            base = "/sys/fs/cgroup" + ("/" + controller if controller else "")
            current = os.path.normpath(os.path.join(base, relative))
            while current == base or current.startswith(base + "/"):
                roots.add(current)
                if current == base:
                    break
                current = os.path.dirname(current)
    cpu_scope = None
    for root in sorted(roots):
        quota = read(root + "/cpu.max").split()
        try:
            allowed = float(quota[0]) / float(quota[1]) if len(quota) == 2 and quota[0] != "max" else None
            if allowed is None:
                q, period = read(root + "/cpu.cfs_quota_us"), read(root + "/cpu.cfs_period_us")
                allowed = float(q) / float(period) if q and period and float(q) > 0 else None
            if allowed is not None and allowed > 0 and allowed <= result["cpu_cores"]:
                result["cpu_cores"] = allowed
                result["limited"] = True
                cpu_scope = root
        except (ValueError, ZeroDivisionError):
            pass
        limit = read(root + "/memory.max") or read(root + "/memory.limit_in_bytes")
        try:
            if limit and limit != "max" and 0 < int(limit) < int(vm.total):
                ceiling = int(limit)
                result["memory_total"] = min(result["memory_total"], ceiling)
                result["limited"] = True
                usage = read(root + "/memory.current") or read(root + "/memory.usage_in_bytes")
                try:
                    used = max(0, int(usage))
                    result["memory_available"] = min(result["memory_available"], max(0, ceiling - used))
                    result["memory_percent"] = max(result["memory_percent"], min(100.0, used * 100 / ceiling))
                except ValueError:
                    result["memory_available"] = 0
        except ValueError:
            pass
    if cpu_scope:
        stat = dict(line.split(None, 1) for line in read(cpu_scope + "/cpu.stat").splitlines() if len(line.split()) == 2)
        try:
            result["cpu_usage_seconds"] = float(stat["usage_usec"]) / 1e6 if "usage_usec" in stat else float(read(cpu_scope + "/cpuacct.usage")) / 1e9
        except ValueError:
            pass
    return result


def run_capacity_diagnostic():
    global last_capacity_diagnostic
    samples = []
    start = time.time()
    previous_budget = _capacity_resource_budget()
    previous_time = time.monotonic()
    for _ in range(10):
        try:
            host_cpu = psutil.cpu_percent(interval=0.2)
            budget = _capacity_resource_budget()
            sampled_at = time.monotonic()
            usage, previous_usage = budget["cpu_usage_seconds"], previous_budget["cpu_usage_seconds"]
            cpu = host_cpu if usage is None or previous_usage is None else max(0, min(100, (usage - previous_usage) * 100 / max(.001, sampled_at - previous_time) / budget["cpu_cores"]))
            previous_budget, previous_time = budget, sampled_at
            du = psutil.disk_usage(os.path.dirname(os.path.realpath(__file__)))
            samples.append({
                "cpu": cpu,
                "memory": budget["memory_percent"],
                "memory_available_mb": _bytes_mb(budget["memory_available"]),
                "disk": du.percent,
                "disk_free_mb": _bytes_mb(du.free),
            })
        except Exception:
            time.sleep(0.2)
    cpu_values = [float(item.get("cpu", 0) or 0) for item in samples] or [0.0]
    mem_values = [float(item.get("memory", 0) or 0) for item in samples] or [0.0]
    disk_values = [float(item.get("disk", 0) or 0) for item in samples] or [0.0]
    budget = _capacity_resource_budget()
    du = psutil.disk_usage(os.path.dirname(os.path.realpath(__file__)))
    per_agent = []
    for agent_id, proc in list(agents.items()):
        if proc and proc.poll() is None:
            per_agent.append(_agent_process_rss_mb(proc))
    observed_agent_mb = round(sum(per_agent) / len(per_agent), 1) if per_agent else 0.0
    planning_agent_mb = max(180.0, observed_agent_mb or 180.0)
    logical_cpu = budget["cpu_cores"]
    physical_cpu = min(float(psutil.cpu_count(logical=False) or logical_cpu), logical_cpu)
    avg_cpu = round(sum(cpu_values) / len(cpu_values), 1)
    peak_cpu = round(max(cpu_values), 1)
    avg_mem = round(sum(mem_values) / len(mem_values), 1)
    peak_mem = round(max(mem_values), 1)
    avg_disk = round(sum(disk_values) / len(disk_values), 1)
    available_mem_mb = _bytes_mb(budget["memory_available"])
    free_disk_mb = _bytes_mb(du.free)
    cpu_room = max(0.0, 72.0 - avg_cpu)
    cpu_capacity = max(0, int((cpu_room / 8.0) * logical_cpu / 2))
    memory_capacity = max(0, int((available_mem_mb * 0.70) / planning_agent_mb)) if planning_agent_mb else 0
    disk_capacity = max(0, int((free_disk_mb * 0.70) / 250.0)) if free_disk_mb else 0
    current_agents = len([p for p in agents.values() if p and p.poll() is None])
    additional = min(cpu_capacity, memory_capacity, disk_capacity, 250)
    safe_capacity = current_agents + additional
    burst_capacity = current_agents + min(cpu_capacity * 2, memory_capacity, disk_capacity, 500)
    limiting = min(
        [("cpu", cpu_capacity), ("memory", memory_capacity), ("disk", disk_capacity)],
        key=lambda item: item[1],
    )[0]
    if avg_cpu >= 80 or avg_mem >= 85 or avg_disk >= 90:
        rating = "constrained"
    elif safe_capacity <= max(2, len(agents)):
        rating = "tight"
    elif safe_capacity >= 20:
        rating = "strong"
    else:
        rating = "healthy"
    last_capacity_diagnostic = {
        "generated_at": time.time(),
        "duration_seconds": round(time.time() - start, 2),
        "estimate_only": True,
        "confidence": "low",
        "sample_count": len(samples),
        "resource_scope": "process/cgroup limits" if budget["limited"] else "host and process affinity",
        "additional_workload_estimate": additional,
        "rating": rating,
        "safe_agent_capacity": safe_capacity,
        "burst_agent_capacity": burst_capacity,
        "current_agents": len([p for p in agents.values() if p and p.poll() is None]),
        "limiting_resource": limiting,
        "cpu": {
            "logical_cores": logical_cpu,
            "physical_cores": physical_cpu,
            "average_percent": avg_cpu,
            "peak_percent": peak_cpu,
            "estimated_capacity": cpu_capacity,
        },
        "memory": {
            "total_mb": _bytes_mb(budget["memory_total"]),
            "available_mb": available_mem_mb,
            "average_percent": avg_mem,
            "peak_percent": peak_mem,
            "observed_per_agent_mb": observed_agent_mb,
            "planning_per_agent_mb": planning_agent_mb,
            "estimated_capacity": memory_capacity,
        },
        "disk": {
            "total_mb": _bytes_mb(du.total),
            "free_mb": free_disk_mb,
            "average_percent": avg_disk,
            "estimated_capacity": disk_capacity,
        },
        "recommendations": [
            "Planning estimate only; this short diagnostic is not a throughput or load test.",
            "Slots count enrolled workloads, not every API process or requests per second.",
            "Validate with representative workloads before changing placement limits.",
        ],
    }
    _append_local_audit("capacity_diagnostic", **last_capacity_diagnostic)
    log(f"Capacity diagnostic complete: {json.dumps(last_capacity_diagnostic, separators=(',', ':'), sort_keys=True)}", level="OK")

def _natural_name_key(name):
    name = str(name or "").lower()
    starter = 0 if name.startswith("starter") else 1
    padded = re.sub(r"\d+", lambda m: m.group().zfill(12), name)
    return (starter, padded)

def _ordered_agent_items(server_agents):
    def sort_key(item):
        agent_id, meta = item
        try:
            order = int(meta.get("rollout_order", 9999) or 9999)
        except Exception:
            order = 9999
        return (order, _natural_name_key(meta.get("name", "")), agent_id)
    return sorted((server_agents or {}).items(), key=sort_key)

def _apply_rollout_delay(meta, agent_id, name):
    try:
        delay = max(0, int(meta.get("rollout_delay_seconds", 0) or 0))
    except Exception:
        delay = 0
    if delay:
        log_agent("WAIT", agent_id, name, f"rollout delay {delay}s", level="INFO")
        slept = 0.0
        while slept < delay and not shutdown_flag:
            step = min(0.5, delay - slept)
            time.sleep(step)
            slept += step

def poll_control_revision():
    """Cheap command cursor check; a change is reconciled by the full signed sync."""
    global last_control_revision, last_control_epoch, control_poll_interval, control_poll_failures
    payload = {
        "client_id": CLIENT_ID,
        "launcher_host_id": LAUNCHER_HOST_ID,
        "since": last_control_revision,
        "epoch": last_control_epoch,
    }
    try:
        response = _signed_post_json("/launcher/control", payload, timeout=4)
        if response.status_code != 200:
            return False
        data = response.json()
        if not isinstance(data, dict):
            return False
        revision = max(0, int(data.get("revision", 0) or 0))
        epoch = str(data.get("epoch") or "")
        control_poll_interval = max(0.5, min(5.0, float(data.get("poll_after_ms", 500) or 500) / 1000.0))
        control_poll_failures = 0
        changed = bool(data.get("changed"))
        if not changed:
            last_control_revision = revision
            last_control_epoch = epoch
        return changed
    except Exception:
        control_poll_failures = min(4, control_poll_failures + 1)
        control_poll_interval = min(5.0, CONTROL_POLL_INTERVAL * (2 ** control_poll_failures))
        return False

def sync():
    global shutdown_flag, control_plane_online, sync_failure_count
    global last_control_revision, last_control_epoch, control_poll_interval, control_poll_failures
    global last_stopped_notice_signature
    global _pending_cache_purge_ack, _pending_agent_cache_purge_acks
    global _completed_cache_purge_request_id, _completed_agent_cache_purge_request_ids
    global _pending_command_results
    global _command_delivery_protocol
    sent_cache_ack = dict(_pending_cache_purge_ack)
    sent_agent_acks = {
        agent_id: dict(ack)
        for agent_id, ack in _pending_agent_cache_purge_acks.items()
    }
    sent_command_results = [
        dict(result)
        for result in list(_pending_command_results.values())[:COMMAND_RESULT_BATCH_LIMIT]
    ]
    sync_payload = {
        "client_id": CLIENT_ID,
        "launcher_host_id": LAUNCHER_HOST_ID,
        "command_protocol_version": 2,
        "launcher_status": _launcher_status_payload(),
    }
    if sent_cache_ack:
        sync_payload["cache_purge_ack"] = sent_cache_ack
    if sent_agent_acks:
        sync_payload["agent_cache_purge_acks"] = sent_agent_acks
    if sent_command_results:
        sync_payload["command_results"] = sent_command_results
    try:
        if (sent_cache_ack or sent_agent_acks or sent_command_results) and not _persist_runtime_state():
            raise RuntimeError("Could not persist pending control-plane acknowledgement")
        r = _request_with_retries("/launcher/sync", sync_payload, timeout=15, attempts=2)
        if r.status_code == 403:
            try:
                rejection = r.json()
            except (TypeError, ValueError):
                rejection = None
            # Transport verifies the response signature, nonce, path and status
            # before returning it. A generic auth or lookup failure is not a
            # revocation; retain local workloads unless revocation is explicit.
            if isinstance(rejection, dict) and rejection.get("error") == "Machine credential revoked":
                perform_launcher_shutdown(reason="workspace-revoked", message="Launcher credential explicitly revoked by control plane. Stopping all agents and shutting down...")
                return
        if r.status_code != 200:
            raise RuntimeError(f"Sync rejected with status {r.status_code}")
        data = r.json()
        if not isinstance(data, dict):
            raise RuntimeError("Sync response is not a JSON object")
        try:
            _command_delivery_protocol = int(data.get("command_protocol_version", 1) or 1)
        except (TypeError, ValueError):
            _command_delivery_protocol = 1
    except Exception as exc:
        sync_failure_count += 1
        if control_plane_online:
            log(f"Control plane unreachable: {exc}. Keeping local agents running.", level="WARN")
        control_plane_online = False
        return False

    _clear_delivered_cache_purge_acks(sent_cache_ack, sent_agent_acks)
    accepted_command_result_ids = data.get("accepted_command_result_ids")
    if not isinstance(accepted_command_result_ids, list):
        accepted_command_result_ids = []
    _clear_delivered_command_results(sent_command_results, accepted_command_result_ids)
    if not control_plane_online:
        log("Control plane connectivity restored.", level="OK")
    control_plane_online = True
    sync_failure_count = 0
    try:
        last_control_revision = max(0, int(data.get("control_revision", last_control_revision) or 0))
    except (TypeError, ValueError):
        pass
    last_control_epoch = str(data.get("control_epoch") or last_control_epoch)
    control_poll_interval = CONTROL_POLL_INTERVAL
    control_poll_failures = 0
    _confirm_launcher_update()

    l_cmd = data.get("launcher_command", "maintain")
    launcher_receipt = data.get("launcher_command_receipt")
    if l_cmd == "maintain" and _command_receipt_id(launcher_receipt):
        if _begin_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd):
            _queue_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd, "succeeded")
    _pub = str(data.get("published_runtime_version") or "").strip()
    if data.get("launcher_update_available") and _pub and _pub != LAUNCHER_VERSION:
        _self_update(_pub)
    if data.get("cache_purge_requested"):
        purge_request_id = data.get("cache_purge_request_id")
        if not isinstance(purge_request_id, str) or not purge_request_id.strip():
            log("Ignored runtime cache purge request without a valid request id.", level="ERR")
            _append_local_audit("launcher_runtime_cache_purge_rejected", reason="missing-request-id")
            return True
        purge_request_id = purge_request_id.strip()
        if purge_request_id == _completed_cache_purge_request_id:
            _append_local_audit("launcher_runtime_cache_purge_stale", request_id=purge_request_id)
            return True
        log("Received runtime cache purge request. Clearing local cache and runtime artifacts...", level="WARN")
        if _purge_launcher_runtime_cache():
            _pending_cache_purge_ack = {"request_id": purge_request_id, "status": "succeeded"}
            _completed_cache_purge_request_id = purge_request_id
            _persist_runtime_state()
            log("Runtime cache purge completed; acknowledgement queued.", level="OK")
        else:
            log("Runtime cache purge failed; no acknowledgement will be sent.", level="ERR")
        return True
    if l_cmd == "stop":
        if not _begin_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd):
            return True
        perform_launcher_shutdown(
            reason="signal-shutdown",
            message="Received shutdown request from workspace. Shutting down daemon...",
            command_receipt=launcher_receipt,
            command=l_cmd,
        )
        return False
    elif l_cmd == "doctor":
        if not _begin_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd):
            return True
        try:
            run_doctor()
            _queue_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd, "succeeded")
        except Exception as exc:
            _queue_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd, "failed", str(exc))
        return True
    elif l_cmd == "capacity-diagnostic":
        if not _begin_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd):
            return True
        try:
            run_capacity_diagnostic()
            _queue_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd, "succeeded")
        except Exception as exc:
            _queue_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd, "failed", str(exc))
        return True
    elif l_cmd == "restart":
        if not _begin_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd):
            return True
        log("Received workspace restart request. Rebooting daemon...", level="WARN")
        if not shutdown_all_agents(reason="launcher-restart"):
            _queue_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd, "failed", "One or more agents could not be stopped")
            return True
        if not cleanup_orphaned_runtime_processes():
            _queue_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd, "failed", "Runtime process containment could not be verified")
            return True
        cleanup_agent_artifacts()
        try:
            os.execl(sys.executable, sys.executable, *sys.argv)
        except Exception as exc:
            _queue_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd, "failed", str(exc))
            return True
    elif l_cmd == "clear-workspace":
        if not _begin_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd):
            return True
        log("Received workspace reset request. Clearing local runtime state...", level="WARN")
        if not shutdown_all_agents(reason="workspace-clear"):
            _queue_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd, "failed", "One or more agents could not be stopped")
            return True
        if not cleanup_orphaned_runtime_processes():
            _queue_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd, "failed", "Runtime process containment could not be verified")
            return True
        cleanup_agent_artifacts()
        _queue_command_result(launcher_receipt, "launcher", LAUNCHER_HOST_ID, l_cmd, "succeeded")
        return True

    server_agents = data.get("agents", {})
    changed = False

    ordered = _ordered_agent_items(server_agents)
    _prefetch_cache.clear()
    _need_fetch = []
    _stop_targets = []
    _skipped_stopped = 0
    _desired_stopped = []
    for _aid, _meta in ordered:
        if not _meta.get("has_payload", False):
            continue
        if _meta.get("locked") or _meta.get("desired_stopped") or _meta.get("command") == "stop":
            _desired_stopped.append(_aid)
            if _meta.get("command") == "stop" and _command_result_seen(_meta.get("current_command_receipt")):
                _skipped_stopped += 1
                continue
            if agents.get(_aid) is None:
                _skipped_stopped += 1
            else:
                _reason = "locked" if _meta.get("locked") else "stop-cmd"
                _stop_targets.append((_aid, _meta.get("name", "unnamed"), _reason))
            continue
        _p = agents.get(_aid)
        _cmd = _meta.get("command", "maintain")
        _receipt = _meta.get("current_command_receipt")
        if _cmd in ("restart", "update") and (
            _command_result_seen(_receipt)
            or (_command_requires_receipt(_cmd) and not _command_receipt_id(_receipt))
        ):
            continue
        _runtime = _runtime_meta(_aid)
        if not _can_attempt_start(_aid)[0] and (_p is None or _p.poll() is not None):
            continue
        _failed_at = float(_runtime.get("last_fetch_failure_at", 0) or 0)
        if _failed_at and time.time() - _failed_at < AGENT_FETCH_RETRY_DELAY_SECONDS:
            continue
        if _meta.get("command") in ("restart", "update") or _p is None or _p.poll() is not None:
            _need_fetch.append((_aid, _meta.get("name", "unnamed")))
    _stopped_signature = tuple(sorted(_desired_stopped))
    if _skipped_stopped and not _stop_targets and _stopped_signature != last_stopped_notice_signature:
        log(f"{_skipped_stopped} workload{'s' if _skipped_stopped != 1 else ''} stopped (start {'them' if _skipped_stopped != 1 else 'it'} from the dashboard to deploy)", level="WARN")
    last_stopped_notice_signature = _stopped_signature
    if kill_agents_concurrently(_stop_targets):
        changed = True
    if len(_need_fetch) >= 4:
        _progress.begin(len(_need_fetch))
    _prefetch_payloads(_need_fetch)

    for agent_id, meta in ordered:
        cmd = meta.get("command", "maintain")
        command_receipt = meta.get("current_command_receipt")
        locked = bool(meta.get("locked", False) or (meta.get("desired_stopped") and cmd != "doctor"))
        name = meta.get("name", "unnamed")
        payload_hash = meta.get("payload_hash")
        has_payload = meta.get("has_payload", False)
        runtime = _runtime_meta(agent_id)
        candidate_version = str(runtime.get("candidate_version") or "")
        reported_runtime_version = str(meta.get("runtime_agent_version") or "")
        proc = agents.get(agent_id)
        runtime["command_runtime_ready"] = (
            meta.get("runtime_payload_promoted") is True
            and meta.get("runtime_healthy") is True
            and str(meta.get("runtime_payload_hash") or "") == str(runtime.get("last_payload_hash") or runtime.get("candidate_contract_hash") or "")
            and reported_runtime_version == str(runtime.get("active_runtime_version") or candidate_version)
            and proc is not None
            and int(meta.get("runtime_agent_pid", 0) or 0) == int(getattr(proc, "pid", -1))
        )
        if candidate_version:
            runtime["candidate_health_ok"] = (
                reported_runtime_version == candidate_version
                and meta.get("runtime_healthy") is True
                and str(meta.get("runtime_payload_hash") or "") == str(runtime.get("candidate_contract_hash") or "")
                and proc is not None
                and int(meta.get("runtime_agent_pid", 0) or 0) == int(getattr(proc, "pid", -1))
                and float(meta.get("runtime_heartbeat_at", 0) or 0) > 0
            )
            runtime["candidate_health_observed_at"] = time.time()

        if meta.get("cache_purge_requested"):
            purge_request_id = meta.get("cache_purge_request_id")
            if not isinstance(purge_request_id, str) or not purge_request_id.strip():
                log_agent("CACHE PURGE REJECTED", agent_id, name, "missing cache purge request id", level="ERR")
                _append_local_audit("agent_runtime_cache_purge_rejected", agent_id=agent_id, reason="missing-request-id")
                continue
            purge_request_id = purge_request_id.strip()
            if _completed_agent_cache_purge_request_ids.get(agent_id) == purge_request_id:
                _append_local_audit("agent_runtime_cache_purge_stale", agent_id=agent_id, request_id=purge_request_id)
                continue
            was_running = agent_id in agents
            if _purge_agent_runtime_cache(agent_id, name=name):
                _pending_agent_cache_purge_acks[agent_id] = {
                    "request_id": purge_request_id,
                    "success": True,
                }
                _completed_agent_cache_purge_request_ids[agent_id] = purge_request_id
                _persist_runtime_state()
                changed = changed or was_running
                log_agent("CACHE PURGED", agent_id, name, "runtime cache cleared; acknowledgement queued", level="WARN")
            else:
                log_agent("CACHE PURGE FAILED", agent_id, name, "runtime cache was not fully cleared; no acknowledgement queued", level="ERR")
            continue

        if cmd == "maintain" and _command_receipt_id(command_receipt):
            if _begin_command_result(command_receipt, "agent", agent_id, cmd):
                _queue_command_result(command_receipt, "agent", agent_id, cmd, "succeeded")
            continue

        if locked or cmd == "stop":
            should_execute_command = _begin_command_result(command_receipt, "agent", agent_id, cmd) if cmd == "stop" else True
            if cmd == "stop" and not should_execute_command:
                continue
            if agent_id in agents:
                reason = "locked" if locked else "stop-cmd"
                if kill_agent(agent_id, name=name, reason=reason):
                    changed = True
                else:
                    if cmd == "stop":
                        _queue_command_result(command_receipt, "agent", agent_id, cmd, "failed", "Agent process containment could not be verified")
                    continue
            _clear_runtime_meta(agent_id)
            if cmd == "stop":
                _queue_command_result(command_receipt, "agent", agent_id, cmd, "succeeded")
            continue

        if cmd == "doctor":
            if not _begin_command_result(command_receipt, "agent", agent_id, cmd):
                continue
            proc = agents.get(agent_id)
            audit = {
                "agent_id": agent_id,
                "name": name,
                "running": bool(proc is not None and proc.poll() is None),
                "payload_hash": payload_hash or runtime.get("last_payload_hash", ""),
                "has_cached_payload": bool(runtime.get("last_payload_encrypted") or runtime.get("last_payload")),
                "suspended_until": runtime.get("suspended_until", 0.0),
                "crash_count": len(runtime.get("crash_times", [])),
            }
            _append_local_audit("agent_doctor", **audit)
            log_agent("DOCTOR", agent_id, name, json.dumps(audit, separators=(",", ":"), sort_keys=True), level="OK")
            changed = True
            _queue_command_result(command_receipt, "agent", agent_id, cmd, "succeeded")
            continue

        proc = agents.get(agent_id)
        if proc is not None and proc.poll() is None:
            _surface_node_skips(agent_id, name)
            meta_now = _runtime_meta(agent_id)
            started_at = float(meta_now.get("last_start_at", 0) or 0)
            if started_at and (time.time() - started_at) >= 60 and meta_now.get("crash_times"):
                meta_now["crash_times"] = []

        if not has_payload:
            if proc is not None:
                changed = bool(kill_agent(agent_id, name=name, reason="no-payload")) or changed
            continue

        allowed, wait_seconds, suspend_reason = _can_attempt_start(agent_id)
        if not allowed and (proc is None or proc.poll() is not None):
            log_agent("SUSPENDED", agent_id, name, f"{suspend_reason}  retry_in:{wait_seconds}s", level="WARN")
            continue

        if cmd in ("restart", "update"):
            if not _begin_command_result(command_receipt, "agent", agent_id, cmd):
                continue
            _apply_rollout_delay(meta, agent_id, name)
            payload = _agent_payload_for_start(agent_id, name)
            if payload:
                if not kill_agent(agent_id, name=name, reason="restart-cmd", wait_for_ports=True):
                    _queue_command_result(command_receipt, "agent", agent_id, cmd, "failed", "Existing agent process could not be stopped")
                    continue
                previous_receipt = runtime.get("candidate_command_receipt")
                if _command_receipt_id(previous_receipt) and _command_receipt_id(previous_receipt) != _command_receipt_id(command_receipt):
                    _queue_command_result(previous_receipt, "agent", agent_id, str(previous_receipt.get("command") or "restart"), "failed", "Candidate was superseded by a newer exact command receipt")
                    runtime.pop("candidate_command_receipt", None)
                    runtime.pop("candidate_command_outcome", None)
                try:
                    spawn_agent(agent_id, payload, name=name, payload_hash=payload_hash, candidate_version=meta.get("desired_runtime_version", ""), persist_state=not _progress.active, runtime_retry_id=_command_receipt_id(command_receipt))
                    changed = True
                    if _command_receipt_id(command_receipt):
                        runtime["candidate_command_receipt"] = dict(command_receipt)
                        _persist_runtime_state()
                except Exception as exc:
                    _record_crash(agent_id)
                    _queue_command_result(command_receipt, "agent", agent_id, cmd, "failed", str(exc))
            elif proc is not None and proc.poll() is None:
                _queue_command_result(command_receipt, "agent", agent_id, cmd, "failed", "Requested runtime was unavailable; existing runtime kept running")
            elif _spawn_from_cached_payload(agent_id, name):
                changed = True
                _queue_command_result(command_receipt, "agent", agent_id, cmd, "failed", "Requested runtime was unavailable; previous verified cache restored for continuity")
            else:
                _queue_command_result(command_receipt, "agent", agent_id, cmd, "failed", "No verified agent payload was available")

        elif proc is None or proc.poll() is not None:
            if proc is not None:
                _tail = _agent_log_tail(agent_id)
                _last = _tail[-1] if _tail else ""
                _why = f"exited - last log: {_last[:140]}" if _last else "exited (no log output captured)"
                log_agent("CRASHED", agent_id, name, _why + "  - respawning", level="WARN")
                if not _record_crash(agent_id):
                    log_agent("SUSPENDED", agent_id, name, f"crash loop detected  retry_in:{AGENT_RESPAWN_WINDOW_SECONDS}s", level="ERR")
                    continue
            if not kill_agent(agent_id, name=name, reason="crash", wait_for_ports=True):
                continue
            if runtime.get("candidate_version"):
                if _rollback_candidate(agent_id, name):
                    changed = True
                continue
            _apply_rollout_delay(meta, agent_id, name)
            payload = _agent_payload_for_start(agent_id, name)
            if payload:
                try:
                    spawn_agent(agent_id, payload, name=name, payload_hash=payload_hash, candidate_version=meta.get("desired_runtime_version", ""), persist_state=not _progress.active)
                    changed = True
                except Exception as exc:
                    _record_crash(agent_id)
                    log_agent("SPAWN ERROR", agent_id, name, str(exc)[:100], level="ERR")
            elif _spawn_from_cached_payload(agent_id, name):
                changed = True
            elif runtime.get("last_fetch_failure_at") and (time.time() - float(runtime.get("last_fetch_failure_at") or 0)) < AGENT_FETCH_RETRY_DELAY_SECONDS:
                log_agent("BACKOFF", agent_id, name, f"fetch failed  retry_in:{AGENT_FETCH_RETRY_DELAY_SECONDS}s", level="WARN")

    for agent_id in list(agents.keys()):
        if agent_id not in server_agents:
            if kill_agent(agent_id, name="unknown", reason="removed-from-server"):
                agent_runtime_meta.pop(agent_id, None)
                changed = True

    if _progress.active:
        _persist_runtime_state()
    _progress.end()
    _emit_node_skip_summary()
    return changed

def shutdown_all_agents(reason="launcher-shutdown"):
    log(f"Shutting down {len(agents)} agent(s)...", level="WARN")
    targets = [(aid, agent_names.get(aid, "unnamed"), reason) for aid in list(agents.keys())]
    stopped = kill_agents_concurrently(targets)

    time.sleep(0.3)
    if agents:
        log(f"Failed to stop {len(agents)} agent(s); launcher will remain active and retry.", level="ERR")
        return False
    log(f"All agents stopped ({stopped}).", level="OK")
    return True

def perform_launcher_shutdown(reason="signal-shutdown", message=None, command_receipt=None, command=""):
    global shutdown_flag, shutdown_in_progress
    if shutdown_in_progress:
        return
    shutdown_in_progress = True
    shutdown_flag = True
    if message:
        log(message, level="WARN")
    if not shutdown_all_agents(reason=reason):
        if command_receipt:
            _queue_command_result(command_receipt, "launcher", LAUNCHER_HOST_ID, command, "failed", "One or more agents could not be stopped")
        shutdown_flag = False
        shutdown_in_progress = False
        return False
    if not cleanup_orphaned_runtime_processes():
        if command_receipt:
            _queue_command_result(command_receipt, "launcher", LAUNCHER_HOST_ID, command, "failed", "Runtime process containment could not be verified")
        shutdown_flag = False
        shutdown_in_progress = False
        return False
    cleanup_agent_artifacts()
    if command_receipt:
        _queue_command_result(command_receipt, "launcher", LAUNCHER_HOST_ID, command, "succeeded")
    offline_payload = {
        "client_id": CLIENT_ID,
        "launcher_host_id": LAUNCHER_HOST_ID,
        "reason": reason,
        "command_protocol_version": 2,
        "command_results": [dict(result) for result in _pending_command_results.values()],
    }
    try:
        _request_with_retries("/launcher/offline", offline_payload, timeout=4, attempts=2)
    except Exception as exc:
        if command_receipt:
            log(f"Could not confirm shutdown acknowledgement: {exc}; it will remain pending for timeout review.", level="WARN")
    release_singleton_lock()
    os._exit(0)

def signal_handler(sig, frame):
    sig_name = "Interrupt" if sig == signal.SIGINT else f"Signal {sig}"
    perform_launcher_shutdown(reason="signal-shutdown", message=f"{sig_name} received - stopping all nodes...")

def write_trust_console():
    if not TRUST_CONSOLE_B64:
        return
    try:
        data = base64.b64decode(TRUST_CONSOLE_B64.encode("ascii"))
        dest = os.path.join(os.path.dirname(os.path.realpath(__file__)), "infraveil.py")
        expected_sha = hashlib.sha256(data).hexdigest()
        actual_sha = ""
        if os.path.isfile(dest):
            with open(dest, "rb") as f:
                actual_sha = hashlib.sha256(f.read()).hexdigest()
        if actual_sha != expected_sha:
            _atomic_write_text(dest, data.decode("utf-8"))
        try:
            os.chmod(dest, 0o700)
        except Exception:
            pass
        with open(dest, "rb") as f:
            installed_sha = hashlib.sha256(f.read()).hexdigest()
        if installed_sha != expected_sha:
            raise RuntimeError("Trust Console file did not match its embedded hash after installation")
        log("Infraveil Trust Console available: " + dest, level="OK")
        log("Verified Trust Console sha256 " + installed_sha[:16] + "...", level="INFO")
    except Exception as exc:
        log("Could not install the verified Trust Console: " + str(exc)[:120], level="ERR")

if __name__ == "__main__":
    init_console()
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    NONINTERACTIVE = ("--yes" in sys.argv) or ("-y" in sys.argv) or ("--noninteractive" in sys.argv)
    _migrate_legacy_layout()
    acquire_singleton_lock()
    _load_runtime_state()

    ONBOARDING = _load_onboarding()
    if ONBOARDING is None:
        if _interactive():
            ONBOARDING = run_onboarding()
        else:
            ONBOARDING = {"venv": True, "install_deps": True, "service": False, "service_registered": False, "auto_defaults": True}
        _save_onboarding(ONBOARDING)

    PYTHON_CMD = ensure_venv()
    if not cleanup_orphaned_runtime_processes():
        log("Could not verify cleanup of an older Infraveil runtime; refusing to start new agents.", level="ERR")
        release_singleton_lock()
        sys.exit(1)
    cleanup_agent_artifacts()
    write_trust_console()

    if ONBOARDING.get("service") and not ONBOARDING.get("service_registered"):
        _svc_ok, _svc_msg, _svc_handoff = _register_boot_service(PYTHON_CMD, os.path.realpath(__file__))
        log(_svc_msg, level="OK" if _svc_ok else "WARN")
        if _svc_ok:
            ONBOARDING["service_registered"] = True
            _save_onboarding(ONBOARDING)
            if _svc_handoff:
                log("Handing the launcher to macOS launchd; it will continue in the background.", level="OK")
                release_singleton_lock()
                raise SystemExit(0)

    print("", flush=True)
    print(f"  \033[94m{'─' * 52}\033[0m", flush=True)
    print(f"  {c(ANSI_WHITE)}INFRAVEIL{c(ANSI_RESET)}  {c(ANSI_GREY)}Secure Agent Daemon{c(ANSI_RESET)}", flush=True)
    print(f"  {c(ANSI_GREY)}Client : {CLIENT_ID[:24]}...{c(ANSI_RESET)}", flush=True)
    print(f"  {c(ANSI_GREY)}Endpoint: {BASE_URL}{c(ANSI_RESET)}", flush=True)
    print(f"  \033[94m{'─' * 52}\033[0m", flush=True)
    print("", flush=True)
    log("Infraveil connection established.", level="OK")
    log(f"Python {platform.python_version()} detected.", level="OK")
    if shutil.which("node"):
        log("Node.js detected — Node-based services can run.", level="OK")
    else:
        log("Node.js not found — services that need Node will be skipped until it is installed.", level="WARN")
        log("Install it with:  " + _node_install_hint(), level="WARN")
    _append_local_audit("launcher_started", version=LAUNCHER_VERSION, source_hash=_launcher_source_hash(), host_fingerprint=_host_fingerprint())
    log(f"Control check: {CONTROL_POLL_INTERVAL:.1f}s; full reconciliation: {CHECK_INTERVAL}s.", level="INFO")
    print("", flush=True)

    next_full_sync = 0.0
    next_control_poll = time.monotonic() + random.uniform(0.0, control_poll_interval)
    while not shutdown_flag:
        try:
            now = time.monotonic()
            should_sync = now >= next_full_sync
            if not should_sync and control_plane_online and now >= next_control_poll:
                should_sync = poll_control_revision()
                next_control_poll = time.monotonic() + control_poll_interval
            if should_sync:
                changed = sync()
                now = time.monotonic()
                if control_plane_online:
                    next_full_sync = now + (FAST_RETRY_INTERVAL if changed else CHECK_INTERVAL)
                    next_control_poll = now + control_poll_interval
                else:
                    next_full_sync = now + min(30, max(CHECK_INTERVAL, 3 * sync_failure_count))
                    next_control_poll = next_full_sync
            wake_at = min(next_full_sync, next_control_poll) if control_plane_online else next_full_sync
            time.sleep(max(0.05, min(control_poll_interval, wake_at - time.monotonic())))
        except KeyboardInterrupt:
            signal_handler(signal.SIGINT, None)
        except Exception:
            time.sleep(FAST_RETRY_INTERVAL)
