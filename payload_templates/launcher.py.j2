def _migrate_legacy_layout():
    if _DATA_DIR == _SCRIPT_DIR:
        return
    moved = 0
    removed = 0
    for fn in ("launcher_state.json", "infraveil_onboarding.json", "launcher_audit.jsonl"):
        src = os.path.join(_SCRIPT_DIR, fn)
        dst = os.path.join(_DATA_DIR, fn)
        if os.path.isfile(src) and not os.path.exists(dst):
            try:
                shutil.move(src, dst)
                moved += 1
            except Exception:
                pass
    junk_exact = {"payload_versions", "infraveil_persistent", "launcher.lock",
                  "launcher_state.json", "infraveil_onboarding.json", "launcher_audit.jsonl"}
    junk_prefix = ("agent_", "launcher_payload_", "infraveil_payload_workspace_")
    try:
        for name in os.listdir(_SCRIPT_DIR):
            if name not in junk_exact and not name.startswith(junk_prefix):
                continue
            full = os.path.join(_SCRIPT_DIR, name)
            try:
                if os.path.isdir(full):
                    shutil.rmtree(full, ignore_errors=True)
                else:
                    os.remove(full)
                removed += 1
            except Exception:
                pass
    except Exception:
        pass
    if moved or removed:
        log(f"Tidied workspace: kept {moved} settings file(s), cleared {removed} legacy runtime file(s) into .infraveil/.", level="OK")

def _windows_kernel32():
    if os.name != "nt":
        return None
    from ctypes import wintypes
    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel32.CreateJobObjectW.argtypes = [wintypes.LPVOID, wintypes.LPCWSTR]
    kernel32.CreateJobObjectW.restype = wintypes.HANDLE
    kernel32.SetInformationJobObject.argtypes = [wintypes.HANDLE, ctypes.c_int, wintypes.LPVOID, wintypes.DWORD]
    kernel32.SetInformationJobObject.restype = wintypes.BOOL
    kernel32.AssignProcessToJobObject.argtypes = [wintypes.HANDLE, wintypes.HANDLE]
    kernel32.AssignProcessToJobObject.restype = wintypes.BOOL
    kernel32.TerminateJobObject.argtypes = [wintypes.HANDLE, wintypes.UINT]
    kernel32.TerminateJobObject.restype = wintypes.BOOL
    kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
    kernel32.CloseHandle.restype = wintypes.BOOL
    return kernel32

def _create_windows_kill_job(proc):
    """Contain an agent tree so stop remains enforceable after its parent exits."""
    if os.name != "nt":
        return None
    from ctypes import wintypes

    class IO_COUNTERS(ctypes.Structure):
        _fields_ = [
            ("ReadOperationCount", ctypes.c_ulonglong),
            ("WriteOperationCount", ctypes.c_ulonglong),
            ("OtherOperationCount", ctypes.c_ulonglong),
            ("ReadTransferCount", ctypes.c_ulonglong),
            ("WriteTransferCount", ctypes.c_ulonglong),
            ("OtherTransferCount", ctypes.c_ulonglong),
        ]

    class JOBOBJECT_BASIC_LIMIT_INFORMATION(ctypes.Structure):
        _fields_ = [
            ("PerProcessUserTimeLimit", ctypes.c_longlong),
            ("PerJobUserTimeLimit", ctypes.c_longlong),
            ("LimitFlags", wintypes.DWORD),
            ("MinimumWorkingSetSize", ctypes.c_size_t),
            ("MaximumWorkingSetSize", ctypes.c_size_t),
            ("ActiveProcessLimit", wintypes.DWORD),
            ("Affinity", ctypes.c_size_t),
            ("PriorityClass", wintypes.DWORD),
            ("SchedulingClass", wintypes.DWORD),
        ]

    class JOBOBJECT_EXTENDED_LIMIT_INFORMATION(ctypes.Structure):
        _fields_ = [
            ("BasicLimitInformation", JOBOBJECT_BASIC_LIMIT_INFORMATION),
            ("IoInfo", IO_COUNTERS),
            ("ProcessMemoryLimit", ctypes.c_size_t),
            ("JobMemoryLimit", ctypes.c_size_t),
            ("PeakProcessMemoryUsed", ctypes.c_size_t),
            ("PeakJobMemoryUsed", ctypes.c_size_t),
        ]

    kernel32 = _windows_kernel32()
    job = kernel32.CreateJobObjectW(None, None)
    if not job:
        raise ctypes.WinError(ctypes.get_last_error())
    try:
        info = JOBOBJECT_EXTENDED_LIMIT_INFORMATION()
        info.BasicLimitInformation.LimitFlags = 0x00002000  # JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
        if not kernel32.SetInformationJobObject(job, 9, ctypes.byref(info), ctypes.sizeof(info)):
            raise ctypes.WinError(ctypes.get_last_error())
        if not kernel32.AssignProcessToJobObject(job, wintypes.HANDLE(proc._handle)):
            raise ctypes.WinError(ctypes.get_last_error())
        return job
    except Exception:
        kernel32.CloseHandle(job)
        raise

def _pid_alive(pid):
    try:
        if pid <= 0:
            return False
        if os.name == "nt":
            return psutil.pid_exists(pid)
        os.kill(pid, 0)
        return True
    except Exception:
        return False

def acquire_singleton_lock():
    try:
        try:
            fd = os.open(LOCK_PATH, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(str(os.getpid()))
            return
        except FileExistsError:
            pass

        if os.path.exists(LOCK_PATH):
            try:
                with open(LOCK_PATH, "r", encoding="utf-8") as f:
                    existing_pid = int((f.read() or "0").strip() or "0")
            except Exception:
                existing_pid = 0
            if existing_pid and _pid_alive(existing_pid) and existing_pid != os.getpid():
                log(f"Another launcher instance is already running (pid {existing_pid}). Exiting.", level="ERR")
                sys.exit(1)
            try:
                os.remove(LOCK_PATH)
            except Exception:
                pass
        fd = os.open(LOCK_PATH, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(str(os.getpid()))
    except Exception as exc:
        log(f"Could not acquire launcher singleton lock: {exc}", level="ERR")
        sys.exit(1)

def release_singleton_lock():
    try:
        if os.path.exists(LOCK_PATH):
            os.remove(LOCK_PATH)
    except Exception:
        pass

def spawn_agent(agent_id, payload, name="unnamed", payload_hash=None, candidate_version="", stage_candidate=True, persist_state=True, runtime_retry_id=""):
    _require_agent_source_security_epoch(payload)
    python_cmd, managed_env = _runtime_python_for_source(payload)
    filepath = get_agent_filepath(agent_id)
    logpath = get_agent_logpath(agent_id)
    _atomic_write_text(filepath, payload)

    env = managed_env
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env["INFRAVEIL_CLIENT_ID"] = CLIENT_ID
    env["INFRAVEIL_LAUNCHER_HOST_ID"] = LAUNCHER_HOST_ID
    env["INFRAVEIL_AGENT_ID"] = str(agent_id)
    env["INFRAVEIL_RUNTIME_OWNER"] = "launcher"
    env.pop("INFRAVEIL_RUNTIME_RETRY_ID", None)
    if runtime_retry_id:
        env["INFRAVEIL_RUNTIME_RETRY_ID"] = str(runtime_retry_id)
    log_handle = open(logpath, "a", encoding="utf-8")
    try:
        os.chmod(logpath, 0o600)
    except Exception:
        pass
    popen_kwargs = {
        "cwd": _DATA_DIR,
        "env": env,
        "stdout": log_handle,
        "stderr": subprocess.STDOUT,
    }
    if os.name == "nt":
        popen_kwargs["creationflags"] = (
            getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
            | getattr(subprocess, "CREATE_NO_WINDOW", 0)
            | getattr(subprocess, "CREATE_SUSPENDED", 0x00000004)
        )
    else:
        popen_kwargs["start_new_session"] = True
    proc = subprocess.Popen([python_cmd, "-u", filepath], **popen_kwargs)
    if os.name == "nt":
        try:
            agent_job_handles[agent_id] = _create_windows_kill_job(proc)
            psutil.Process(proc.pid).resume()
        except Exception:
            try:
                proc.kill()
            except Exception:
                pass
            job_handle = agent_job_handles.pop(agent_id, None)
            if job_handle:
                try:
                    _windows_kernel32().CloseHandle(job_handle)
                except Exception:
                    pass
            try:
                log_handle.close()
            except Exception:
                pass
            raise
    proc._infraveil_log_handle = log_handle
    agents[agent_id] = proc
    agent_pids[agent_id] = {proc.pid}
    agent_names[agent_id] = name
    if stage_candidate:
        try:
            _record_spawn(agent_id, payload, payload_hash, candidate_version=candidate_version, persist_state=persist_state)
        except Exception as exc:
            _append_local_audit(
                "agent_candidate_staging_failed",
                agent_id=agent_id,
                name=name,
                error=str(exc)[:200],
            )
            stopped = kill_agent(agent_id, name=name, reason="candidate-staging-failed", wait_for_ports=True)
            if not stopped:
                raise RuntimeError("candidate cache staging failed and the candidate could not be stopped") from exc
            raise RuntimeError("candidate cache staging failed; candidate was stopped") from exc
    else:
        meta = _runtime_meta(agent_id)
        meta["last_start_at"] = time.time()
        if persist_state:
            _persist_runtime_state()
    hash_str = f"sha256:{payload_hash[:16]}..." if payload_hash else "sha256:pending"
    _append_local_audit("agent_started", agent_id=agent_id, name=name, pid=proc.pid, payload_hash=payload_hash or "")
    if _progress.active:
        _progress.tick("start")
    else:
        log_agent("NODE STARTED", agent_id, name, f"pid:{proc.pid}  {hash_str}", level="OK")

def wait_for_ports_to_release(ports, timeout=2.0):
    if not ports:
        return
    deadline = time.time() + timeout
    while time.time() < deadline:
        still_in_use = False
        try:
            for conn in psutil.net_connections(kind='tcp'):
                if conn.status == 'LISTEN' and conn.laddr and conn.laddr.port in ports:
                    still_in_use = True
                    break
        except Exception:
            pass
        if not still_in_use:
            return
        time.sleep(0.1)

def kill_agent(agent_id, name="unnamed", reason="", wait_for_ports=False):
    proc = agents.get(agent_id)
    ports_used = set()
    child_processes = []

    if not proc:
        return True

    if wait_for_ports:
        try:
            p = psutil.Process(proc.pid)
            child_processes = p.children(recursive=True)
            for conn in p.net_connections(kind='tcp'):
                if conn.laddr:
                    ports_used.add(conn.laddr.port)
            for child in child_processes:
                try:
                    for conn in child.net_connections(kind='tcp'):
                        if conn.laddr:
                            ports_used.add(conn.laddr.port)
                except Exception:
                    pass
        except Exception:
            pass

    # Agents are spawned with start_new_session=True, so their process-group ID
    # is the original parent PID even after that session leader exits.
    pgid = proc.pid if os.name != "nt" else None
    try:
        if os.name != "nt":
            try:
                parent = psutil.Process(proc.pid)
                child_processes = parent.children(recursive=True)
                for child in child_processes:
                    try:
                        child.terminate()
                    except Exception:
                        pass
            except Exception:
                child_processes = []
            try:
                os.killpg(pgid, signal.SIGTERM)
            except ProcessLookupError:
                pass

            deadline = time.time() + 2.0
            while time.time() < deadline:
                if proc.poll() is not None:
                    break
                time.sleep(0.05)

            if pgid is not None:
                try:
                    os.killpg(pgid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            try:
                _, alive = psutil.wait_procs(child_processes, timeout=1)
                for child in alive:
                    try:
                        child.kill()
                    except Exception:
                        pass
            except Exception:
                pass
        else:
            job_handle = agent_job_handles.get(agent_id)
            if job_handle:
                if not _windows_kernel32().TerminateJobObject(job_handle, 1):
                    raise OSError(ctypes.get_last_error(), "TerminateJobObject failed")
            elif proc.poll() is not None:
                raise RuntimeError("cannot verify descendant containment without the agent Job Object")
            try:
                parent = psutil.Process(proc.pid)
                child_processes = parent.children(recursive=True)
                for child in child_processes:
                    try:
                        child.terminate()
                    except Exception:
                        pass
                try:
                    parent.terminate()
                except Exception:
                    pass
                _, alive = psutil.wait_procs(child_processes + [parent], timeout=2)
                for p in alive:
                    try:
                        p.kill()
                    except Exception:
                        pass
            except Exception:
                pass
    except Exception as exc:
        _append_local_audit("agent_stop_attempt_failed", agent_id=agent_id, name=name, reason=reason or "", error=str(exc)[:200])

    try:
        proc.wait(timeout=1)
    except Exception:
        pass

    parent_alive = proc.poll() is None
    surviving_children = []
    for child in child_processes:
        try:
            if child.is_running() and child.status() != psutil.STATUS_ZOMBIE:
                surviving_children.append(child.pid)
        except (psutil.NoSuchProcess, psutil.ZombieProcess):
            continue
        except Exception:
            surviving_children.append(getattr(child, "pid", 0))
    group_alive = False
    surviving_group_pids = []
    if os.name != "nt" and pgid is not None:
        # SIGKILL delivery is asynchronous. An exited session leader cannot be
        # waited on to establish that its remaining group members have stopped.
        # Recheck this exact group for a bounded interval instead of turning a
        # transient post-signal observation into a permanent failed receipt.
        group_deadline = time.monotonic() + 1.0
        while True:
            surviving_group_pids = []
            for group_proc in psutil.process_iter(["pid", "status"]):
                try:
                    if os.getpgid(group_proc.pid) == pgid and group_proc.status() != psutil.STATUS_ZOMBIE:
                        surviving_group_pids.append(group_proc.pid)
                except (ProcessLookupError, psutil.NoSuchProcess, psutil.ZombieProcess):
                    continue
                except PermissionError:
                    surviving_group_pids.append(group_proc.pid)
            if not surviving_group_pids or time.monotonic() >= group_deadline:
                break
            time.sleep(0.02)
        group_alive = bool(surviving_group_pids)
    owned_survivors = []
    expected_env = {
        "INFRAVEIL_CLIENT_ID": CLIENT_ID,
        "INFRAVEIL_LAUNCHER_HOST_ID": LAUNCHER_HOST_ID,
        "INFRAVEIL_AGENT_ID": str(agent_id),
    }
    for owned_proc in psutil.process_iter(["pid"]):
        try:
            if _process_environ_matches(owned_proc, expected_env):
                owned_survivors.append(owned_proc.pid)
        except (psutil.NoSuchProcess, psutil.AccessDenied):
            continue
        except Exception:
            owned_survivors.append(getattr(owned_proc, "pid", 0))
    if owned_survivors:
        for owned_pid in owned_survivors:
            try:
                psutil.Process(owned_pid).kill()
            except Exception:
                pass
        time.sleep(0.2)
        live_owned = []
        for pid in owned_survivors:
            try:
                owned = psutil.Process(pid)
                if owned.is_running() and owned.status() != psutil.STATUS_ZOMBIE and _process_environ_matches(owned, expected_env):
                    live_owned.append(pid)
            except (psutil.NoSuchProcess, psutil.ZombieProcess):
                pass
            except Exception:
                live_owned.append(pid)
        owned_survivors = live_owned
    if parent_alive or surviving_children or group_alive or owned_survivors:
        _append_local_audit(
            "agent_stop_failed",
            agent_id=agent_id,
            name=name,
            reason=reason or "",
            parent_alive=parent_alive,
            surviving_children=surviving_children,
            process_group_alive=group_alive,
            surviving_group_pids=surviving_group_pids,
            surviving_owned_pids=owned_survivors,
        )
        log_agent("STOP FAILED", agent_id, name, "process still alive; keeping runtime tracked", level="ERR")
        return False

    try:
        proc._infraveil_log_handle.close()
    except Exception:
        pass

    agents.pop(agent_id, None)
    agent_pids.pop(agent_id, None)
    agent_names.pop(agent_id, None)
    job_handle = agent_job_handles.pop(agent_id, None)
    if job_handle and os.name == "nt":
        try:
            _windows_kernel32().CloseHandle(job_handle)
        except Exception:
            pass

    filepath = get_agent_filepath(agent_id)
    if os.path.exists(filepath):
        try:
            os.remove(filepath)
        except Exception:
            pass

    suffix = f"  reason:{reason}" if reason else ""
    _append_local_audit("agent_stopped", agent_id=agent_id, name=name, reason=reason or "", ports=list(ports_used))
    if not _progress.active:
        log_agent("NODE STOPPED", agent_id, name, suffix, level="WARN")

    if wait_for_ports and ports_used:
        wait_for_ports_to_release(ports_used)
    return True

def kill_agents_concurrently(items):
    """Stop a fleet in parallel so the graceful timeout is paid once per batch."""
    if not items:
        return 0
    if len(items) == 1:
        agent_id, name, reason = items[0]
        return 1 if kill_agent(agent_id, name=name, reason=reason) else 0

    import concurrent.futures as _cf

    def _stop(item):
        agent_id, name, reason = item
        try:
            return bool(kill_agent(agent_id, name=name, reason=reason))
        except Exception as exc:
            log(f"Failed to stop agent {agent_id}: {exc}", level="ERR")
            return False

    with _cf.ThreadPoolExecutor(max_workers=min(128, len(items))) as executor:
        return sum(1 for stopped in executor.map(_stop, items) if stopped)

def fetch_agent(agent_id, name="unnamed"):
    failed_at = float(_runtime_meta(agent_id).get("last_fetch_failure_at", 0) or 0)
    if failed_at and time.time() - failed_at < AGENT_FETCH_RETRY_DELAY_SECONDS:
        return None
    if not _progress.active:
        log_agent("FETCHING", agent_id, name, "requesting encrypted payload...", level="INFO")
    try:
        r = _request_with_retries("/launcher/agent/fetch", {"client_id": CLIENT_ID, "agent_id": agent_id, "launcher_host_id": LAUNCHER_HOST_ID}, timeout=30, attempts=3)
        if r.status_code == 200:
            _progress.tick("fetch")
            agent_hash = hashlib.sha256(r.content or b"").hexdigest()
            if RELEASE_PUBLIC_KEY:
                sig = str(r.headers.get("X-Infraveil-Agent-Ed25519") or "").strip()
                try:
                    Ed25519PublicKey.from_public_bytes(bytes.fromhex(RELEASE_PUBLIC_KEY)).verify(bytes.fromhex(sig), agent_hash.encode("utf-8"))
                except Exception:
                    _runtime_meta(agent_id)["last_fetch_failure_at"] = time.time()
                    _persist_runtime_state()
                    _append_local_audit("agent_release_signature_rejected", agent_id=agent_id, name=name)
                    log_agent("REJECTED", agent_id, name, "agent release signature invalid — refusing to run", level="ERR")
                    return None
            if CUSTOMER_APPROVAL_KEY:
                approval = str(r.headers.get("X-Infraveil-Agent-Customer-Approval") or "").strip().lower()
                try:
                    Ed25519PublicKey.from_public_bytes(bytes.fromhex(CUSTOMER_APPROVAL_KEY)).verify(bytes.fromhex(approval), agent_hash.encode("utf-8"))
                except Exception:
                    _runtime_meta(agent_id)["last_fetch_failure_at"] = time.time()
                    _persist_runtime_state()
                    _append_local_audit("agent_customer_approval_rejected", agent_id=agent_id, name=name)
                    log_agent("REJECTED", agent_id, name, "customer release approval invalid - refusing to run", level="ERR")
                    return None
            _runtime_meta(agent_id)["last_fetch_failure_at"] = 0.0
            _persist_runtime_state()
            if _progress.active:
                _progress.tick("decrypt")
            else:
                log_agent("DECRYPTED", agent_id, name, "payload received OK", level="OK")
            _append_local_audit("agent_payload_fetched", agent_id=agent_id, name=name, status=200)
            return r.content.decode("utf-8")
        else:
            _runtime_meta(agent_id)["last_fetch_failure_at"] = time.time()
            _persist_runtime_state()
            log_agent("FETCH FAILED", agent_id, name, f"http:{r.status_code}", level="ERR")
            _append_local_audit("agent_payload_fetch_failed", agent_id=agent_id, name=name, status=r.status_code)
    except Exception as e:
        _runtime_meta(agent_id)["last_fetch_failure_at"] = time.time()
        _persist_runtime_state()
        log_agent("FETCH ERROR", agent_id, name, str(e)[:60], level="ERR")
    return None

def _self_update(new_version):
    try:
        r = _request_with_retries("/launcher/self-source", {"client_id": CLIENT_ID, "launcher_host_id": LAUNCHER_HOST_ID}, timeout=30, attempts=2)
        if r.status_code != 200:
            log(f"AUTO-UPDATE: launcher v{new_version} not served (http:{r.status_code}); staying on v{LAUNCHER_VERSION}", level="WARN")
            return False
        new_src = r.content or b""
        src_hash = hashlib.sha256(new_src).hexdigest()
        if RELEASE_PUBLIC_KEY:
            sig = str(r.headers.get("X-Infraveil-Launcher-Ed25519") or "").strip()
            Ed25519PublicKey.from_public_bytes(bytes.fromhex(RELEASE_PUBLIC_KEY)).verify(bytes.fromhex(sig), src_hash.encode("utf-8"))
        if CUSTOMER_APPROVAL_KEY:
            approval = str(r.headers.get("X-Infraveil-Launcher-Customer-Approval") or "").strip().lower()
            Ed25519PublicKey.from_public_bytes(bytes.fromhex(CUSTOMER_APPROVAL_KEY)).verify(bytes.fromhex(approval), src_hash.encode("utf-8"))
        text = new_src.decode("utf-8")
        target = os.path.abspath(__file__)
        compile(text, target, "exec")
        _validate_launcher_source_context(text, new_version)
        replacement_python, replacement_env = _runtime_python_for_source(text)
        tmp = target + ".update"
        _atomic_write_bytes(tmp, new_src)
        with open(target, "rb") as previous:
            _atomic_write_bytes(LAUNCHER_PREVIOUS_PATH, previous.read())
        _atomic_write_text(LAUNCHER_UPDATE_MARKER, json.dumps({"from_version": LAUNCHER_VERSION, "to_version": new_version, "boot_attempts": 0, "created_at": time.time()}, separators=(",", ":"), sort_keys=True))
        if not shutdown_all_agents(reason="launcher-self-update"):
            try:
                if os.path.exists(LAUNCHER_UPDATE_MARKER):
                    os.remove(LAUNCHER_UPDATE_MARKER)
                if os.path.exists(tmp):
                    os.remove(tmp)
            except Exception as cleanup_exc:
                log(f"AUTO-UPDATE: could not clear deferred update staging: {cleanup_exc}", level="ERR")
            _append_local_audit(
                "launcher_self_update_deferred",
                from_version=LAUNCHER_VERSION,
                to_version=new_version,
                source_hash=src_hash,
                current_source_unchanged=True,
            )
            log("AUTO-UPDATE: running agents could not be stopped; current launcher source remains active", level="ERR")
            return False
        if not cleanup_orphaned_runtime_processes():
            raise RuntimeError("owned orphan processes could not be contained before self-update")
        os.replace(tmp, target)
        log(f"AUTO-UPDATE: launcher v{LAUNCHER_VERSION} -> v{new_version} verified; restarting daemon...", level="OK")
        _append_local_audit("launcher_self_update", from_version=LAUNCHER_VERSION, to_version=new_version, source_hash=src_hash)
        _persist_runtime_state()
        if os.environ.get("INFRAVEIL_NONINTERACTIVE") == "1":
            replacement_env["INFRAVEIL_START_GUARD_ADMITTED"] = "1"
        os.execve(replacement_python, [replacement_python, "-I", target] + sys.argv[1:], replacement_env)
    except Exception as e:
        log(f"AUTO-UPDATE: launcher self-update to v{new_version} failed; staying on v{LAUNCHER_VERSION}: {str(e)[:80]}", level="WARN")
        return False

def _fetch_payload_raw(agent_id, name="unnamed"):
    if not _progress.active:
        log_agent("FETCHING", agent_id, name, "requesting encrypted payload...", level="INFO")
    r = _request_with_retries("/launcher/agent/fetch", {"client_id": CLIENT_ID, "agent_id": agent_id, "launcher_host_id": LAUNCHER_HOST_ID}, timeout=30, attempts=3)
    if r.status_code != 200:
        raise RuntimeError("http:%s" % r.status_code)
    _progress.tick("fetch")
    agent_hash = hashlib.sha256(r.content or b"").hexdigest()
    if RELEASE_PUBLIC_KEY:
        sig = str(r.headers.get("X-Infraveil-Agent-Ed25519") or "").strip()
        Ed25519PublicKey.from_public_bytes(bytes.fromhex(RELEASE_PUBLIC_KEY)).verify(bytes.fromhex(sig), agent_hash.encode("utf-8"))
    if CUSTOMER_APPROVAL_KEY:
        approval = str(r.headers.get("X-Infraveil-Agent-Customer-Approval") or "").strip().lower()
        Ed25519PublicKey.from_public_bytes(bytes.fromhex(CUSTOMER_APPROVAL_KEY)).verify(bytes.fromhex(approval), agent_hash.encode("utf-8"))
    if _progress.active:
        _progress.tick("decrypt")
    else:
        log_agent("DECRYPTED", agent_id, name, "payload received OK", level="OK")
    return r.content.decode("utf-8")

_prefetch_cache = {}

def _prefetch_payloads(items):
    if len(items) < 2:
        return
    import concurrent.futures as _cf
    def _one(it):
        aid, nm = it
        try:
            _prefetch_cache[aid] = _fetch_payload_raw(aid, nm)
        except Exception as exc:
            _prefetch_cache[aid] = None
            _runtime_meta(aid)["last_fetch_failure_at"] = time.time()
            log_agent("FETCH FAILED", aid, nm, str(exc)[:100], level="ERR")
            _append_local_audit("agent_payload_fetch_failed", agent_id=aid, name=nm, error=str(exc)[:200])
    with _cf.ThreadPoolExecutor(max_workers=min(12, len(items))) as ex:
        list(ex.map(_one, items))

def _consume_prefetched(agent_id, name):
    payload = _prefetch_cache.pop(agent_id, None)
    if payload is None:
        _persist_runtime_state()
        return None
    _runtime_meta(agent_id)["last_fetch_failure_at"] = 0.0
    _append_local_audit("agent_payload_fetched", agent_id=agent_id, name=name, status=200)
    return payload


def _agent_payload_for_start(agent_id, name):
    # A failed parallel fetch is still a completed attempt. Do not immediately
    # repeat it serially, bypassing the fetch backoff and approval gate.
    if agent_id in _prefetch_cache:
        return _consume_prefetched(agent_id, name)
    return fetch_agent(agent_id, name=name)

def _launcher_status_payload():
    _promote_healthy_candidates()
    now = time.time()
    running = {}
    for agent_id, proc in list(agents.items()):
        meta = _runtime_meta(agent_id)
        running[agent_id] = {
            "pid": getattr(proc, "pid", 0),
            "alive": proc.poll() is None,
            "name": agent_names.get(agent_id, agent_id),
            "last_start_at": meta.get("last_start_at", 0.0),
            "last_payload_hash": meta.get("last_payload_hash", ""),
            "crash_count_window": len([ts for ts in meta.get("crash_times", []) if now - ts < AGENT_RESPAWN_WINDOW_SECONDS]),
            "suspended_until": meta.get("suspended_until", 0.0),
            "suspension_reason": meta.get("suspension_reason", ""),
            "last_fetch_failure_at": meta.get("last_fetch_failure_at", 0.0),
            "update_state": {
                "active_version": meta.get("active_runtime_version", ""),
                "candidate_version": meta.get("candidate_version", ""),
                "candidate_started_at": meta.get("candidate_started_at", 0.0),
                "blocked_version": meta.get("blocked_runtime_version", ""),
                "last_rollback_at": meta.get("last_rollback_at", 0.0),
                "rollback_count": meta.get("rollback_count", 0),
                "health_gate_seconds": AGENT_CANDIDATE_HEALTH_SECONDS,
            },
        }
    try:
        cpu = psutil.cpu_percent(interval=None)
        memory = psutil.virtual_memory().percent
        disk = psutil.disk_usage(os.path.dirname(os.path.realpath(__file__))).percent
    except Exception:
        cpu = memory = disk = 0
    return {
        "launcher_version": LAUNCHER_VERSION,
        **RUNTIME_DEPENDENCY_STATUS,
        "launcher_capabilities": LAUNCHER_CAPABILITIES,
        "launcher_source_hash": _launcher_source_hash(),
        "host_fingerprint": _host_fingerprint(),
        "hostname": socket.gethostname(),
        "platform": {
            "system": platform.system(),
            "release": platform.release(),
            "machine": platform.machine(),
            "python": platform.python_version(),
        },
        "pid": os.getpid(),
        "online": control_plane_online,
        "sync_failure_count": sync_failure_count,
        "agent_count": len(agents),
        "running_agents": running,
        "cached_agents": list(agent_runtime_meta.keys()),
        "capacity_diagnostic": last_capacity_diagnostic,
        "cpu": cpu,
        "memory": memory,
        "disk": disk,
        "updated_at": time.time(),
        "local_audit_tail": _read_local_audit_tail(),
    }

